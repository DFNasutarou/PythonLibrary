  "deque": {
    "scope": "python",
    "prefix": "deque",
    "description": "両端キュー Deque (両端 O(1)・ランダムアクセス対応・二重スタック実装)",
    "body": [
      "class Deque:",
      "  def __init__(self, d: list[int] = []):",
      "    self._normalize(d)",
      "  def add_r(self, n):",
      "    \"\"\"末尾に追加\"\"\"",
      "    self.R.append(n)",
      "    # print(\"add\", n, self.getList())",
      "  def add_l(self, n):",
      "    \"\"\"先頭に追加\"\"\"",
      "    self.L.append(n)",
      "    # print(\"add\", n, self.getList())",
      "  def pop_r(self):",
      "    \"\"\"末尾から取得\"\"\"",
      "    if self.R == [] and len(self.L) == 1: ",
      "      n = self.L.pop()",
      "    else:",
      "      if self.R == []: self._normalize(self.L[::-1])",
      "      n = self.R.pop()",
      "    # print(\"pop\", n, self.getList())",
      "    return n",
      "  def pop_l(self):",
      "    \"\"\"先頭から取得\"\"\"",
      "    if self.L == [] and  len(self.R) == 1: ",
      "      n = self.R.pop()",
      "    else:",
      "      if self.L == []: self._normalize(self.R)",
      "      n = self.L.pop()",
      "    # print(\"pop\", n, self.getList())",
      "    return n",
      "  def size(self):",
      "    \"\"\"要素数を返す\"\"\"",
      "    return len(self.L) + len(self.R)",
      "  def is_empty(self):",
      "    \"\"\"空かどうか返す\"\"\"",
      "    return self.size() == 0",
      "  def get(self, ind):",
      "    \"\"\"先頭からind番目を取得\"\"\"",
      "    if ind < len(self.L):",
      "      return self.L[-ind - 1]",
      "    ind -= len(self.L)",
      "    return self.R[ind]",
      "      ",
      "  def _normalize(self, d):",
      "    self.L = d[:len(d) // 2][::-1]",
      "    self.R = d[len(d) // 2:]",
      "  def getList(self):",
      "    \"\"\"チェック用 O(N)\"\"\"",
      "    return self.L[::-1] + self.R",
      "",
      "# usage: dq = Deque([1,2,3]); dq.add_r(4); dq.pop_l()"
    ]
  },
  "query": {
