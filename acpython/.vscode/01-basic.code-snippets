    "prefix": "heapq",
    "body": [
      "import heapq",
      "class HeapQue:",
      "  # pop(): 最小(is_max時は最大)値を取り出す",
      "  # top(): 最小(is_max時は最大)値を覗き見る",
      "  # push(x): 値を追加する",
      "  # pushpop(x): x を追加してから最小(is_max時は最大)値を取り出す",
      "  # is_empty(): 空かどうかを返す",
      "  # reset(): 中身を空にする",
      "  def __init__(self, is_max = False, default = None):",
      "    self.q = []",
      "    self.mlt = -1 if is_max else 1 # 最大値を管理する場合は反転させる",
      "    self.default = default",
      "  def pop(self): ",
      "    if self.is_empty(): return self.default",
      "    return heapq.heappop(self.q) * self.mlt",
      "  def top(self):",
      "    if self.is_empty(): return self.default",
      "    return self.q[0] * self.mlt",
      "  def push(self, x): heapq.heappush(self.q, x * self.mlt)",
      "  def pushpop(self, x): return heapq.heappushpop(self.q, x * self.mlt) * self.mlt",
      "  def is_empty(self): return self.q == []",
      "  def reset(self): self.q = []",
      "",
      "# usage",
      "# q = HeapQue(is_max=True)",
      "# q.push(x)",
      "# q.pop()"
    ],
    "description": "ヒープキュー HeapQue (最大/最小切替・default 値・push/pop/top/pushpop)",
    "scope": "python"
  },
  "zaatsu": {
    "prefix": "zaatsu",
    "body": [
      "class Zaatsu:",
      "  # compress(): 初期化時に渡した A を順位(0-indexed, 小さい順)のリストに変換したものを返す",
      "  # rank(x): 値 x の順位(0-indexed)を返す (x は A に含まれる値限定)",
      "  # value(i): 順位 i に対応する元の値を返す",
      "  def __init__(self, A):",
      "    self.sorted = sorted(set(A))",
      "    self.rank_map = {v: i for i, v in enumerate(self.sorted)}",
      "    self.comp = self._compress(A)",
      "  def compress(self):",
      "    return self.comp",
      "  def rank(self, x):",
      "    return self.rank_map[x]",
      "  def value(self, i):",
      "    return self.sorted[i]",
      "  def _compress(self, A):",
      "    rank_map = self.rank_map",
      "    return [rank_map[a] for a in A]",
      "",
      "# usage",
      "# z = Zaatsu(${1:A})",
      "# comp = z.compress()",
      "# v = z.value(2)$0"
    ],
    "description": "座標圧縮 Zaatsu (値→順位/順位→値、前処理 O(N log N)・rank/value は O(1))",
    "scope": "python"
  },
