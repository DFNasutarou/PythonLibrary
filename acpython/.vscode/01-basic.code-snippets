  "itertools": {
    "scope": "python",
    "prefix": "itertools",
    "description": "itertools 系ユーティリティ (rle/rle_int/unrle/accumulate/pairwise/flatten/unflatten)",
    "body": [
      "import itertools",
      "class itr:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/01-basic.code-snippets",
      "  # rle(S): ランレングス圧縮 [(値, 個数), ...] を返す",
      "  # rle_int(S): 0~9の数字とみなしてランレングス圧縮する",
      "  # unrle(pairs): rle/rle_int の結果から元の列を復元する",
      "  # accumulate(A, initial=0): 累積和のリストを返す (先頭に initial を含む)",
      "  # pairwise(A): 隣接する要素のペア (a[i], a[i+1]) のリストを返す",
      "  # flatten(A): 2次元リストを1次元に平坦化する（(i, j) は i * W + j に移る。各行の長さ W のとき）",
      "  # unflatten(F, w): flatten の逆。w が int なら幅 w ごと、list なら w[i] 個ずつ区切って2次元に戻す",
      "  @staticmethod",
      "  def rle(S):",
      "    return [(k, len(list(g))) for k, g in itertools.groupby(S)]",
      "  @staticmethod",
      "  def rle_int(S):",
      "    return [(int(k), len(list(g))) for k, g in itertools.groupby(S)]",
      "  @staticmethod",
      "  def unrle(pairs):",
      "    ans = []",
      "    for v, c in pairs:",
      "      ans.extend([v] * c)",
      "    return ans",
      "  @staticmethod",
      "  def accumulate(A, initial=0):",
      "    return list(itertools.accumulate(A, initial=initial))",
      "  @staticmethod",
      "  def pairwise(A):",
      "    return list(itertools.pairwise(A))",
      "  @staticmethod",
      "  def flatten(A):",
      "    return list(itertools.chain.from_iterable(A))",
      "  @staticmethod",
      "  def unflatten(F, w):",
      "    if isinstance(w, int): return [F[i:i + w] for i in range(0, len(F), w)]",
      "    res = []; i = 0",
      "    for k in w: res.append(F[i:i + k]); i += k",
      "    return res"
    ]
  },
