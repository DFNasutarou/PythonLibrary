      "import itertools",
      "class itr:",
      "  @ staticmethod",
      "  def rle(S):",
      "    \"\"\"",
      "      ランレングス圧縮を行う",
      "    \"\"\"",
      "    ans = [(k, len(list(g))) for k,g in itertools.groupby(S)]",
      "    return ans",
      "  @ staticmethod",
      "  def rle_int(S):",
      "    \"\"\"",
      "      0~9の数字とみなして",
      "      ランレングス圧縮を行う",
      "    \"\"\"",
      "    ans = [(int(k), len(list(g))) for k,g in itertools.groupby(S)]",
      "    return ans",
      "",
      "# usage: itr.rle(\"aabbb\") -> [(\"a\",2),(\"b\",3)]"
    ]
