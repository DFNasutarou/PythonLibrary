    "description": "クエリソルバ",
    "body": [
      "class Query_solve:",
      "  def __init__(self, ops, ind = 1):",
      "    self.ops = ops",
      "    self.ind = ind",
      "  def solve(self, Query):",
      "    for query in Query:",
      "      i, que = query[0], query[1:]",
      "      self.ops[i - self.ind](*que)"
    ]
