    "description": "クエリ種別ディスパッチャ Query_solve (ops[i-ind](*que) で呼び分け)",
    "body": [
      "class Query_solve:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/01-basic.code-snippets",
      "  # solve(Query): 各クエリの先頭要素(種別番号)に対応する ops の処理を呼び出す",
      "  def __init__(self, ops, ind = 1):",
      "    self.ops = ops",
      "    self.ind = ind",
      "  def solve(self, Query):",
      "    for query in Query:",
      "      i, que = query[0], query[1:]",
      "      self.ops[i - self.ind](*que)"
    ]
  }
