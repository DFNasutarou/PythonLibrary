  "itertools": {
    "scope": "python",
    "prefix": "itertools",
    "description": "itertools 系ユーティリティ (rle/rle_int/unrle/accumulate/pairwise/flatten)",
    "body": [
      "import itertools",
      "class itr:",
      "  # rle(S): ランレングス圧縮 [(値, 個数), ...] を返す",
      "  # rle_int(S): 0~9の数字とみなしてランレングス圧縮する",
      "  # unrle(pairs): rle/rle_int の結果から元の列を復元する",
      "  # accumulate(A, initial=0): 累積和のリストを返す (先頭に initial を含む)",
      "  # pairwise(A): 隣接する要素のペア (a[i], a[i+1]) のリストを返す",
      "  # flatten(A): 2次元リストを1次元に平坦化する",
      "  @staticmethod",
      "  def rle(S):",
      "    return [(k, len(list(g))) for k, g in itertools.groupby(S)]",
      "  @staticmethod",
      "  def rle_int(S):",
      "    return [(int(k), len(list(g))) for k, g in itertools.groupby(S)]",
      "  @staticmethod",
      "  def unrle(pairs):",
      "    ans = []",
      "    for v, c in pairs:",
      "      ans.extend([v] * c)",
      "    return ans",
      "  @staticmethod",
      "  def accumulate(A, initial=0):",
      "    return list(itertools.accumulate(A, initial=initial))",
      "  @staticmethod",
      "  def pairwise(A):",
      "    return list(itertools.pairwise(A))",
      "  @staticmethod",
      "  def flatten(A):",
      "    return list(itertools.chain.from_iterable(A))",
      "",
      "# usage",
      "# itr.rle(\"aabbb\") -> [(\"a\", 2), (\"b\", 3)]",
      "# itr.unrle([(\"a\", 2), (\"b\", 3)]) -> [\"a\", \"a\", \"b\", \"b\", \"b\"]",
      "# itr.accumulate([1, 2, 3]) -> [0, 1, 3, 6]",
      "# itr.pairwise([1, 2, 3]) -> [(1, 2), (2, 3)]",
      "# itr.flatten([[1, 2], [3, 4]]) -> [1, 2, 3, 4]"
    ]
  },
  "query": {
    "scope": "python",
    "prefix": "query",
    "description": "クエリ種別ディスパッチャ Query_solve (ops[i-ind](*que) で呼び分け)",
    "body": [
      "class Query_solve:",
      "  # solve(Query): 各クエリの先頭要素(種別番号)に対応する ops の処理を呼び出す",
      "  def __init__(self, ops, ind = 1):",
      "    self.ops = ops",
      "    self.ind = ind",
      "  def solve(self, Query):",
      "    for query in Query:",
      "      i, que = query[0], query[1:]",
      "      self.ops[i - self.ind](*que)",
      "",
      "# usage",
      "# solver = Query_solve([op_add, op_get])",
      "# solver.solve(Q)"
    ]
  }
