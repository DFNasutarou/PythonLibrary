  "packed2dlist": {
    "scope": "python",
    "prefix": "packed2dlist",
    "description": "2D 座標 (a, b) を 1 整数にパックして保持するリスト (高速化用)",
    "body": [
      "class Packed2DList(list):",
      "  \"\"\"",
      "  ２次元の (a, b) を内部的に 1 つの整数としてパックして保持するリスト。",
      "  b の取りうる値が 0 <= b < N のときに、N をコンストラクタ引数で渡すと、",
      "  自動的に b を収めるのに十分なビット数 (shift) を決定します。",
      "",
      "  - append(a, b) → 内部に (a << shift) + b を append",
      "  - pop()      → 内部の末尾 packed を a,b に分解して返却",
      "  - for a,b in X: → 順に unpack して (a,b) タプルを返す",
      "  - extend([(a1,b1), (a2,b2), ...]) → それぞれを packed にして extend",
      "  - X[i]       → i 番目の packed を unpack して (a, b) を返す",
      "  - (a,b) in X → packed にして contains チェック",
      "",
      "  新たに追加したオプション：",
      "  - size: インスタンス生成時に要素数を指定すると、要素数分だけ (0,0)＝packed=0 の状態で初期化",
      "  \"\"\"",
      "",
      "  def __init__(self, N: int = 10**6, size: int = 0):",
      "    \"\"\"",
      "    N: b が取りうる上限（排他的）。つまり b は 0 <= b < N を想定する。",
      "    size: インスタンス生成直後に要素数をこの数だけ すべて (a=0,b=0) で埋める。",
      "      size <= 0 のときは空リストから始まる。",
      "    \"\"\"",
      "",
      "    if not isinstance(N, int) or N <= 0:",
      "      raise ValueError(\"N は正の整数を指定してください (b の取りうる上限)。\")",
      "    if not isinstance(size, int) or size < 0:",
      "      raise ValueError(\"size は 0 以上の整数を指定してください。\")",
      "",
      "    # まず list の初期化だけ行う",
      "    super().__init__()",
      "",
      "    # b < N を満たすために必要なビット数を計算",
      "    bits = (N - 1).bit_length()",
      "    # 最低でも 1 ビットは確保（N=1 のとき bits=0 なので shift=1）",
      "    self.shift = bits if bits > 0 else 1",
      "    # b を取り出すためのマスク (1 << shift) - 1",
      "    self.mask = (1 << self.shift) - 1",
      "",
      "    # ───────────────",
      "    # size が正なら、あらかじめ packed=0 (＝(a=0,b=0)) を size 個分追加する",
      "    # ───────────────",
      "    if size > 0:",
      "      # packed=0 は (0<<shift)|0 = 0 に相当する",
      "      # オーバーライドされた extend() を通さず、生の整数 0 を追加したいので",
      "      # super().extend(...) を使う",
      "      super().extend([0] * size)",
      "",
      "  def append(self, a: int, b: int):",
      "    \"\"\"",
      "    (a, b) を受け取って、内部に packed = (a << shift) | b を追加する。",
      "    b は 0 <= b <= mask を想定。範囲外なら例外を投げる。",
      "    \"\"\"",
      "    if not (isinstance(a, int) and isinstance(b, int)):",
      "      raise TypeError(\"append の引数 a, b はともに int 型である必要があります。\")",
      "    if b < 0 or b > self.mask:",
      "      raise ValueError(f\"b の値が不正です (0 <= b <= {self.mask} の範囲でなければなりません)。\")",
      "    packed = (a << self.shift) | b",
      "    super().append(packed)",
      "",
      "  def pop(self):",
      "    \"\"\"",
      "    内部リストの末尾 packed を取り出して、(a, b) に分解して返す。",
      "    \"\"\"",
      "    packed = super().pop()",
      "    a = packed >> self.shift",
      "    b = packed & self.mask",
      "    return a, b",
      "",
      "  def __iter__(self):",
      "    \"\"\"",
      "    for x in self: のときに (a, b) のタプルを順に返す。",
      "    \"\"\"",
      "    for packed in super().__iter__():",
      "      a = packed >> self.shift",
      "      b = packed & self.mask",
      "      yield (a, b)",
      "",
      "  def extend(self, iterable):",
      "    \"\"\"",
      "    iterable が (a, b) のペアを返すイテラブルであれば、",
      "    それぞれを packed にして内部に追加する。",
      "    例：extend([(a1,b1), (a2,b2), ...])",
      "    \"\"\"",
      "    for item in iterable:",
      "      try:",
      "        a, b = item",
      "      except Exception:",
      "        raise TypeError(\"extend の各要素は 2 要素のシーケンス (a, b) である必要があります。\")",
      "      # append(a,b) を使えばチェック＆packed の処理は append 側で行われる",
      "      self.append(a, b)",
      "",
      "  def __getitem__(self, index):",
      "    \"\"\"",
      "    X[i] → i が int の場合は i 番目の packed を (a,b) に分解して返す。",
      "    X[i:j] → スライスのときは、(a,b) タプルのリストを返す。",
      "    \"\"\"",
      "    if isinstance(index, slice):",
      "      packed_list = super().__getitem__(index)",
      "      result = []",
      "      for packed in packed_list:",
      "        a = packed >> self.shift",
      "        b = packed & self.mask",
      "        result.append((a, b))",
      "      return result",
      "    else:",
      "      packed = super().__getitem__(index)",
      "      a = packed >> self.shift",
      "      b = packed & self.mask",
      "      return a, b",
      "",
      "  def __setitem__(self, index, value):",
      "    \"\"\"",
      "    X[i] = (a, b) という代入をサポートする。",
      "    \"\"\"",
      "    if isinstance(index, int):",
      "      try:",
      "        a, b = value",
      "      except Exception:",
      "        raise TypeError(\"__setitem__ には長さ 2 のシーケンス (a, b) を渡してください。\")",
      "      if not (isinstance(a, int) and isinstance(b, int)):",
      "        raise TypeError(\"a, b はともに int 型である必要があります。\")",
      "      if b < 0 or b > self.mask:",
      "        raise ValueError(f\"b の値が不正です（0 <= b <= {self.mask} の範囲である必要があります）。\")",
      "      packed = (a << self.shift) | b",
      "      super().__setitem__(index, packed)",
      "",
      "    elif isinstance(index, slice):",
      "      seq = list(value)",
      "      packed_list = []",
      "      for item in seq:",
      "        try:",
      "          a, b = item",
      "        except Exception:",
      "          raise TypeError(\"__setitem__ のスライス代入には、(a, b) のタプルリストを渡してください。\")",
      "        if not (isinstance(a, int) and isinstance(b, int)):",
      "          raise TypeError(\"a, b はともに int 型である必要があります。\")",
      "        if b < 0 or b > self.mask:",
      "          raise ValueError(f\"b の値が不正です（0 <= b <= {self.mask} の範囲である必要があります）。\")",
      "        packed_list.append((a << self.shift) | b)",
      "      super().__setitem__(index, packed_list)",
      "",
      "    else:",
      "        raise TypeError(\"インデックス指定は int または slice のみサポートしています。\")",
      "",
      "  def __contains__(self, element):",
      "    \"\"\"",
      "    (a, b) in X というチェックを可能にする。",
      "    element が長さ 2 のシーケンス (a, b) なら、packed にして内部リストに含まれるか確認。",
      "    それ以外は False を返す。",
      "    \"\"\"",
      "    try:",
      "      a, b = element",
      "    except Exception:",
      "      return False",
      "    if not (isinstance(a, int) and isinstance(b, int)):",
      "      return False",
      "    if b < 0 or b > self.mask:",
      "      return False",
      "    packed = (a << self.shift) | b",
      "    return super().__contains__(packed)",
      "",
      "  def index(self, element):",
      "    \"\"\"",
      "    (a, b) が含まれるならその index を返す。",
      "    \"\"\"",
      "    try:",
      "      a, b = element",
      "    except Exception:",
      "      raise TypeError(\"index の引数は長さ 2 のシーケンス (a, b) である必要があります。\")",
      "    if not (isinstance(a, int) and isinstance(b, int)):",
      "      raise TypeError(\"a, b はともに int 型である必要があります。\")",
      "    if b < 0 or b > self.mask:",
      "      raise ValueError(f\"b の値が不正です（0 <= b <= {self.mask} の範囲である必要があります）。\")",
      "    packed = (a << self.shift) | b",
      "    return super().index(packed)",
      "",
      "  def count(self, element):",
      "    \"\"\"",
      "    (a, b) の個数を返す",
      "    \"\"\"",
      "    try:",
      "      a, b = element",
      "    except Exception:",
      "      return 0",
      "    if not (isinstance(a, int) and isinstance(b, int)):",
      "      return 0",
      "    if b < 0 or b > self.mask:",
      "      return 0",
      "    packed = (a << self.shift) | b",
      "    return super().count(packed)",
      "",
      "# usage: p = Packed2DList(); p.append((a, b)); a, b = p.unpack(0)"
    ]
  }
