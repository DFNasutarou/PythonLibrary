  "wavelet": {
    "prefix": "wavelet",
    "body": [
      "import math",
      "import heapq",
      "from collections import deque",
      "pop = heapq.heappop",
      "push = heapq.heappush",
      "class wavelet:",
      "  class bitvec:",
      "    def __init__(self, B):",
      "      N = len(B)",
      "      self.bn = 32",
      "      self.B = [0] * -(-N // self.bn)",
      "      for i in range(-(-N // self.bn)):",
      "        for j in range(self.bn):",
      "          if i * self.bn + j == N:",
      "            self.B[i] <<= self.bn - j",
      "            break",
      "          self.B[i] <<= 1",
      "          self.B[i] += int(B[i * self.bn + j])",
      "      # N = 2 ^ 28 とすると",
      "      self.ln = 784 # 28 ** 2",
      "      self.sn = 14 # 28 / 2",
      "      ls = -(-N // self.ln)",
      "      ss = -(-N // self.sn) ",
      "      ps = pow(2, self.sn)",
      "      self.L = []",
      "      self.S = []",
      "      lcnt, scnt = 0, 0",
      "      for i in range(N):",
      "        if i % self.ln == 0:",
      "          self.L.append(lcnt)",
      "          self.S.append([])",
      "          scnt = 0",
      "        if i % self.sn == 0:",
      "          self.S[-1].append(scnt)",
      "        if B[i]:",
      "          lcnt += 1",
      "          scnt += 1",
      "      self.P = [0] * ps",
      "      for i in range(1, self.sn + 1):",
      "        n = (1 << i) - 1",
      "        while n < (1 << self.sn):",
      "          self.P[n] = i",
      "          x = n & -n",
      "          y = n + x",
      "          n = ((n & ~y) // x >> 1) | y",
      "    def access(self, n):",
      "      # 先頭からn番目の値(0-indexed)",
      "      i = n // self.bn",
      "      k = n % self.bn",
      "      return (self.B[i] >> (self.bn - 1 - k)) & 1",
      "    def rank(self, n):",
      "      # 先頭からn番目までの1の数(1-indexed)",
      "      if n <= 0: return 0",
      "      n -= 1",
      "      x = n // self.ln",
      "      y = (n - x * self.ln) // self.sn",
      "      l = self.sn * y",
      "      r = n",
      "      if l // self.bn != r // self.bn:",
      "        p = self.B[l // self.bn] & ((1 << (self.bn - (l % self.bn))) - 1)",
      "        p <<= (r % self.bn) + 1",
      "        p += self.B[r // self.bn] >> (self.bn - 1 - (r % self.bn))",
      "      else:",
      "        p = self.B[l // self.bn] & ((1 << (self.bn - (l % self.bn))) - 1)",
      "        p >>= (self.bn - 1 - (r % self.bn))",
      "      return  self.L[x] + self.S[x][y] + self.P[p]",
      "    def rankzero(self, n):",
      "      # 先頭からn番目までの0の数(1-indexed)",
      "      return n - self.rank(n)",
      "    def select(self, n, b):",
      "      # 先頭からn番目のb(0 or 1)の位置(0-indexed)",
      "      if n <= 0: return -1",
      "      p = self.nibutan(self.L, n, b, self.ln)",
      "      n -= self.L[p] if b else self.ln * p - self.L[p]",
      "      q = self.nibutan(self.S[p], n, b, self.sn)",
      "      n -= self.S[p][q] if b else self.sn * q - self.S[p][q]",
      "      t = self.ln * p + self.sn * q",
      "      try:",
      "        while True:",
      "          if self.access(t) == b:",
      "            n -= 1",
      "            if n == 0:",
      "              return t",
      "          t += 1",
      "      except:",
      "        return -1",
      "",
      "    def nibutan(self, L, n, b, num):",
      "      ok = 0",
      "      ng = len(L)",
      "      while abs(ok - ng) > 1:",
      "        mid = (ok + ng) // 2",
      "        x = L[mid] if b else num * mid - L[mid]",
      "        if x < n: ok = mid",
      "        else: ng = mid",
      "      return ok",
      "",
      "  def __init__(self, T):",
      "    # 索引作成 負の数は不可",
      "    N = len(T)",
      "    t = 0",
      "    for i in range(N): t = max(t, math.ceil(math.log2(T[i] + 1)) - 1)",
      "    self.digit = t # 桁数",
      "    self.B = [] # 索引",
      "    self.BN = [] # 0の個数",
      "    self.R = {} # 最終値の各数値の開始値",
      "    D = [[0, 0, T[i]] for i in range(N)]",
      "    for n in range(t, -1, -1):",
      "      ND = []",
      "      cnt = 0",
      "      for i in range(N):",
      "        ND.append([(D[i][2] >> n) & 1, i, D[i][2]])",
      "        cnt += 1 - ND[i][0]",
      "      self.B.append(self.bitvec([ND[i][0] for i in range(N)]))",
      "      self.BN.append(cnt)",
      "      ND.sort()",
      "      D = ND",
      "    for i in range(N):",
      "      if D[i][2] not in self.R:",
      "        self.R[D[i][2]] = [i, 1]",
      "      else:",
      "        self.R[D[i][2]][1] += 1",
      "  def access(self, n):",
      "    # n番目(0-indexed)の位置の値(logσ)",
      "    ans = 0",
      "    for i in range(self.digit + 1):",
      "      ans <<= 1",
      "      if self.B[i].access(n):",
      "        ans += 1",
      "        n = self.B[i].rank(n) + self.BN[i]",
      "      else:",
      "        n = self.B[i].rankzero(n)",
      "    return ans",
      "  def rank(self, n, c):",
      "    # n番目(0-indexed)までにcが現れた個数(logσ)",
      "    n += 1",
      "    for i in range(self.digit + 1):",
      "      if (c >> (self.digit - i)) & 1:",
      "        n = self.B[i].rank(n) + self.BN[i]",
      "      else:",
      "        n = self.B[i].rankzero(n)",
      "    return n - self.R[c]",
      "  def select(self, c, n):",
      "    # n個目のcの位置(0-indexed)(logσ)",
      "    if c not in self.R: return -1",
      "    d, m = self.R[c]",
      "    if not 1 <= n <= m : return -1",
      "    n = d + n",
      "    for i in range(self.digit, -1, -1):",
      "      if (c >> (self.digit - i)) & 1:",
      "        n = self.B[i].select(n - self.BN[i], 1) + 1",
      "      else:",
      "        n = self.B[i].select(n, 0) + 1",
      "    return n - 1",
      "  def quantile(self, st, en, r):",
      "    # st <= i <= en の間で r番目に小さい値(0-indexed)(logσ)",
      "    if en - st < r : return -1",
      "    en += 1",
      "    ans = 0",
      "    for i in range(self.digit + 1):",
      "      ans <<= 1",
      "      z = self.B[i].rankzero(en) - self.B[i].rankzero(st)",
      "      if r < z:",
      "        x = self.B[i].rankzero(st)",
      "        st = x",
      "        en = st + z - 1",
      "      else:",
      "        x = self.B[i].rank(st)",
      "        st = self.BN[i] + x",
      "        x = self.B[i].rank(en)",
      "        en = self.BN[i] + x",
      "        r -= z",
      "        ans += 1",
      "    return ans",
      "  def topk(self, st, en, k):",
      "    # st <= i <= en の間で出現回数が多い順にk個返す(0-indexed)(min(e - s, σ)logσ)",
      "    en += 1",
      "    q  = []",
      "    push(q, [-(en - st), st, 0, 0])",
      "    ans = []",
      "    while k > 0 and q:",
      "      n, st, x, i = pop(q)",
      "      if i == self.digit + 1:",
      "        ans.append([x, -n])",
      "        k -= 1",
      "        continue",
      "      en = st - n",
      "      z = self.B[i].rankzero(en) - self.B[i].rankzero(st)",
      "      if z != 0:",
      "        o = self.B[i].rankzero(st)",
      "        push(q, [-z, o, x << 1, i + 1])",
      "      if z != -n:",
      "        o = self.BN[i] + self.B[i].rank(st)",
      "        push(q, [z + n, o, (x << 1) + 1, i + 1])",
      "    return ans",
      "  def sum(self, st, en):",
      "    # st <= i <= en の和(0-indexed)(min(e - s, σ)logσ)",
      "    tk = topk(st, en, en - st + 1)",
      "    ans = 0",
      "    for a, b in tk:",
      "      ans += a * b",
      "    return ans",
      "  def intersect (self, s1, e1, s2, e2):",
      "    # st <= i <= en の和(0-indexed)(e1 - s1 + e2 - s1 + 1)",
      "    d = deque()",
      "    d.append(s1, e1, s2, e2)",
      "    while not d.empty():",
      "      pass",
      "    #途中",
      "",
      "# usage: w = WaveletMatrix(A); w.kth(l, r, k); w.rank(l, r, x)"
    ],
    "description": "ウェーブレット行列 (静的列の k-th / select / 区間内 quantile)",
    "scope": "python"
