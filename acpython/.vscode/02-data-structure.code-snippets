  "union_potential": {
    "prefix": "union_potential",
    "body": [
      "class UnionPotential:",
      "  def __init__(self, num):",
      "    self.T = [-1] * num",
      "    self.W = [0] * num",
      "",
      "  def root(self, x):",
      "    if self.T[x] < 0: return x",
      "    t = self.root(self.T[x])",
      "    self.W[x] += self.W[self.T[x]]",
      "    self.T[x] = t",
      "    return t",
      "",
      "  def merge(self, x, y, w):",
      "    an, bn = self.root(x), self.root(y)",
      "    if an == bn: return False",
      "    am, bm = -self.T[an], -self.T[bn]",
      "    aw, bw = self.weight(x), self.weight(y)",
      "    w += aw - bw",
      "    if am < bm: an, bn, w = bn, an, -w",
      "    self.T[an] += self.T[bn]",
      "    self.T[bn], self.W[bn] = an, w",
      "    return True",
      "",
      "  def size(self, x):",
      "    n = self.root(x)",
      "    return -self.T[n]",
      "",
      "  def same(self, x, y):",
      "    return self.root(x) == self.root(y)",
      "  ",
      "  def diff(self, x, y):",
      "    return self.weight(y) - self.weight(x)",
      "  ",
      "  def weight(self, x):",
      "    self.root(x)",
      "    return self.W[x]",
      "",
      "  def print(self): #デバッグ用",
      "    ans = []",
      "    for i in range(len(self.T)):",
      "      ans.append(self.root(i))",
      "    print(\"parent\\t: \", *self.T, sep = \"\\t\")",
      "    print(\"potential: \", *self.W, sep = \"\\t\")",
      "    print(\"root\\t: \", *ans, sep = \"\\t\")",
      "",
      "# usage: u = UnionPotential(N); u.merge(a, b, w); d = u.diff(a, b)"
    ],
    "description": "ポテンシャル付き Union-Find (重み付き連結・差分検査)",
    "scope": "python"
  },
