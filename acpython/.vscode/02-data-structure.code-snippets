    "body": [
      "import heapq",
      "class HeapQue:",
      "  def __init__(self, is_max = False, default = None):",
      "    self.q = []",
      "    self.mlt = -1 if is_max else 1 # 最大値を管理する場合は反転させる",
      "    self.default = default",
      "  def pop(self): ",
      "    if self.is_empty(): return self.default",
      "    return heapq.heappop(self.q) * self.mlt",
      "  def top(self):",
      "    if self.is_empty(): return self.default",
      "    n = self.pop(); self.push(n); return n",
      "  def push(self, x): heapq.heappush(self.q, x * self.mlt)",
      "  def pushpop(self, x): return heapq.heappushpop(self.q, x * self.mlt) * self.mlt",
      "  def is_empty(self): return self.q == []",
      "  def reset(self): self.q = []",
      "",
      "class multiset:",
      "  def __init__(self, isMin = 1, isMax = 1):",
      "    # min:1 max:2 minmax:3",
      "    self.mi = isMin",
      "    self.ma = isMax",
      "    self.miq = HeapQue(False)",
      "    self.maq = HeapQue(True)",
      "    self.R = {}",
      "  def insert(self, v):",
      "    if v in self.R: self.R[v] += 1",
      "    else: self.R[v] = 1",
      "    if self.mi: self.miq.push(v)",
      "    if self.ma: self.maq.push(v)",
      "  def delete(self, v):",
      "    if v in self.R: self.R[v] = max(0, self.R[v] - 1)",
      "    while not self.maq.is_empty():",
      "      if self.R[self.maq.top()] == 0: self.maq.pop()",
      "      else: break",
      "    while not self.miq.is_empty():",
      "      if self.R[self.miq.top()] == 0: self.miq.pop()",
      "      else: break",
      "  def pop_max(self):",
      "    n = self.maq.pop()",
      "    if not n is None: self.delete(n)",
      "    return n",
      "  def pop_min(self):",
      "    n = self.miq.pop()",
      "    if not n is None: self.delete(n)",
      "    return n",
      "  def top_max(self): return self.maq.top()",
      "  def top_min(self): return self.miq.top()",
      "",
      "# usage: ms = MultiSet(); ms.add(x); ms.remove(x); m = ms.min()"
    ],
