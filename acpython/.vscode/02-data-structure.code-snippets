    "description": "Binary Trie (xor 最小値検索・整数集合 [0, 2^BIT_SIZE))",
    "body": [
      "class BinaryTrie:",
      "  # 2 ** (BIT_SIZE) - 1 まで可能",
      "  BIT_SIZE = 30",
      "",
      "  def __init__(self):",
      "    self.root = self.Node()",
      "  ",
      "  # 非負整数を追加 key: 非負整数",
      "  def insert(self, key):",
      "    self.root.insert(key, BinaryTrie.BIT_SIZE)",
      "",
      "  # 非負整数を削除 key: 非負整数",
      "  def remove(self, key):",
      "    if self.root.isInValid(): return False",
      "    self.root.remove(key, BinaryTrie.BIT_SIZE)",
      "",
      "  # 非負整数を検索",
      "  def find(self, key):",
      "    if self.root.isInValid(): return None",
      "    return self.root.find(key, BinaryTrie.BIT_SIZE)",
      "",
      "  # keyとxorしたときの最小値を検索 key: xor対象",
      "  def findXorMin(self, key):",
      "    if self.root.isInValid(): return None",
      "    return self.root.findXorMin(key, BinaryTrie.BIT_SIZE)",
      "    ",
      "  # keyとxorしたときの最大値を検索 key: xor対象",
      "  def findXorMax(self, key):",
      "    if self.root.isInValid(): return None",
      "    return self.root.findXorMax(key, BinaryTrie.BIT_SIZE)",
      "",
      "  class Node:",
      "    def __init__(self):",
      "      self.data = [None, None]",
      "    def isInValid(self):",
      "      return self.data == [None, None]",
      "    def insert(self, n, d):",
      "      a = n >> d & 1",
      "      if self.data[a] == None:",
      "        self.data[a] = BinaryTrie.Node()",
      "      if d == 0: return",
      "      self.data[a].insert(n, d - 1)",
      "    def remove(self, n, d):",
      "      a = n >> d & 1",
      "      if self.data[a] == None: return False",
      "      if d == 0 or self.data[a].remove(n, d - 1): ",
      "        self.data[a] = None",
      "        return self.isInValid()",
      "      return False",
      "    def find(self, n, d):",
      "      a = n >> d & 1",
      "      if self.data[a] == None: return False",
      "      if d == 0: return True",
      "      return self.data[a].find(n, d - 1)",
      "    def findXorMin(self, n, d):",
      "      if d == -1: return 0",
      "      a = n >> d & 1",
      "      if self.data[a] == None: a ^= 1",
      "      return (a << d) + self.data[a].findXorMin(n, d - 1)",
      "    def findXorMax(self, n, d):",
      "      if d == -1: return 0",
      "      a = n >> d & 1",
      "      if self.data[a ^ 1] != None: a ^= 1",
      "      return (a << d) + self.data[a].findXorMax(n, d - 1)",
      "",
      "# usage: t = BinaryTrie(); t.add(x); t.xor_min(q)"
    ]
