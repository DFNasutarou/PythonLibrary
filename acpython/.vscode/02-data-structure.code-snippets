  "cartesianTree": {
    "scope": "python",
    "prefix": "cartesianTree",
    "description": "カルテシアン木 (区間 min/max の階層構造、RMQ 前処理など)",
    "body": [
      "from typing import Any, Callable",
      "",
      "class CartesianTree:",
      "  def __init__(self, N: int, A: list[int], L: list[int], R: list[int], P: list[int], root: int): ",
      "    self._N = N # 要素数",
      "    self._A = A # 各要素の値",
      "    self._L = L # 左のこょーそ",
      "    self._R = R # 右のこょーそ",
      "    self._P = P # 親",
      "    self._root = root # 根",
      "  def getParentList(self):",
      "    \"\"\"各要素に対する親のリストを取得\"\"\"",
      "    return self._P",
      "  def getParent(self, x: int):",
      "    \"\"\"",
      "    指定した要素に対する親を取得",
      "    親がいない場合、-1",
      "    \"\"\"",
      "    return self._P[x]",
      "  def getRoot(self) : ",
      "    \"\"\"根の要素番号を取得\"\"\"",
      "    return self._root",
      "  def makeSizeOfPartTree(self):",
      "    \"\"\"",
      "    部分木のサイズのリストを取得",
      "    末尾に0入り（番兵）",
      "    \"\"\"",
      "    dp = [0] * (self._N + 1)",
      "    def op(x: int, l: int, r: int, dp):",
      "      dp[x] = self._A[x] + dp[l] + dp[r]",
      "    self.bottomUpDp(op, dp)",
      "    return dp",
      "  def topDownDp(self, op : Callable[[int, int, int, Any], Any], dp: Any):",
      "    \"\"\"CartesianTreeの根からDPする op(見ているノード, 区間左端, 区間右端, 結果格納用データ)\"\"\"",
      "    q = [self._root, 0, self._N]",
      "    while q:",
      "      r, l, x = q.pop(), q.pop(), q.pop()",
      "      op(x, l, r, dp)",
      "      n = self._L[x]",
      "      if n != -1: q.extend([n, l, x])",
      "      n = self._R[x]",
      "      if n != -1: q.extend([n, x + 1, r])",
      "  def bottomUpDp(self, op : Callable[[int, int, int, Any], Any], dp: Any):",
      "    \"\"\"CartesianTreeの葉からDPする op(見ているノード, 左の子, 右の子, 結果格納用データ)\"\"\"",
      "    q = [self._root]",
      "    used = [0] * (self._N + 1)",
      "    used[-1] = 2",
      "    while q:",
      "      x = q.pop()",
      "      l = self._L[x]",
      "      r = self._R[x]",
      "      if used[l] == 0: ",
      "        q.append(l)",
      "        continue",
      "      if used[r] == 0: ",
      "        q.append(r)",
      "        continue",
      "      op(x, l, r, dp)",
      "      p = self._P[x]",
      "      if p != -1: q.append(p)",
      "      used[x] = 1",
      "  def print(self):",
      "    br = \"  \"",
      "    nd = \"--\"",
      "    ld = \" .\"",
      "    rd = \". \"",
      "    data = [[br] * self._N for _ in range(self._N)]",
      "    q = [self._root]",
      "    for i in range(self._N):",
      "      if q == []: break",
      "      p: list[int] = []",
      "      for x in q:",
      "        l = self._L[x]",
      "        r = self._R[x]",
      "        if l != -1: ",
      "          for j in range(l + 1, x): data[i][j] = nd",
      "          data[i][l] = ld ",
      "          p.append(l)",
      "        if r != -1:",
      "          for j in range(x + 1, r): data[i][j] = nd",
      "          data[i][r] = rd ",
      "          p.append(r)",
      "        data[i][x] = format(self._A[x], '02')",
      "      q = p",
      "    for d in data:",
      "      print(*d, sep = \"\")",
      "",
      "class CartesianTreeFactory:",
      "  @staticmethod",
      "  def makeMinTree(A: list[int]) -> CartesianTree: return CartesianTreeFactory._makeTree(A, CartesianTreeFactory._opmin)",
      "  @staticmethod",
      "  def makeMaxTree(A: list[int]) -> CartesianTree: return CartesianTreeFactory._makeTree(A, CartesianTreeFactory._opmax)",
      "  @staticmethod",
      "  def _opmin(a: int, b: int) -> bool: return a > b",
      "  @staticmethod",
      "  def _opmax(a: int, b: int) -> bool: return a < b",
      "  @staticmethod",
      "  def _makeTree(A: list[int], op: Callable[[int, int], bool]) -> CartesianTree:",
      "    N: int = len(A)",
      "    L: list[int] = [-1] * N",
      "    R: list[int] = [-1] * N",
      "    P: list[int] = [-1] * N",
      "    root = 0",
      "    for i in range(1, N):",
      "      if op(A[i - 1], A[i]):",
      "        p: int = i - 1",
      "        while P[p] != -1:",
      "          p = P[p]",
      "          if not op(A[p], A[i]):",
      "            l: int = R[p]",
      "            R[p], P[l] = i, i",
      "            P[i], L[i] = p, l",
      "            break",
      "        else:",
      "          P[p], L[i] = i, p",
      "          root: int = i",
      "      else:",
      "        R[i - 1], P[i] = i, i - 1",
      "    return CartesianTree(N, A, L, R, P, root)",
      "  ",
      "",
      "# usage: t = CartesianTree(A, op=min); root = t.root"
    ]
  },
  "sortedSet": {
    "scope": "python",
    "prefix": "sortedSet",
    "description": "Sorted Set (tatyam 実装、平方分割で全操作 O(√N))",
    "body": [
      "# https://github.com/tatyam-prime/SortedSet/blob/main/SortedSet.py",
      "import math",
      "from bisect import bisect_left, bisect_right",
      "from typing import Generic, Iterable, Iterator, TypeVar",
      "T = TypeVar('T')",
      "",
      "class SortedSet(Generic[T]):",
      "    BUCKET_RATIO = 16",
      "    SPLIT_RATIO = 24",
      "",
      "    def __init__(self, a: Iterable[T] = []) -> None:",
      "        \"Make a new SortedSet from iterable. / O(N) if sorted and unique / O(N log N)\"",
      "        a = list(a)",
      "        n = len(a)",
      "        if any(a[i] > a[i + 1] for i in range(n - 1)):",
      "            a.sort()",
      "        if any(a[i] >= a[i + 1] for i in range(n - 1)):",
      "            a, b = [], a",
      "            for x in b:",
      "                if not a or a[-1] != x:",
      "                    a.append(x)",
      "        n = self.size = len(a)",
      "        num_bucket = int(math.ceil(math.sqrt(n / self.BUCKET_RATIO)))",
      "        self.a = [a[n * i // num_bucket : n * (i + 1) // num_bucket] for i in range(num_bucket)]",
      "",
      "    def __iter__(self) -> Iterator[T]:",
      "        \"O(1) 要素を昇順に走査するイテレータです。走査の途中で要素の追加 / 削除をしてはいけません。\"",
      "        for i in self.a:",
      "            for j in i: yield j",
      "",
      "    def __reversed__(self) -> Iterator[T]:",
      "        \"O(1) 要素を降順に走査するイテレータです。走査の途中で要素の追加 / 削除をしてはいけません。\"",
      "        for i in reversed(self.a):",
      "            for j in reversed(i): yield j",
      "",
      "    def __eq__(self, other) -> bool:",
      "        \"O(N) 集合として同一かどうかを判定します\"",
      "        return list(self) == list(other)",
      "",
      "    def __len__(self) -> int:",
      "        \"O(1) 長さチェック\"",
      "        return self.size",
      "",
      "    def __repr__(self) -> str:",
      "        return \"SortedSet\" + str(self.a)",
      "",
      "    def __str__(self) -> str:",
      "        s = str(list(self))",
      "        return \"{\" + s[1 : len(s) - 1] + \"}\"",
      "",
      "    def _position(self, x: T) -> tuple[list[T], int, int]:",
      "        \"return the bucket, index of the bucket and position in which x should be. self must not be empty.\"",
      "        for i, a in enumerate(self.a):",
      "            if x <= a[-1]: break",
      "        return (a, i, bisect_left(a, x))",
      "",
      "    def __contains__(self, x: T) -> bool:",
      "        \"O(√N) 存在チェック\"",
      "        if self.size == 0: return False",
      "        a, _, i = self._position(x)",
      "        return i != len(a) and a[i] == x",
      "",
      "    def add(self, x: T) -> bool:",
      "        \"償却O(√N) x が s に含まれていなければ x を追加し、True を返します。含まれている場合は False を返します\"",
      "        if self.size == 0:",
      "            self.a = [[x]]",
      "            self.size = 1",
      "            return True",
      "        a, b, i = self._position(x)",
      "        if i != len(a) and a[i] == x: return False",
      "        a.insert(i, x)",
      "        self.size += 1",
      "        if len(a) > len(self.a) * self.SPLIT_RATIO:",
      "            mid = len(a) >> 1",
      "            self.a[b:b+1] = [a[:mid], a[mid:]]",
      "        return True",
      "",
      "    def _pop(self, a: list[T], b: int, i: int) -> T:",
      "        ans = a.pop(i)",
      "        self.size -= 1",
      "        if not a: del self.a[b]",
      "        return ans",
      "",
      "    def discard(self, x: T) -> bool:",
      "        \"償却O(√N) xが含まれていれば削除してtrueを返す。そうでなければfalseを返す\"",
      "        if self.size == 0: return False",
      "        a, b, i = self._position(x)",
      "        if i == len(a) or a[i] != x: return False",
      "        self._pop(a, b, i)",
      "        return True",
      "",
      "    def lt(self, x: T) -> T | None:",
      "        \"O(√N) x未満の最大の要素 なければNone\"",
      "        for a in reversed(self.a):",
      "            if a[0] < x:",
      "                return a[bisect_left(a, x) - 1]",
      "",
      "    def le(self, x: T) -> T | None:",
      "        \"O(√N) x以下の最大の要素 なければNone\"",
      "        for a in reversed(self.a):",
      "            if a[0] <= x:",
      "                return a[bisect_right(a, x) - 1]",
      "",
      "    def gt(self, x: T) -> T | None:",
      "        \"O(√N) x超過の最小の要素 なければNone\"",
      "        for a in self.a:",
      "            if a[-1] > x:",
      "                return a[bisect_right(a, x)]",
      "",
      "    def ge(self, x: T) -> T | None:",
      "        \"O(√N) x以上の最小の要素 なければNone\"",
      "        for a in self.a:",
      "            if a[-1] >= x:",
      "                return a[bisect_left(a, x)]",
      "",
      "    def __getitem__(self, i: int) -> T:",
      "        \"O(min(|i|,N)) 下から i 番目 / 上から ~i 番目 の要素を返します。存在しない場合は IndexError\"",
      "        if i < 0:",
      "            for a in reversed(self.a):",
      "                i += len(a)",
      "                if i >= 0: return a[i]",
      "        else:",
      "            for a in self.a:",
      "                if i < len(a): return a[i]",
      "                i -= len(a)",
      "        raise IndexError",
      "",
      "    def pop(self, i: int = -1) -> T:",
      "        \"O(min(|i|,N)) 下から i 番目 / 上から ~i 番目 の要素を削除するとともに返します。存在しない場合は IndexError\"",
      "        if i < 0:",
      "            for b, a in enumerate(reversed(self.a)):",
      "                i += len(a)",
      "                if i >= 0: return self._pop(a, ~b, i)",
      "        else:",
      "            for b, a in enumerate(self.a):",
      "                if i < len(a): return self._pop(a, b, i)",
      "                i -= len(a)",
      "        raise IndexError",
      "",
      "    def index(self, x: T) -> int:",
      "        \"O(√N) x より小さい要素の数を返します。x が s に含まれている場合は list(s).index(x) に相当します\"",
      "        ans = 0",
      "        for a in self.a:",
      "            if a[-1] >= x:",
      "                return ans + bisect_left(a, x)",
      "            ans += len(a)",
      "        return ans",
      "",
      "    def index_right(self, x: T) -> int:",
      "        \"O(√N) x 以下の要素の数を返します\"",
      "        ans = 0",
      "        for a in self.a:",
      "            if a[-1] > x:",
      "                return ans + bisect_right(a, x)",
      "            ans += len(a)",
      "        return ans",
      "",
      "# usage: s = SortedSet([1,2,3]); s.add(x); s.lt(x); s.le(x); s.gt(x)"
    ]
  },
  "rangeList": {
    "scope": "python",
    "prefix": "rangeList",
    "description": "区間 [l, r) のマージ管理 (重なる区間を自動結合・含有判定)",
    "body": [
      "class RangeList:",
      "  def __init__(self, v : list[int, int]):",
      "    \"\"\"",
      "    区間リストをindex付きで保持",
      "    入力：[[l1, r1], [l2, r2], ･･･]",
      "    保持：[[l1, r1, ind1], [l2, r2, ind2], ･･･]",
      "    \"\"\"",
      "    self.v = [v[i] + [i] for i in range(len(v))]",
      "  def remove_nest(self):",
      "    \"\"\"",
      "    処理: li <= lj <= rj <= ri を満たす [lj, rj] を削除",
      "    出力: 削除後のリスト",
      "    \"\"\"",
      "    self.v.sort(key=lambda x: (x[0], -x[1]))",
      "    result = []",
      "    for l, r, i in self.v:",
      "        # 現在の区間が result の最後の区間に含まれていない場合に追加",
      "        if not result or result[-1][1] < r:",
      "          result.append([l, r, i])",
      "    return result",
      "  def find_nest_pair(self):",
      "    \"\"\"",
      "    処理: li <= lj <= rj <= ri を満たす [lj, rj]のペアを一つ返す",
      "    出力: 上記を満たすペア([包含する側, される側]) なければ[]",
      "    \"\"\"",
      "    self.v.sort(key=lambda x: (x[0], -x[1]))",
      "    lf, ret, ind = -1, -1, -1",
      "    for l, r, i in self.v:",
      "        # 現在の区間が result の最後の区間に含まれていない場合に追加",
      "        if ret < r: lf, ret, ind = l, r, i",
      "        else: return [[lf, ret, ind], [l, r, i]]",
      "    return []",
      "",
      "  def find_overlapping_pair(self):",
      "    \"\"\"",
      "    処理: li <= ri < lj <= rj を満たすペアを探す",
      "    出力: 上記を満たすペア([左側, 右側]) なければ[]",
      "    \"\"\"",
      "    self.v.sort()",
      "    # 条件を満たすペアを探索",
      "    lf, ret, ind = self.v[0]",
      "    for l, r, i in self.v[1:]:",
      "       if ret < l: return [[lf, ret, ind], [l, r, i]]",
      "       if ret > r: lf, ret, ind = l, r, i",
      "    return []",
      "",
      "  def find_cover_ranges(self, start, end):",
      "    \"\"\"",
      "    処理: start ~ endを覆う最小の組み合わせを探す",
      "    出力: 上記を満たすペアのindex(lの昇順) なければ[]",
      "    \"\"\"",
      "    self.v.sort(key=lambda x: (x[0], -x[1]))",
      "    result = []",
      "    ret = start",
      "    for l, r, i in self.v:",
      "      if r < ret: continue",
      "      if ret < l: return []",
      "      if l <= start: result = [[l, r, i]]",
      "      else:",
      "        if len(result) >= 2 and result[-2][1] >= l: result.pop()",
      "        result.append([l, r, i])",
      "      ret = r",
      "      if ret >= end: return result",
      "    return []",
      "",
      "# usage: rl = RangeList([(1,3),(5,7)]); rl.add(2, 6); rl.contains(x)"
    ]
  },
  "union_persist": {
    "scope": "python",
    "prefix": "union_persist",
    "description": "永続 Union-Find (過去の時刻状態にも問い合わせ可能)",
    "body": [
      "class UnionPersistentPart:",
      "  def __init__(self,N):",
      "    INF = float('INF')",
      "    self.now = 0",
      "    self.N = 0",
      "    self.parent = [-1 for i in range(N)]",
      "    self.time = [INF for i in range(N)]",
      "    self.num = [[] for i in range(N)]",
      "    for i in range(N):",
      "      self.num[i].append((0,1))",
      "    ",
      "  def find(self,t,x):",
      "    '''",
      "    version:tにおけるxの根を見つける",
      "    t (any) : version",
      "    x (int) : 要素",
      "    return : int : 根",
      "    '''",
      "    while self.time[x] <= t:",
      "      x = self.parent[x]",
      "    return x",
      "    ",
      "  def merge(self,x,y):",
      "    '''",
      "    x,yをつなげる",
      "    x (int) : 要素",
      "    y (int) : 要素",
      "    '''",
      "    self.now += 1",
      "    x = self.find(self.now,x)",
      "    y = self.find(self.now,y)",
      "",
      "    if x == y:",
      "      return",
      "    ",
      "    if self.parent[x] > self.parent[y]:",
      "      x,y = y,x",
      "    ",
      "    ",
      "    self.parent[x] += self.parent[y]",
      "    self.parent[y] = x",
      "    self.time[y] = self.now",
      "    self.num[x].append((self.now,-self.parent[x]))",
      "",
      "  def same(self,t,x,y):",
      "    '''",
      "    version:tにおけるx,yが同じかどうかO(logN)",
      "    t (any) : version",
      "    x (int) : 要素",
      "    y (int) : 要素",
      "    return : bool : 同じかどうか",
      "    '''",
      "    return self.find(t,x) == self.find(t,y)",
      "",
      "  def size(self,t,x):",
      "    '''",
      "    version:tにおける要素xが含まれる集合の大きさ",
      "    t (any) : version",
      "    x (int) : 要素",
      "    return : int :集合の大きさ  ",
      "    '''",
      "    x = self.find(t,x)",
      "",
      "    ok = 0",
      "    ng = len(self.num[x])",
      "    while (ng-ok > 1):",
      "      mid = (ok+ng)>>1",
      "      if self.num[x][mid][0] <= t:",
      "        ok = mid",
      "      else:",
      "        ng = mid",
      "    ",
      "    return self.num[x][ok][1]",
      "",
      "  def merge_timming(self, x, y):",
      "    '''",
      "    x, yがマージされた時のnowの値を返す",
      "    マージされていない場合は-1を返す",
      "    O(logN)",
      "    '''",
      "    xt = self.time[x]",
      "    yt = self.time[y]",
      "    while x >= 0 and y >= 0:",
      "      if xt < yt:",
      "        x = self.parent[x]",
      "        if x == y: return xt",
      "        xt = self.time[x]",
      "      else:",
      "        y = self.parent[y]",
      "        if x == y: return yt",
      "        yt = self.time[y]",
      "    return -1",
      "",
      "# usage: u = UnionPersistentPart(N); v = u.merge(a, b); u.same(a, b, version=v)"
    ]
  },
  "dynamic_segtree": {
    "scope": "python",
    "prefix": "dynamic_segtree",
    "description": "動的セグ木 (要素 index が大きくても座圧不要・遅延ノード生成)",
    "body": [
      "class dinamic_segtree:",
      "  def __init__(self, N, op, e):",
      "    self.N = N",
      "    self.root = None",
      "    self.op = op",
      "    self.e = e",
      "  def set(self, p, x):",
      "    \"\"\"",
      "      pにxを代入",
      "    \"\"\"",
      "    self.root = self._set(self.root, 0, self.N, p, x)",
      "  def get(self, p):",
      "    \"\"\"",
      "      pの値を取得",
      "    \"\"\"",
      "    return self._get(self.root, 0, self.N, p)",
      "  def prod(self, l, r):",
      "    \"\"\"",
      "      l <= x < r の範囲の演算結果を取得",
      "    \"\"\"",
      "    return self._prod(self.root, 0, self.N, l, r)",
      "  def all_prod(self):",
      "    \"\"\"",
      "      全ての範囲の演算結果を取得",
      "    \"\"\"",
      "    return self.root.product if self.root else self.e()",
      "  def reset(self, l, r):",
      "    \"\"\"",
      "      l <= x < r の範囲のノードを削除",
      "    \"\"\"",
      "    self.root = self._reset(self.root, 0, self.N, l, r)",
      "  def max_right(self, l, g):",
      "    \"\"\"",
      "      lを固定したときにgを満たす最大のrを返す",
      "      未確認",
      "    \"\"\"",
      "    product = self.e()",
      "    return self._max_right(self.root, 0, self.N, l, g, product)",
      "  def min_left(self, r, g):",
      "    \"\"\"",
      "      rを固定したときにgを満たす最小のlを返す",
      "      未確認",
      "    \"\"\"",
      "    product = self.e()",
      "    self.min_left(self.root, 0, self.N, r, g, product)",
      "",
      "  class node:",
      "    def __init__(self, index, value):",
      "      self.index = index",
      "      self.value = value",
      "      self.product = value",
      "      self.left = None",
      "      self.right = None",
      "    def update(self, op, e):",
      "      self.product = op(op(self.left.product if self.left else e(), self.value), self.right.product if self.right else e())",
      "    def reset(self):",
      "      # ノードを削除してどこからも参照されないようにしたい",
      "      pass  ",
      "  def _set(self, t, a, b, p, x):",
      "    if not t: ",
      "      t = self.node(p, x)",
      "      return t",
      "    if t.index == p:",
      "      t.value = x",
      "      t.update(self.op, self.e)",
      "      return t",
      "    c = (a + b) >> 1",
      "    if p < c: ",
      "      if (t.index < p):",
      "        t.index, p = p, t.index",
      "        t.value, x = x, t.value",
      "      t.left = self._set(t.left, a, c, p, x)",
      "    else:",
      "      if (p < t.index):",
      "        t.index, p = p, t.index",
      "        t.value, x = x, t.value",
      "      t.right = self._set(t.right, c, b, p, x)",
      "    t.update(self.op, self.e)",
      "    return t",
      "  def _get(self, t, a, b, p):",
      "    if not t: return self.e()",
      "    if t.index == p: return t.value",
      "    c = (a + b) >> 1",
      "    if p < c: return self._get(t.left, a, c, p)",
      "    else: return self._get(t.right, c, b, p)",
      "  def _prod(self, t, a, b, l, r):",
      "    if (not t) or (b <= l) or (r <= a): return self.e()",
      "    if (l <= a) and (b <= r): return t.product",
      "    c = (a + b) >> 1",
      "    result = self._prod(t.left, a, c, l, r)",
      "    if (l <= t.index) and (t.index < r): result = self.op(result, t.value)",
      "    return self.op(result, self._prod(t.right, c, b, l, r))",
      "  def _reset(self, t, a, b, l, r):",
      "    if not t: return None",
      "    if (l <= a) and (b <= r): return None",
      "    c = (a + b) >> 1",
      "    t.left  = self._reset(t.left,  a, c, l, r)",
      "    t.right = self._reset(t.right, c, b, l, r)",
      "    if l <= t.index < r: t.value = self.e()",
      "    t.update(self.op, self.e)",
      "    if (t.value == self.e()) and (not t.left) and (not t.right): return None",
      "    return t",
      "  def _max_right(self, t, a, b, l, f, product):",
      "    if (not t) or (b <= l): return self.N",
      "    if f(self.op(product, t.product)):",
      "      product = self.op(product, t.product)",
      "      return self.N",
      "    c = (a + b) >> 1",
      "    result = self._max_right(t.left, a, c, l, f, product)",
      "    if result != self.N: return result",
      "    if l <= t.index:",
      "      product = self.op(product, t.value)",
      "      if (not f(product)): return t.index",
      "    return self._max_right(t.right, c, b, l, f, product)",
      "  def _min_left(self, t, a, b, r, f, product):",
      "    if (not t) or (r <= a): return 0",
      "    if f(self.op(t.product, product)):",
      "      product = self.op(t.product, product)",
      "      return 0",
      "    c = (a + b) >> 1",
      "    result = self._min_left(t.right, c, b, r, f, product)",
      "    if result != 0: return result",
      "    if t.index < r:",
      "      product = self.op(t.value, product)",
      "      if (not f(product)): return t.index + 1",
      "    return self._min_left(t.left, a, c, r, f, product)",
      "",
      "class segtreeFactory:",
      "  MAX_INT = 10 ** 18",
      "  MOD = 998244353",
      "  # サイズNのmaxSegTree",
      "  @staticmethod",
      "  def makeMaxSegTree(N): return dinamic_segtree(N, segtreeFactory.opmax, segtreeFactory.emax)",
      "  # サイズNのminSegTree",
      "  @staticmethod",
      "  def makeMinSegTree(N): return dinamic_segtree(N, segtreeFactory.opmin, segtreeFactory.emin)",
      "  # サイズNのsumSegTree",
      "  @staticmethod",
      "  def makeSumSegTree(N): return dinamic_segtree(N, segtreeFactory.opsum, segtreeFactory.esum)",
      "  # サイズNのfuncSegTree (一次関数の結合)",
      "  @staticmethod",
      "  def makeFuncSegTree(N): return dinamic_segtree(N, segtreeFactory.opfunc, segtreeFactory.efunc)",
      "  @staticmethod",
      "  def emax(): return 0",
      "  @staticmethod",
      "  def opmax(a, b): return max(a, b)",
      "  @staticmethod",
      "  def emin(): return segtreeFactory.MAX_INT",
      "  @staticmethod",
      "  def opmin(a, b): return min(a, b)",
      "  @staticmethod",
      "  def opsum(a, b): return a + b",
      "  @staticmethod",
      "  def esum(): return 0",
      "  @staticmethod",
      "  def efunc(): return [1, 0]",
      "  @staticmethod",
      "  def opfunc(a, b): return [a[0] * b[0] % segtreeFactory.MOD, (b[0] * a[1] + b[1]) % segtreeFactory.MOD] # 左を内側にして結合",
      "",
      "# usage: t = dinamic_segtree(N, op, e); t.set(i, x); t.prod(l, r)"
    ]
