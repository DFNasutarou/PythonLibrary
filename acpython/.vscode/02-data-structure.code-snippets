  "union": {
    "prefix": "union",
    "body": [
      "class Union:",
      "  def __init__(self, num):",
      "    self.T = [-1] * num",
      "",
      "  def root(self, x):",
      "    if self.T[x] < 0: return x",
      "    t = self.root(self.T[x])",
      "    self.T[x] = t",
      "    return t",
      "",
      "  def merge(self, x, y):",
      "    an, bn = self.root(x), self.root(y)",
      "    if an == bn: return False",
      "    am, bm = -self.T[an], -self.T[bn]",
      "    if am < bm: an, bn = bn, an",
      "    self.T[an] += self.T[bn]",
      "    self.T[bn] = an",
      "    return True",
      "",
      "  def size(self, x):",
      "    n = self.root(x)",
      "    return -self.T[n]",
      "",
      "  def same(self, x, y):",
      "    return self.root(x) == self.root(y)",
      "  ",
      "  def root_group(self):",
      "    '''",
      "    マージされているグループごとにリストにして返す",
      "    各グループの先頭は根である",
      "    '''",
      "    R = {}",
      "    ans: list[list[int]] = []",
      "    for i in range(len(self.T)):",
      "      t = self.root(i)",
      "      if t not in R:",
      "        R[t] = len(ans)",
      "        ans.append([t])",
      "      if t != i:",
      "        ans[R[t]].append(i)",
      "    return ans",
      "",
      "  def print(self): #デバッグ用",
      "    print(*self.T)",
      "    ans = []",
      "    for i in range(len(self.T)):",
      "      ans.append(self.root(i))",
      "    print(*ans)",
      "",
      "# usage: u = Union(N); u.merge(a, b); r = u.root(x); u.size(x)"
    ],
    "description": "Union-Find (経路圧縮 + サイズマージ、ほぼ O(α(N)))",
    "scope": "python"
