      "  @staticmethod",
      "  def makeAffineSumSegTree(v): return LSTFactory.LazySegTreeWithSize2ApplyWrp(LSTFactory.opaffine, 0, LSTFactory.mappingaffine, LSTFactory.compositionaffine, None, v)   ",
