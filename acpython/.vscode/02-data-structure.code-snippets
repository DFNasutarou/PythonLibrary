      "class AVL:",
      "  class Node:",
      "    def __init__(self, k, v):",
      "      self.k = k # key 一意",
      "      self.v = v # value 重複可",
      "      self.l = None # 小さいほう",
      "      self.r = None # 大きいほう",
      "      self.d = 1 # 深さ",
      "  def __init__(self):",
      "    self.x = None",
      "  def l_rot(self, z):",
      "    y = z.r",
      "    t = y.l",
      "    y.l, z.r = z, t",
      "    z.d = self.get_depth(z)",
      "    y.d = self.get_depth(y)",
      "    return y",
      "  def r_rot(self, z):",
      "    y = z.l",
      "    t = y.r",
      "    y.r, z.l = z, t",
      "    z.d = self.get_depth(z)",
      "    y.d = self.get_depth(y)",
      "    return y",
      "  def depth(self, node):",
      "    if not node: return 0",
      "    else: return node.d",
      "  def get_depth(self, node):",
      "    return 1 + max(self.depth(node.l), self.depth(node.r))",
      "  def balance(self, node):",
      "    return self.depth(node.l) - self.depth(node.r)",
      "  def rotate_l(self, node):",
      "    bal = self.balance(node)",
      "    if bal > 1:",
      "      if self.balance(node.l) >= 0:",
      "        node = self.r_rot(node)",
      "      else:",
      "        node.l = self.l_rot(node.l)",
      "        node = self.r_rot(node)",
      "    node.d = self.get_depth(node)",
      "    return node",
      "  def rotate_r(self, node):",
      "    bal = self.balance(node)",
      "    if bal < -1:",
      "      if self.balance(node.r) <= 0:",
      "        node = self.l_rot(node)",
      "      else:",
      "        node.r = self.r_rot(node.r)",
      "        node = self.l_rot(node)",
      "    node.d = self.get_depth(node)",
      "    return node",
      "  #挿入  ",
      "  def insert(self, k, v): ",
      "    self.x = self.insert_sub(self.x, k, v)",
      "  def insert_sub(self, node, k, v):",
      "    if not node: return self.Node(k, v)",
      "    elif node.k == k: return node",
      "    elif node.k > k: ",
      "      node.l = self.insert_sub(node.l, k, v)",
      "      return self.rotate_l(node)",
      "    else:",
      "      node.r = self.insert_sub(node.r, k, v)",
      "      return self.rotate_r(node)",
      "  #削除",
      "  def delete(self, k):",
      "    self.x = self.delete_sub(self.x, k)",
      "  def delete_sub(self, node, k):",
      "    if not node: return None",
      "    elif node.k == k:",
      "      if node.l is None: return node.r",
      "      else:",
      "        node.l = self.delete_max(node.l)",
      "        node.k = self.k",
      "        node.v = self.v",
      "        return self.rotate_l(node)",
      "    elif node.k > k: ",
      "      node.l = self.delete_sub(node.l, k)",
      "      return self.rotate_r(node)",
      "    else: ",
      "      node.r = self.delete_sub(node.r, k)",
      "      return self.rotate_l(node)",
      "  def delete_max(self, node):",
      "    if node.r == None:",
      "      self.k = node.k",
      "      self.v = node.v",
      "      return node.l",
      "    else:",
      "      node.r = self.delete_max(node.r)",
      "      return self.rotate_r(node)",
      "  #探索",
      "  def check(self, k):",
      "    return self.check_sub(k, self.x)",
      "  def check_sub(self, k, node):",
      "    if node == None: return False",
      "    if node.k == k: return True",
      "    if node.k > k: return self.check_sub(k, node.l)",
      "    else: return self.check_sub(k, node.r)",
      "  def getMax(self):",
      "    if not self.x: return None, None",
      "    return self.check_max_sub(self.x)",
      "  def check_max_sub(self, node):",
      "    if node.r: return self.check_max_sub(node.r)",
      "    else: return node.k, node.v",
      "  def getMin(self):",
      "    if not self.x: return None, None",
      "    return self.check_min_sub(self.x)",
      "  def check_min_sub(self, node):",
      "    if node.l: return self.check_min_sub(node.l)",
      "    else: return node.k, node.v",
      "  #表示",
      "  def print(self):",
      "    print(\"------------------------\")",
      "    self.print_sub(self.x)",
      "    print(\"------------------------\")",
      "  def print_sub(self, node):",
      "    if node:",
      "      self.print_sub(node.r)",
      "      print(\" \" * (self.x.d - node.d) + str(node.k) + \":\" + str(node.v))",
      "      self.print_sub(node.l)",
      "  #リスト作成",
      "  def makeKeyList(self, L):",
      "    N = len(L)",
      "    D = [[L[i], i, 0] for i in range(N)]",
      "    D.sort()",
      "    for i in range(N):",
      "      D[i][2] = i",
      "    D.sort(key = lambda x: x[1])",
      "    return [D[i][2] for i in range(N)]",
      "",
      "# usage: t = AVL(); t.insert(k, v); t.get(k); t.remove(k)"
    ],
    "description": "AVL 木 (平衡二分探索木、key/value 対応)",
    "scope": "python"
  },
  "bit": {
    "prefix": "bit",
    "body": [
      "class BIT:",
      "  ini = 0",
      "  def __init__(self, num):",
      "    self.N = 1",
      "    while self.N <= num:",
      "      self.N *= 2",
      "    self.T = [self.ini] * self.N",
      "  def set(self, L):",
      "    for i in range(len(L)):",
      "      self.update(i, L[i])",
      "  def update(self, x, n): # xにnを加える",
      "    k = x + 1",
      "    self.T[k - 1] += n",
      "    k += k & -k",
      "    while k <= self.N:",
      "      self.T[k - 1] += n",
      "      k += k & -k",
      "  def getV(self, x): # xまでの和(x含む)",
      "    if x < 0: return 0",
      "    x += 1",
      "    ans = self.T[x - 1]",
      "    x -= x & -x",
      "    while x != 0:",
      "      ans += self.T[x - 1]",
      "      x -= x & -x",
      "    return ans",
      "",
      "# usage: bit = BIT(N); bit.update(i, x); s = bit.getV(r)"
    ],
    "description": "BIT / フェニック木 (1点更新・区間和、全操作 O(log N))",
    "scope": "python"
