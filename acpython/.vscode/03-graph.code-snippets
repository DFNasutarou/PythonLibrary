  "treedp": {
    "prefix": "treedp",
    "body": [
      "class TreeDP:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # 木 DP（葉→根の 1 方向）と全方位木 DP。tree スニペットの Tree が必要。頂点番号は Tree と同じ 0-indexed",
      "  # 【考え方】v を根とする部分木の値 dp[v] を次の式で計算する",
      "  #   dp[v] = add_root(merge(e, add_edge(dp[c1], c1, v, w1), add_edge(dp[c2], c2, v, w2), ...), v)",
      "  #   1. add_edge: 子 c の値 dp[c] を「親 v から見た寄与」に変換する（辺の重みを足す等）",
      "  #   2. merge: 子の寄与を e から順にまとめる（葉は子がないので e のまま）",
      "  #   3. add_root: まとめた寄与に頂点 v 自身の分を加えて dp[v] にする",
      "  # 【引数】TreeDP(tr, e, merge, add_root, add_edge=None)",
      "  #   e: merge の単位元（merge(e, x) == x となる値）",
      "  #   merge(a, b): 寄与どうしをまとめる。solve では結合的・可換が必要。bottom_up のみなら adj の順に左から畳み込む",
      "  #   add_root(x, v): まとめた寄与 x に頂点 v 自身を加えて dp[v] にする",
      "  #   add_edge(x, c, v, w): 子 c の値 x を辺 c-v（重み w。重みなし Tree なら w=1）越しの寄与にする。省略時は x のまま",
      "  # 【メソッド】",
      "  #   bottom_up(): tr.root を根とした dp を葉から順に計算してリストで返す O(N)（普通の木 DP はこれだけ）",
      "  #   solve(): 全頂点それぞれを根にしたときの dp[根] のリストを返す O(N)（全方位木 DP）",
      "  #   sub[v]: tr.root を根としたときの dp[v]（bottom_up / solve の後に参照可）",
      "  def __init__(self, tr, e, merge, add_root, add_edge=None):",
      "    self.tr = tr; self.e = e; self.merge = merge; self.add_root = add_root",
      "    self.add_edge = add_edge if add_edge is not None else (lambda x, c, v, w: x)",
      "    self.sub = None",
      "  def bottom_up(self):",
      "    tr = self.tr; par = tr.par; adj = tr.adj",
      "    e = self.e; merge = self.merge; add_root = self.add_root; add_edge = self.add_edge",
      "    sub = [None] * tr.N",
      "    for v in reversed(tr.order):",
      "      x = e",
      "      for c, w in adj[v]:",
      "        if c != par[v]: x = merge(x, add_edge(sub[c], c, v, w))",
      "      sub[v] = add_root(x, v)",
      "    self.sub = sub",
      "    return sub",
      "  def solve(self):",
      "    tr = self.tr; N = tr.N; par = tr.par; adj = tr.adj",
      "    e = self.e; merge = self.merge; add_root = self.add_root; add_edge = self.add_edge",
      "    sub = self.bottom_up()",
      "    up = [None] * N  # up[v]: v を根にしたとき、親 par[v] 側の部分木の値",
      "    ans = [None] * N",
      "    for v in tr.order:",
      "      nb = adj[v]; k = len(nb)",
      "      val = [None] * k",
      "      for i in range(k):",
      "        c, w = nb[i]",
      "        val[i] = add_edge(up[v], c, v, w) if c == par[v] else add_edge(sub[c], c, v, w)",
      "      suf = [e] * (k + 1)",
