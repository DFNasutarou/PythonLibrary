      "class scc_graph:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  @staticmethod",
      "  def groups(N, adj):",
      "    \"\"\"",
      "    強連結成分分解（隣接リスト版）",
      "    N: 頂点数",
      "    adj: 隣接リスト。adj[v] は v から出る辺の行き先のリスト",
      "         （重みあり (行き先, 重み) のタプルでも可）",
      "    戻り値: 強連結成分ごとの頂点リストのリスト。トポロジカル順",
      "    O(N + M)",
      "    \"\"\"",
      "    group_num, ids = scc_graph._ids(N, adj)",
      "    groups = [[] for _ in range(group_num)]",
      "    for v in range(N):",
      "      groups[ids[v]].append(v)",
      "    return groups",
      "",
      "  @staticmethod",
      "  def compress(graph):",
      "    \"\"\"",
      "    強連結成分を1頂点に縮約した有向グラフを作る",
      "    graph: 有向グラフ GraphData（graphスニペット）。重みは無視される",
      "    戻り値: (縮約後の有向グラフ GraphData, ids)",
      "      ids[v] = 元の頂点 v が属する成分の番号（縮約後の頂点番号）",
      "      縮約後は番号の昇順がトポロジカル順（DAG）",
      "    \"\"\"",
      "    group_num, ids = scc_graph._ids(graph.N, graph.adj_list)",
      "    compressed = GraphData(group_num, True)",
      "    seen = set()",
      "    for frm, to, *_ in graph.get_edges():",
      "      a = ids[frm]",
      "      b = ids[to]",
      "      if a == b or (a, b) in seen: continue",
      "      seen.add((a, b))",
      "      compressed.add_edge(a, b)",
      "    return compressed, ids",
      "",
      "  @staticmethod",
      "  def _ids(N, adj):",
      "    \"\"\"",
      "    N: 頂点数",
      "    adj: 隣接リスト（groups と同じ）",
      "    戻り値: (成分の個数, ids)  ids[v] = 頂点 v の成分番号（トポロジカル順）",
      "    \"\"\"",
      "    visited = []",
      "    low = [0] * N",
      "    ord = [-1] * N",
      "    ids = [0] * N",
      "    NG=[0,0]",
      "",
      "    for i in range(N):",
      "      if ord[i] != -1:continue",
      "      stack=[(i,-1,0),(i,-1,1)]",
      "      while stack:",
      "        v,bef,t=stack.pop()",
      "        if t:",
      "          if bef!=-1 and ord[v]!=-1:",
      "            low[bef]=min(low[bef],ord[v])",
      "            stack.pop()",
      "            continue",
      "          low[v]=NG[0]",
      "          ord[v]=NG[0]",
      "          NG[0]+=1",
      "          visited.append(v)",
      "          for edge in adj[v]:",
      "            to = edge[0] if isinstance(edge, (tuple, list)) else edge",
      "            if ord[to]==-1:",
      "              stack.append((to,v,0))",
      "              stack.append((to,v,1))",
      "            else:",
      "              low[v]=min(low[v],ord[to])",
      "        else:",
      "          if low[v]==ord[v]:",
      "            while(True):",
      "              u=visited.pop()",
      "              ord[u]=N",
      "              ids[u]=NG[1]",
      "              if u==v:",
      "                  break",
      "            NG[1]+=1",
      "          low[bef]=min(low[bef],low[v])",
      "    for i in range(N):",
      "      ids[i]=NG[1]-1-ids[i]",
      "    return NG[1], ids",
      "",
      "# usage",
      "# groups = scc_graph.groups(N, adj)  # adj[v] = vから出る辺の行き先リスト",
      "# compressed, ids = scc_graph.compress(graph)  # graph: GraphData(N, True)"
    ],
    "description": "強連結成分分解 SCC (有向グラフを縮約して DAG 化)",
    "scope": "python"
