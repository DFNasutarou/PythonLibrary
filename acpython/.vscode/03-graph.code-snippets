      "              ord[u]=N",
      "              ids[u]=NG[1]",
      "              if u==v:",
      "                  break",
      "            NG[1]+=1",
      "          low[bef]=min(low[bef],low[v])",
      "    for i in range(N):",
      "      ids[i]=NG[1]-1-ids[i]",
      "    return NG[1], ids",
