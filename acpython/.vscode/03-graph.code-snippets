  "tree": {
    "prefix": "tree",
    "body": [
      "class Tree:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # 木の前処理（非再帰 DFS 1 回 + HLD）。頂点は内部で 0-indexed（index=1 で 1-indexed 入力を変換）",
      "  #   Tree(N, edges, root=None, index=0, weighted=False): edges = [(u, v)] or [(u, v, w)]",
      "#     root は edges と同じ番号付け（省略時は内部番号 0 の頂点）",
      "  #   lca(u, v): 最小共通祖先 O(log N)",
      "  #   kth_ancestor(v, k): v から k 個上の祖先（無ければ -1）O(log N)",
      "  #   jump(u, v, k): u から v へ向かって k 歩進んだ頂点（無ければ -1）O(log N)",
      "  #   dist(u, v): u-v 間の距離（weighted=False なら辺数）O(log N)",
      "  #   path(u, v): u から v へのパス上の頂点リスト O(パス長)",
      "  #   subtree(v): v の部分木が占める pos の半開区間 (l, r)",
      "  #   path_ranges(u, v, edge=False): u→v パスを pos の区間 (l, r, rev) 列に分解（rev=True は r-1→l の向き）",
      "  #   edge_vertex(a, b): 辺 (a, b) の子側の頂点（辺の値を載せる位置）",
      "  #   diameter(): (直径, 端点 a, 端点 b)",
      "  #   debug(): 各配列を print する",
      "  # 属性: par[v] 親(根は -1), depth[v] 辺数の深さ, wdepth[v] 重み付き深さ, pw[v] 親への辺の重み,",
      "  #   size[v] 部分木サイズ, order 先行順の頂点列, adj[v] = [(to, w)], pos[v] HLD 順の位置, at[p] 位置 p の頂点",
      "  def __init__(self, N, edges, root=None, index=0, weighted=False):",
      "    self.N = N",
      "    self.root = root = 0 if root is None else root - index",
      "    adj = [[] for _ in range(N)]",
      "    for e in edges:",
      "      u = e[0] - index; v = e[1] - index; w = e[2] if weighted else 1",
      "      adj[u].append((v, w)); adj[v].append((u, w))",
      "    self.adj = adj",
      "    par = [-1] * N; depth = [0] * N; wdepth = [0] * N; pw = [0] * N",
      "    order = [root]; seen = [False] * N; seen[root] = True",
      "    for v in order:",
      "      for to, w in adj[v]:",
      "        if not seen[to]:",
      "          seen[to] = True",
      "          par[to] = v; depth[to] = depth[v] + 1; wdepth[to] = wdepth[v] + w; pw[to] = w",
      "          order.append(to)",
      "    size = [1] * N; heavy = [-1] * N",
      "    for v in reversed(order):",
      "      p = par[v]",
      "      if p != -1:",
      "        size[p] += size[v]",
      "        if heavy[p] == -1 or size[heavy[p]] < size[v]: heavy[p] = v",
      "    head = [0] * N; pos = [0] * N; at = [0] * N",
      "    st = [root]; head[root] = root; t = 0",
      "    while st:",
      "      v = st.pop()",
      "      pos[v] = t; at[t] = v; t += 1",
      "      h = heavy[v]",
      "      for to, _ in adj[v]:",
      "        if to != par[v] and to != h:",
      "          head[to] = to; st.append(to)",
      "      if h != -1:",
      "        head[h] = head[v]; st.append(h)",
      "    self.par = par; self.depth = depth; self.wdepth = wdepth; self.pw = pw",
      "    self.order = order; self.size = size; self.heavy = heavy",
      "    self.head = head; self.pos = pos; self.at = at",
      "  def lca(self, u, v):",
      "    head = self.head; pos = self.pos; par = self.par",
      "    while head[u] != head[v]:",
      "      if pos[head[u]] > pos[head[v]]: u = par[head[u]]",
      "      else: v = par[head[v]]",
      "    return u if pos[u] < pos[v] else v",
      "  def kth_ancestor(self, v, k):",
      "    if k < 0 or k > self.depth[v]: return -1",
      "    head = self.head; depth = self.depth",
      "    while depth[v] - depth[head[v]] < k:",
      "      k -= depth[v] - depth[head[v]] + 1",
      "      v = self.par[head[v]]",
      "    return self.at[self.pos[v] - k]",
      "  def jump(self, u, v, k):",
      "    c = self.lca(u, v)",
      "    du = self.depth[u] - self.depth[c]; dv = self.depth[v] - self.depth[c]",
      "    if k <= du: return self.kth_ancestor(u, k)",
      "    if k <= du + dv: return self.kth_ancestor(v, du + dv - k)",
      "    return -1",
      "  def dist(self, u, v):",
      "    return self.wdepth[u] + self.wdepth[v] - 2 * self.wdepth[self.lca(u, v)]",
      "  def path(self, u, v):",
      "    c = self.lca(u, v); a = []; b = []",
      "    while u != c: a.append(u); u = self.par[u]",
      "    while v != c: b.append(v); v = self.par[v]",
      "    a.append(c)",
      "    return a + b[::-1]",
      "  def subtree(self, v):",
      "    return self.pos[v], self.pos[v] + self.size[v]",
      "  def path_ranges(self, u, v, edge=False):",
      "    # edge=True なら LCA の頂点を含めない（辺の値は子側の頂点に置く前提）",
      "    head = self.head; pos = self.pos; par = self.par",
      "    up = []; down = []",
      "    while head[u] != head[v]:",
      "      if pos[head[u]] > pos[head[v]]:",
      "        up.append((pos[head[u]], pos[u] + 1, True)); u = par[head[u]]",
      "      else:",
      "        down.append((pos[head[v]], pos[v] + 1, False)); v = par[head[v]]",
      "    if pos[u] >= pos[v]: up.append((pos[v] + edge, pos[u] + 1, True))",
      "    else: down.append((pos[u] + edge, pos[v] + 1, False))",
      "    return [x for x in up + down[::-1] if x[0] < x[1]]",
      "  def edge_vertex(self, a, b):",
      "    return a if self.par[a] == b else b",
      "  def _far(self, s):",
      "    d = [-1] * self.N; d[s] = 0; st = [s]; best = s",
      "    while st:",
      "      v = st.pop()",
      "      if d[v] > d[best]: best = v",
      "      for to, w in self.adj[v]:",
      "        if d[to] == -1: d[to] = d[v] + w; st.append(to)",
      "    return best, d[best]",
      "  def diameter(self):",
      "    a, _ = self._far(self.root)",
      "    b, d = self._far(a)",
      "    return d, a, b",
      "  def debug(self):",
      "    print(\"par   \", self.par)",
      "    print(\"depth \", self.depth)",
      "    print(\"wdepth\", self.wdepth)",
      "    print(\"size  \", self.size)",
      "    print(\"pos   \", self.pos)",
      "    print(\"head  \", self.head)",
      "",
      "# usage",
      "# tr = Tree(N, edges, index=1)  # edges が 1-indexed なら index=1（root も同じ番号付け、以降のメソッドは 0-indexed で呼ぶ）",
      "# tr = Tree(N, edges, weighted=True)     # 重み付き edges = [(u, v, w), ...]",
      "# c = tr.lca(u, v)",
      "# d = tr.dist(u, v)",
      "# x = tr.jump(u, v, k)",
      "# d, a, b = tr.diameter()",
      "# p = tr.path(a, b)",
      "# l, r = tr.subtree(v)  # v の部分木の頂点 = tr.at[l:r]",
      "# tr.debug()"
    ],
    "description": "木の前処理 Tree (LCA / k 個上の祖先 / 距離 / パス / 部分木区間 / 直径 / HLD 区間分解、重み対応、構築 O(N)・クエリ O(log N))",
    "scope": "python"
  },
  "treepath": {
