      "        if len(ans) == C:",
      "          self.deq.add_r(d)",
      "          # for _ in range(i):",
      "          #   self.deq.add_r(self.deq.pop_l())",
      "          return ans",
      "      self.deq.add_l(d)",
      "    # for _ in range(i - 1):",
      "    #   self.deq.add_r(self.deq.pop_l())",
      "    return ans",
      "",
      "  # グラフ内の三角形数え上げ(O(M√出次数の最大値))",
      "  def enumerateTriangles(self):# -> Generator[tuple[int, Any, Any], Any, None]:",
      "    Data = [-1] * (self.N + 1)",
      "    for i, x in enumerate(self.AdjacencyList):",
      "      for _, j in x: Data[j] = i",
      "      for _, j in x: ",
