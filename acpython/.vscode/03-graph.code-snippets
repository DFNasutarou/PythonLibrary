      "  @staticmethod",
      "  def _scc_ids(N: int, g):",
      "    \"\"\"",
      "    グループの個数と各頂点のグループidを返す",
      "    \"\"\"",
      "    visited = []",
      "    low = [0] * N",
      "    ord = [-1] * N",
      "    ids = [0] * N",
      "    NG=[0,0]",
      "",
      "    for i in range(N):",
      "      if ord[i] != -1:continue",
      "      stack=[(i,-1,0),(i,-1,1)]",
      "      while stack:",
      "        v,bef,t=stack.pop()",
      "        if t:",
      "          if bef!=-1 and ord[v]!=-1:",
      "            low[bef]=min(low[bef],ord[v])",
      "            stack.pop()",
      "            continue",
      "          low[v]=NG[0]",
      "          ord[v]=NG[0]",
      "          NG[0]+=1",
      "          visited.append(v)",
      "          for _, to in g[v]:",
      "            if ord[to]==-1:",
      "              stack.append((to,v,0))",
      "              stack.append((to,v,1))",
      "            else:",
      "              low[v]=min(low[v],ord[to])",
      "        else:",
