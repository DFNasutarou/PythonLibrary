  "auxtree": {
    "prefix": "auxtree",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "# ------------------------------------------------",
      "def auxtree(tr, vs):",
      "  # 頂点集合 vs とそれらの LCA だけを残した圧縮木（Auxiliary Tree）。tree スニペットの Tree が必要",
      "  # 戻り値 (nodes, par): nodes は圧縮木の頂点（DFS 順、nodes[0] が根）、par[i] は nodes[i] の親の nodes 内添字（根は -1）",
      "  # 辺の長さは tr.dist(nodes[i], nodes[par[i]]) で求める。O(K log N)（K = len(vs)）",
      "  if not vs: return [], []",
      "  pos = tr.pos",
      "  a = sorted(set(vs), key=lambda v: pos[v])",
      "  b = a[:]",
      "  for i in range(len(a) - 1): b.append(tr.lca(a[i], a[i + 1]))",
      "  nodes = sorted(set(b), key=lambda v: pos[v])",
      "  idx = {v: i for i, v in enumerate(nodes)}",
      "  par = [-1] * len(nodes)",
      "  st = [nodes[0]]",
      "  for v in nodes[1:]:",
      "    while pos[st[-1]] + tr.size[st[-1]] <= pos[v]: st.pop()",
      "    par[idx[v]] = idx[st[-1]]",
      "    st.append(v)",
      "  return nodes, par",
      "",
      "# usage",
      "# tr = Tree(N, edges)",
      "# nodes, par = auxtree(tr, vs)",
      "# for i in range(1, len(nodes)):",
      "#   length = tr.dist(nodes[i], nodes[par[i]])"
    ],
    "description": "圧縮木 Auxiliary Tree (頂点集合と LCA だけ残した木、tree スニペットが必要、O(K log N))",
    "scope": "python"
  },
  "warflo": {
    "prefix": "warflo",
    "body": [
      "class warflo:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # add(a, b, c): a から b へ c の辺を張る (負の辺は不可)",
      "  # exe(): 各点間の距離を求める (O(N^3))",
      "  # route(a, b): a から b への経路を返す (先に exe() をすること)",
      "  def __init__(self, N, inf):",
      "    self.inf = inf",
      "    self.D = [[self.inf] * N for _ in range(N)]",
      "    self.V = [[0] * N for _ in range(N)]",
      "    self.N = N",
      "  def add (self, a, b, c):",
      "    if c < self.D[a][b]: self.D[a][b] = c # 多重辺は最小を採用",
      "  def exe(self):",
      "    for i in range(self.N):",
      "      for j in range(self.N):",
      "        self.V[i][j] = i",
      "      self.D[i][i] = 0",
      "    for k in range(self.N):",
      "      for i in range(self.N):",
      "        if self.D[i][k] == self.inf: continue",
      "        for j in range(self.N):",
      "          if self.D[i][k] + self.D[k][j] < self.D[i][j]:",
      "            self.D[i][j] = self.D[i][k] + self.D[k][j]",
      "            self.V[i][j] = self.V[k][j]",
      "    return self.D",
      "  def route(self, a, b):",
      "    if self.D[a][b] == self.inf:",
      "      return []",
      "    c = b",
      "    L = [b]",
      "    while c != a:",
      "      c = self.V[a][c]",
      "      L.append(c)",
      "    L.reverse()",
      "    return L",
      "",
      "# usage",
      "# wf = warflo(N, inf)",
      "# wf.add(a, b, w)",
      "# D = wf.exe()"
    ],
    "description": "ワーシャル・フロイド法 (全点対最短距離 O(N^3))",
    "scope": "python"
  },
  "tree64": {
    "scope": "python",
    "prefix": "tree64",
    "description": "Tree64 (深さ × ビット幅で部分木列を 64bit 整数化、定数倍高速化)",
    "body": [
      "class Tree64:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # 2 ** (HEIGHT * BIT_SIZE) - 1 まで可能",
      "  # HEIGHT = 8, BIT_SIZE = 6の場合",
      "  # 2 ** 48 - 1 >= 10 ** 14",
      "  HEIGHT = 8",
      "  BIT_SIZE = 6",
      "  SIZE = 1 << BIT_SIZE",
      "  MASK = SIZE - 1",
      "  LIMIT = 1 << (HEIGHT * BIT_SIZE) # 扱える値は 0 <= n < LIMIT",
      "  class Node:",
      "    def __init__(self, flag):",
      "      self.D = 0",
      "      if flag:",
      "        self.L = [None] * Tree64.SIZE",
      "    def add(self, n, height):",
      "      if height == 0 :",
      "        x = n & Tree64.MASK",
      "        self.D |= (1 << x)",
      "        return",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if self.L[x] == None: self.L[x] = Tree64.Node(height != 1)",
      "      self.L[x].add(n, height - 1)",
      "      self.D |= (1 << x)",
      "    def erace(self, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        if self.D & (1 << x):",
      "          self.D ^= (1 << x)",
      "          return self.D == 0",
      "        return False",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if self.L[x] == None: return False",
      "      if self.L[x].erace(n, height - 1):",
      "        self.L[x] = None",
      "        self.D ^= (1 << x)",
      "        return self.D == 0",
      "      return False",
      "    def find(self, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return self.D & (1 << x)",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if self.L[x] == None: return False",
      "      return self.L[x].find(n, height - 1)",
      "    def find_upper(self, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return self.get_upper_bit(x)",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if self.L[x] != None:",
      "        ans = self.L[x].find_upper(n, height - 1)",
      "        if ans != None: return (x << shift) + ans",
      "      y = self.get_upper_bit(x + 1)",
      "      if y == None: return None",
      "      return (y << shift) + self.L[y].find_min(height - 1)",
      "    def find_lower(self, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return self.get_lower_bit(x)",
      "      if height == -1: return 0",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if self.L[x] != None:",
      "        ans = self.L[x].find_lower(n, height - 1)",
      "        if ans != None: return (x << shift) + ans",
      "      y = self.get_lower_bit(x - 1)",
      "      if y == None: return None",
      "      return (y << shift) + self.L[y].find_max(height - 1)",
      "    # 指定したbit以上の中で一番下のbitを返す",
      "    def get_upper_bit(self, x):",
      "      d = self.D & ~((1 << x) - 1)",
      "      if d == 0: return None",
      "      return (d & -d).bit_length() - 1",
      "    # 指定したbit以下の中で一番上のbitをす",
      "    def get_lower_bit(self, x):",
      "      d = self.D & (1 << (x + 1)) - 1",
      "      if d == 0: return None ",
      "      return d.bit_length() - 1",
      "    # 一番小さい値を返す",
      "    def find_min(self, height):",
      "      if self.D == 0: return None",
      "      if height == 0: return self.get_upper_bit(0)",
      "      x = (self.D & -self.D).bit_length() - 1",
      "      if height == 0: return x",
      "      shift = Tree64.BIT_SIZE * height",
      "      return (x << shift) + self.L[x].find_min(height - 1)",
      "    # 一番大きい値を返す",
      "    def find_max(self, height):",
      "      if self.D == 0: return None",
      "      if height == 0: return self.get_lower_bit(Tree64.SIZE - 1)",
      "      x = self.D.bit_length() - 1",
      "      if height == 0: return x",
      "      shift = Tree64.BIT_SIZE * height",
      "      return (x << shift) + self.L[x].find_max(height - 1)",
      "    ",
      "  # 初期化",
      "  def __init__(self):",
      "    self.root = Tree64.Node(True)",
      "  # n を追加",
      "  def add(self, n):",
      "    assert 0 <= n < Tree64.LIMIT",
      "    self.root.add(n, Tree64.HEIGHT - 1)",
      "  # n を削除",
      "  def erace(self, n):",
      "    assert 0 <= n < Tree64.LIMIT",
      "    self.root.erace(n, Tree64.HEIGHT - 1)",
      "  # n がある : true, ない : false",
      "  def find(self, n):",
      "    assert 0 <= n < Tree64.LIMIT",
      "    return self.root.find(n, Tree64.HEIGHT - 1)",
      "  # n 以上の数で一番小さい値を返す　なければ-1",
      "  def find_upper(self, n):",
      "    assert 0 <= n < Tree64.LIMIT",
      "    ans =  self.root.find_upper(n, Tree64.HEIGHT - 1)",
      "    if ans == None: return -1",
      "    return ans",
      "  # n 以下の数で一番大きい値を返す　なければ-1 ",
      "  def find_lower(self, n):",
      "    assert 0 <= n < Tree64.LIMIT",
      "    ans = self.root.find_lower(n, Tree64.HEIGHT - 1)",
      "    if ans == None: return -1",
      "    return ans",
      "",
      "# usage",
      "# t = Tree64()",
      "# t.add(n)",
      "# ok = t.find(n)"
    ]
  },
  "graph": {
    "scope": "python",
    "prefix": "graph",
    "description": "グラフ汎用クラス GraphData (有向/無向 + 重み 切替)",
    "body": [
      "class GraphData:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  def __init__(self, N: int, directed: bool = False, weighted: bool = False):",
      "    self.N = N",
      "    self.directed = directed",
      "    self.weighted = weighted",
      "    self.adj_list = [[] for _ in range(N)]",
      "    if directed:",
      "      self.rev_list = [[] for _ in range(N)]",
      "      self.inputCount = [0] * (N)",
      "  @staticmethod",
      "  def convert_indexed(data, indexed = 1):",
      "    \"\"\"",
      "      1-indexedを0-indexedに変換",
      "    \"\"\"",
      "    data = [[a - indexed, b - indexed] + c for a, b, *c in data]",
      "    return data",
      "  def add_edge(self, a, b, weight = 1):",
      "    if self.weighted:",
      "      self.adj_list[a].append((b, weight))",
      "      if self.directed: self.rev_list[b].append((a, weight))",
      "      else: self.adj_list[b].append((a, weight))",
      "    else:",
      "      self.adj_list[a].append(b)",
      "      if self.directed: self.rev_list[b].append(a) ",
      "      else: self.adj_list[b].append(a)",
      "    if self.directed:",
      "      self.inputCount[b] += 1",
      "  def add_edges(self, list):",
      "    if self.weighted:",
      "      for a, b, x in list: self.add_edge(a, b, x)",
      "    else:",
      "      for a, b in list: self.add_edge(a, b)",
      "  def get_edges(self):",
      "    ans = []",
      "    for frm in range(len(self.adj_list)):",
      "      if self.weighted:",
      "        for to, value in self.adj_list[frm]:",
      "          ans.append([frm, to, value])",
      "      else:",
      "        for to in self.adj_list[frm]:",
      "          ans.append([frm, to])",
      "    return ans",
      "  def getDrectedGraphMinimum(self)  -> \"GraphData\":",
      "    \"\"\"",
      "      無向グラフのとき、",
      "      出次数の最大値が√2M以下になるように有向グラフを作成する",
      "      自己ループは無視",
      "    \"\"\"",
      "    graph = GraphData(self.N, True, self.weighted)",
      "    for frm in range(len(self.adj_list)):",
      "      for to in self.adj_list[frm]:",
      "        if self.weighted: to, value = to",
      "        else: value = 1",
      "        if frm >= to: continue",
      "        if len(self.adj_list[frm]) < len(self.adj_list[to]): graph.add_edge(frm, to, value)",
      "        else: graph.add_edge(to, frm, value)",
      "    return graph",
      "  def getDfsTreeNodes(self, root = 0):",
      "    \"\"\"",
      "      無向グラフのとき、",
      "      DFS木を構築する辺と後退辺に分解する",
      "      戻り値: [木辺のリスト, 後退辺のリスト]（各辺は [x, y] / 重みありは [x, y, w]）。多重辺は後退辺に含む、自己ループは含まない",
      "    \"\"\"",
      "    ans = [[], []]",
      "    find = [-2] * len(self.adj_list)",
      "    find[root] = -1",
      "    depth = [-1] * len(self.adj_list)",
      "    depth[root] = 0",
      "    used_par = [False] * len(self.adj_list) # 親へ戻る辺を1本だけ読み飛ばした（多重辺対策）",
      "    q = []",
      "    if len(self.adj_list[root]) != 0:  q.append([root, 0])",
      "    while q:",
      "      x, n = q.pop()",
      "      if len(self.adj_list[x]) != n + 1: q.append([x, n + 1])",
      "      if self.weighted:",
      "        y, w = self.adj_list[x][n]",
      "        data = [x, y, w]",
      "      else:",
      "        y = self.adj_list[x][n]",
      "        data = [x, y]",
      "      if find[y] == -2:",
      "        ans[0].append(data)",
      "        find[y] = x",
      "        depth[y] = depth[x] + 1",
      "        if len(self.adj_list[y]) != 0: q.append([y, 0])",
      "      elif find[x] == y and not used_par[x]:",
      "        used_par[x] = True # 木辺の逆向き。2本目以降の多重辺は後退辺として扱う",
      "      elif depth[y] < depth[x]:",
      "        ans[1].append(data)",
      "    return ans",
      "",
      "# usage",
      "# g = GraphData(N, directed=True, weighted=False)",
      "# g.add_edge(a, b)"
    ]
  },
  "bfs": {
    "scope": "python",
    "prefix": "bfs",
    "description": "01-BFS (辺重み 0/1 限定、deque で O(N+M))",
    "body": [
      "from collections import deque",
      "import heapq",
      "",
      "class Graph:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  __slots__ = ['N', 'directed', 'weighted', 'adj_list']",
      "  ",
      "  def __init__(self, N: int, directed: bool = False, weighted: bool = False):",
      "    self.N = N",
      "    self.directed = directed",
      "    self.weighted = weighted",
      "    self.adj_list = [[] for _ in range(N + 1)]",
      "  ",
      "  def add_edge(self, a: int, b: int, weight: int = 1):",
      "    \"\"\"",
      "    辺を追加",
      "    \"\"\"",
      "    if self.weighted:",
      "      self.adj_list[a].append((b, weight))",
      "      if not self.directed:",
      "        self.adj_list[b].append((a, weight))",
      "    else:",
      "      self.adj_list[a].append(b)",
      "      if not self.directed:",
      "        self.adj_list[b].append(a)",
      "  ",
      "  def add_edges(self, edges: list):",
      "    \"\"\"",
      "    辺リストの追加。",
      "    重みありの場合は (a, b, weight)、なしの場合は (a, b) の形で指定する。",
      "    \"\"\"",
      "    if self.weighted:",
      "      for edge in edges:",
      "        a, b, weight = edge",
      "        self.add_edge(a, b, weight)",
      "    else:",
      "      for edge in edges:",
      "        a, b = edge",
      "        self.add_edge(a, b)",
      "  ",
      "  def get_edges(self) -> list:",
      "    \"\"\"",
      "    全ての辺をリストで返す。",
      "    \"\"\"",
      "    edges = []",
      "    if self.weighted:",
      "      for a in range(len(self.adj_list)):",
      "        for b, weight in self.adj_list[a]:",
      "          edges.append((a, b, weight))",
      "    else:",
      "      for a in range(len(self.adj_list)):",
      "        for b in self.adj_list[a]:",
      "          edges.append((a, b))",
      "    return edges",
      "  ",
      "  def get_rvs_list(self):",
      "    \"\"\"",
      "      有向グラフの向きを逆にした隣接リストを返す",
      "      無向グラフの場合は意味なし",
      "    \"\"\"",
      "    if not self.directed: return self.adj_list",
      "    rvs_list = [[] for _ in range(self.N + 1)]",
      "    if self.weighted:",
      "      for a in range(len(self.adj_list)):",
      "        for b, weight in self.adj_list[a]:",
      "          rvs_list[b].append((a, weight))",
      "    else:",
      "      for a in range(len(self.adj_list)):",
      "        for b in self.adj_list[a]:",
      "          rvs_list[b].append(a)",
      "    return rvs_list",
      "",
      "  def getDrectedGraphMinimum(self) -> \"Graph\":",
      "    \"\"\"",
      "    無向グラフから",
      "    出次数の最大値が√2M以下になるように有向グラフを作成する",
      "    自己ループは無視",
      "    \"\"\"",
      "    graph = Graph(self.N, True, self.weighted)",
      "    if self.weighted:",
      "      for frm in range(len(self.adj_list)):",
      "        for to, value in self.adj_list[frm]:",
      "          if frm >= to: continue",
      "          if len(self.adj_list[frm]) < len(self.adj_list[to]): graph.add_edge(frm, to, value)",
      "          else: graph.add_edge(to, frm, value)",
      "    else:",
      "      for frm in range(len(self.adj_list)):",
      "        for to in self.adj_list[frm]:",
      "          if frm >= to: continue",
      "          if len(self.adj_list[frm]) < len(self.adj_list[to]): graph.add_edge(frm, to)",
      "          else: graph.add_edge(to, frm)",
      "    return graph",
      "  ",
      "  def getDfsTreeNodes(self, root = 0):",
      "    \"\"\"",
      "    DFS木を構築する辺と後退辺に分解する",
      "    戻り値: [木辺のリスト, 後退辺のリスト]（各辺は [x, y] / 重みありは [x, y, w]）。多重辺は後退辺に含む、自己ループは含まない",
      "    \"\"\"",
      "    ans = [[], []]",
      "    find = [-2] * len(self.adj_list)",
      "    find[root] = -1",
      "    depth = [-1] * len(self.adj_list)",
      "    depth[root] = 0",
      "    used_par = [False] * len(self.adj_list) # 親へ戻る辺を1本だけ読み飛ばした（多重辺対策）",
      "    q = []",
      "    if len(self.adj_list[root]) != 0:  q.append([root, 0])",
      "    while q:",
      "      x, n = q.pop()",
      "      if len(self.adj_list[x]) != n + 1: q.append([x, n + 1])",
      "      if self.weighted:",
      "        y, w = self.adj_list[x][n]",
      "        data = [x, y, w]",
      "      else:",
      "        y = self.adj_list[x][n]",
      "        data = [x, y]",
      "      if find[y] == -2:",
      "        ans[0].append(data)",
      "        find[y] = x",
      "        depth[y] = depth[x] + 1",
      "        if len(self.adj_list[y]) != 0: q.append([y, 0])",
      "      elif find[x] == y and not used_par[x]:",
      "        used_par[x] = True # 木辺の逆向き。2本目以降の多重辺は後退辺として扱う",
      "      elif depth[y] < depth[x]:",
      "        ans[1].append(data)",
      "    return ans",
      "",
      "class BFS:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  \"\"\"",
      "  bfsしたいとき",
      "  \"\"\"",
      "  __slots__ = ['N', 'graph']",
      "  def __init__(self, graph : Graph):",
      "    self.N = graph.N + 1",
      "    self.graph = graph",
      "  def dist_list(self, start):",
      "    \"\"\"",
      "    startから各地点の距離 通れない箇所は-1",
      "    \"\"\"",
      "    return self.bfs(start)",
      "  def shortest_path(self, start, goal):",
      "    \"\"\"",
      "    startからgoalまでの最短pathの一つ。存在しない場合はNone",
      "    \"\"\"",
      "    T = self.shortest_tree(start)",
      "    if goal != start and T[goal] == -1: return None",
      "    data = [goal]",
      "    while data[-1] != start:",
      "      data.append(T[data[-1]])",
      "    return data[::-1]",
      "  def shortest_tree(self, start):",
      "    \"\"\"",
      "    startを始点とする最短路木(親リスト)",
      "    \"\"\"",
      "    return self._bfs_ext(start)",
      "  def dists_remove_edge(self, start, goal):",
      "    \"\"\"",
      "    各辺について、それを除いたときの最短路長。※無向・単純グラフ（多重辺・自己ループなし）限定",
      "    戻り値：最短経路（長さ-1が最短距離）, それらの各辺を削除したときの最短距離",
      "    最短路がそもそもない場合は空リストを返す",
      "    \"\"\"",
      "    data = self.shortest_path(start, goal) # s-tパスの一つを求める",
      "    if data == None: return [], [] # 最短路がそもそもないケース",
      "    Ds, LCAs = self._bfs_use(start, data) # startを始点とする最短路木(s-tパスは必ず使用する)",
      "    Dt, LCAt = self._bfs_use(goal, data[::-1]) # goalを始点とする最短路木(s-tパスは必ず使用する)",
      "    LR = []",
      "    for frm in range(len(self.graph.adj_list)):",
      "      for to in self.graph.adj_list[frm]:",
      "        if LCAs[frm] == frm and LCAs[to] == to: continue # s-tパス上の辺はSKIP",
      "        u, v = frm, to",
      "        x = Ds[LCAs[u]]",
      "        y = Ds[LCAs[v]]",
      "        if x >= y: continue",
      "        y = Ds[LCAt[v]]",
      "        d = Ds[u] + 1 + Dt[v]",
      "        if x >= y: continue",
      "        LR.append([x, d])",
      "        LR.append([y, -d])",
      "    LR.sort()",
      "    heap = []",
      "    cnts = {}",
      "    def add(v):",
      "      cnts[v] = cnts.get(v, 0) + 1",
      "      heapq.heappush(heap, v)",
      "    def discard(v):",
      "      c = cnts.get(v, 0)",
      "      if c <= 1: cnts.pop(v, None)",
      "      else: cnts[v] = c - 1",
      "    def top():",
      "      while heap and heap[0] not in cnts:",
      "        heapq.heappop(heap)",
      "      return heap[0] if heap else -1",
      "    n = 0",
      "    ans = []",
      "    for i in range(len(data) - 1):",
      "      while n < len(LR):",
      "        x, d = LR[n]",
      "        if x <= i:",
      "          if d > 0: add(d)",
      "          else: discard(-d)",
      "          n += 1",
      "        else:",
      "          break",
      "      ans.append(top())",
      "    return data, ans",
      "  def shortest_path_graph(self, start, goal):",
      "    \"\"\"",
      "    startからgoalまでの最短距離に使用するパスのみのグラフを作る（有向/無向は入力に合わせる）",
      "    goalに到達不能なら辺なしのグラフを返す",
      "    \"\"\"",
      "    way_there = self.bfs(start)",
      "    way_back = self._bfs_on(goal, self.graph.get_rvs_list()) # 有向なら逆グラフで",
      "    way_length = way_there[goal]",
      "    gf = Graph(self.N - 1, self.graph.directed)",
      "    if way_length == -1: return gf",
      "    for frm in range(len(self.graph.adj_list)):",
      "      a = way_there[frm]",
      "      if a == -1: continue",
      "      for to in self.graph.adj_list[frm]:",
      "        b = way_back[to]",
      "        if b == -1: continue",
      "        if a + b + 1 == way_length: gf.add_edge(frm, to)",
      "    return gf",
      "  def dirmeter(self):",
      "      \"\"\"",
      "      直径を求める",
      "      return: 直径の長さ、端点A、端点B",
      "      \"\"\"",
      "      if self.N == 1: return 0, -1, -1",
      "      D = self.bfs(1)",
      "      ma = max(D)",
      "      a = D.index(ma)",
      "      D2 = self.bfs(a)",
      "      dir = max(D2)",
      "      b = D2.index(dir)",
      "      return dir, a, b",
      "  def bfs2Goal(self, start, goal):",
      "    \"\"\"",
      "    startからgoalまでの距離 通れない場合は-1",
      "    \"\"\"",
      "    ans = self.bfs(start)",
      "    return ans[goal]",
      "  def bfs01(self, start):",
      "    \"\"\"",
      "    startから各頂点への最短距離。辺重みは0/1限定。",
      "    \"\"\"",
      "    INF = 10 ** 30",
      "    D = [INF] * self.N",
      "    D[start] = 0",
      "    q = deque([start])",
      "    while q:",
      "      x = q.popleft()",
      "      dx = D[x]",
      "      for y, w in self.graph.adj_list[x]:",
      "        nd = dx + w",
      "        if nd >= D[y]: continue",
      "        D[y] = nd",
      "        if w == 0: q.appendleft(y)",
      "        else: q.append(y)",
      "    return [-1 if d == INF else d for d in D]",
      "  def bfs(self, start):",
      "    \"\"\"",
      "    startから各地点までの距離 通れない場合は-1",
      "    \"\"\"",
      "    return self._bfs_on(start, self.graph.adj_list)",
      "  def _bfs_on(self, start, adj):",
      "    D = [-1] * self.N",
      "    data = [start]",
      "    cnt = 0",
      "    D[start] = cnt",
      "    while data:",
      "      tl = []",
      "      for x in data:",
      "        for y in adj[x]:",
      "          if D[y] != -1: continue",
      "          D[y] = cnt + 1",
      "          tl.append(y)",
      "      cnt += 1",
      "      data = tl",
      "    return D",
      "  def _bfs_ext(self, start):",
      "    \"\"\"",
      "    startを始点とする最短路木(親リスト)",
      "    \"\"\"",
      "    parent = [-1] * self.N",
      "    D = [-1] * self.N",
      "    data = [start]",
      "    cnt = 0",
      "    D[start] = cnt",
      "    while data:",
      "      tl = []",
      "      for x in data:",
      "        for y in self.graph.adj_list[x]:",
      "          if D[y] != -1: continue",
      "          D[y] = cnt + 1",
      "          tl.append(y)",
      "          parent[y] = x",
      "      cnt += 1",
      "      data = tl",
      "    return parent",
      "  def _bfs_use(self, start, eg):",
      "    \"\"\"",
      "    s-tパスを必ず使用する場合の最短路木(距離リスト、LCAリスト)",
      "    \"\"\"",
      "    parent = [-1] * self.N",
      "    D = [-1] * self.N",
      "    data = [start]",
      "    cnt = 0",
      "    D[start] = cnt",
      "    for i in range(len(eg)):",
      "      a, b = eg[i - 1], eg[i]",
      "      D[b] = D[a] + 1",
      "      parent[a] = a",
      "    parent[eg[-1]] = eg[-1]",
      "    while data:",
      "      tl = []",
      "      for x in data:",
      "        for y in self.graph.adj_list[x]:",
      "          if D[y] != -1: continue",
      "          D[y] = cnt + 1",
      "          tl.append(y)",
      "          parent[y] = parent[x]",
      "      cnt += 1",
      "      if len(eg) > cnt: tl.append(eg[cnt])",
      "      data = tl",
      "    return D, parent",
      "",
      "# usage",
      "# g = Graph(N, weighted=True)",
      "# g.add_edge(a, b, w_0_or_1)",
      "# d = BFS(g).bfs01(s)"
    ]
  },
  "dag": {
    "scope": "python",
    "prefix": "dag",
    "description": "DAG (トポロジカル順序 + DP の土台)",
    "body": [
      "import sys",
      "from collections import deque",
      "sys.setrecursionlimit(10000000)",
      "class DAG:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  def __init__(self, N, AdjacencyList, ReverseList, inputCount):",
      "    self.N = N",
      "    self.AdjacencyList = AdjacencyList",
      "    self.ReverseList = ReverseList",
      "    self.inputCount = inputCount",
      "  @staticmethod",
      "  def makeDag(gf : GraphData):",
      "    \"\"\"有向グラフからDAGを構築\"\"\"",
      "    return DAG(gf.N, gf.adj_list, gf.rev_list, gf.inputCount)",
      "  def toposo(self, C = 1):",
      "    \"\"\"",
      "      トポロジカルソートした結果を最大C個返す（各結果は頂点番号のリスト）",
      "      閉路がある場合、閉路上およびその先の頂点は含まれず、長さN未満のリストになる",
      "      （len(結果[0]) < N で閉路の有無を判定できる）",
      "    \"\"\"",
      "    self.ip = self.inputCount[:]",
      "    self._to = [[e[0] if type(e) is tuple else e for e in x] for x in self.AdjacencyList] # 重みありも可",
      "    self.deq = deque()",
      "    for i, x in enumerate(self.ip):",
      "      if x == 0: self.deq.appendleft(i)",
      "    ans = self._toposo_dfs(C)",
      "    ret = []",
      "    for d in ans:",
      "      ret.append(d[::-1])",
      "    return ret",
      "  def _toposo_dfs(self, C):",
      "    if not self.deq: return [[]]",
      "    ans = []",
      "    sz = len(self.deq)",
      "    for i in range(sz):",
      "      d = self.deq.pop()",
      "      for t in self._to[d]:",
      "        self.ip[t] -= 1",
      "        if self.ip[t] == 0: self.deq.append(t)",
      "      ret = self._toposo_dfs(C)",
      "      for t in self._to[d]:",
      "        if self.ip[t] == 0: self.deq.pop()",
      "        self.ip[t] += 1",
      "      for x in ret:",
      "        x.append(d)",
      "        ans.append(x)",
      "        if len(ans) == C:",
      "          self.deq.append(d)",
      "          # for _ in range(i):",
      "          #   self.deq.add_r(self.deq.pop_l())",
      "          return ans",
      "      self.deq.appendleft(d)",
      "    # for _ in range(i - 1):",
      "    #   self.deq.add_r(self.deq.pop_l())",
      "    return ans",
      "",
      "  # グラフ内の三角形数え上げ(O(M√出次数の最大値))",
      "  # 無向グラフを getDrectedGraphMinimum() で向き付けしてから makeDag したものに使う",
      "  # (i, j, k) を yield する（辺 i→j, j→k, i→k）。重みあり/なしどちらの隣接リストでも可",
      "  def enumerateTriangles(self):# -> Generator[tuple[int, Any, Any], Any, None]:",
      "    to = [[e[0] if type(e) is tuple else e for e in x] for x in self.AdjacencyList]",
      "    Data = [-1] * (len(to) + 1)",
      "    for i, x in enumerate(to):",
      "      for j in x: Data[j] = i",
      "      for j in x:",
      "        for k in to[j]:",
      "          if Data[k] == i: yield (i, j, k)",
      "  ",
      "",
      "# usage",
      "# dag = DAG.makeDag(gf)",
      "# order = dag.toposo()"
    ]
  },
  "matching": {
    "scope": "python",
    "prefix": "matching",
    "description": "最大二部マッチング (atcoder.maxflow 経由)",
    "body": [
      "from atcoder.maxflow import MFGraph",
      "",
      "class Matching:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # Matching(N, weight=1, R=None): 左側 N 頂点(0..N-1)、右側 R 頂点(0..R-1、省略時は N)",
      "  #   weight: 各頂点が使える回数（s→左, 右→t の容量）",
      "  # add_edge(a, b, weight=1): 左側の頂点 a と右側の頂点 b を辺で結ぶ",
      "  # flow(M=None): 最大マッチング数(または最大 M まで)を返す",
      "  # list_matching(L): 隣接リストから最大マッチングする Matching を作る (static)",
      "  def __init__(self, N, weight = 1, R = None):",
      "    if R == None: R = N",
      "    self.N = N",
      "    self.R = R",
      "    s = N + R",
      "    t = N + R + 1",
      "    self.g = MFGraph(N + R + 2)",
      "    for i in range(N):",
      "      self.g.add_edge(s, i, weight)",
      "    for i in range(R):",
      "      self.g.add_edge(N + i, t, weight)",
      "  def add_edge(self, a, b, weight = 1):",
      "    self.g.add_edge(a, self.N + b, weight)",
      "  def flow(self, M = None):",
      "    s = self.N + self.R",
      "    t = self.N + self.R + 1",
      "    return self.g.flow(s, t, M)",
      "",
      "  @staticmethod",
      "  def list_matching(L : list[list[int]]):",
      "    \"\"\"",
      "    隣接リストを入力とした最大マッチング（L[i] = 左側 i と結ぶ右側の頂点リスト）",
      "    右側の頂点数は max(左側の数, 右側の最大番号 + 1)",
      "    \"\"\"",
      "    N = len(L)",
      "    mcg = Matching(N, 1, max([N] + [j + 1 for x in L for j in x]))",
      "    for i in range(N):",
      "      for j in L[i]: mcg.add_edge(i, j, 1)",
      "    return mcg",
      "",
      "# usage",
      "# m = Matching(N)",
      "# m.add_edge(l, r)",
      "# n = m.flow()"
    ]
  },
  "particalgraph": {
    "scope": "python",
    "prefix": "particalgraph",
    "description": "部分グラフ ParticalGraph (元グラフからエッジ集合で誘導)",
    "body": [
      "class ParticalGraph:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  __slots__ = ['N', 'adj_list']",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.adj_list = [[] for _ in range(N)]",
      "",
      "  def add_edge(self, a: int, b: int):",
      "    \"\"\"",
      "    辺を追加",
      "    \"\"\"",
      "    self.adj_list[a].append(b)",
      "    self.adj_list[b].append(a)",
      "",
      "  def add_edges(self, edges: list):",
      "    \"\"\"",
      "    辺リストの追加。",
      "    (a, b) の形で指定する。",
      "    \"\"\"",
      "    for edge in edges:",
      "      a, b = edge",
      "      self.add_edge(a, b)",
      "",
      "  def partical_number_list(self):",
      "    \"\"\"",
      "    各Sについて、",
      "    Sを頂点集合とする部分グラフの個数",
      "    O(M*2^N)",
      "    \"\"\"",
      "    g = [0] * (1 << self.N)",
      "    for i in range(1 << self.N):",
      "      g[i] = self.partical_number(i)",
      "    return g",
      "",
      "  def partical_number(self, S):",
      "    \"\"\"",
      "    Sを頂点集合とする部分グラフの個数",
      "    Sは使用する頂点を1として二進数で表す",
      "    O(M)",
      "    \"\"\"",
      "    if S == 0: return 1",
      "    e = self._contain_edges_number(S)",
      "    return 1 << e",
      "    ",
      "  def connection_partical_number_list(self, g):",
      "    \"\"\"",
      "    各Sについて、",
      "    Sを頂点集合とする連結部分グラフの個数",
      "    O(3^N)",
      "    \"\"\"",
      "    f = [0] * (1 << self.N)",
      "    f[0] = 1",
      "    for i in range(1, self.N + 1):",
      "      n = (1 << i) - 1",
      "      while n < (1 << self.N):",
      "        f[n] = g[n]",
      "        v = -n & n",
      "        m = n ^ v",
      "        while m != 0:",
      "          f[n] -= f[n ^ m] * g[m]",
      "          m = (m - 1) & (n ^ v)",
      "        x = n & -n",
      "        y = n + x",
      "        n = ((n & ~y) >> x.bit_length()) | y",
      "    return f",
      "  ",
      "  def reachable_number_list(self, i):",
      "    \"\"\"",
      "    各頂点jについて、頂点iと連結である部分グラフの個数",
      "    O(N*2^N)",
      "    \"\"\"",
      "    g = self.partical_number_list()",
      "    f = self.connection_partical_number_list(g)",
      "    ans = [0] * self.N",
      "    for k in range(1 << self.N):",
      "      if not ParticalGraph._is_contains_bit(i, k): continue",
      "      x = self.entire_area_number(k, f, g)",
      "      n = k",
      "      while n:",
      "        lowest = n & -n",
      "        index = lowest.bit_length() - 1",
      "        ans[index] += x",
      "        n &= n - 1",
      "    return ans",
      "",
      "  def entire_area_number(self, S, f, g):",
      "    \"\"\"",
      "    Sが連結である全域部分グラフの個数",
      "    Sは使用する頂点を1として二進数で表す",
      "    \"\"\"",
      "    v = (1 << self.N) - 1",
      "    ans = f[S] * g[v ^ S]",
      "    return ans",
      "",
      "  def _contain_edges_number(self, S):",
      "    \"\"\"",
      "    Sに含まれる辺の数",
      "    Sは使用する頂点を1として二進数で表す",
      "    \"\"\"",
      "    ans = 0",
      "    for i in range(self.N):",
      "      if not ParticalGraph._is_contains_bit(i, S): continue",
      "      for j in self.adj_list[i]:",
      "        if ParticalGraph._is_contains_bit(j, S): ans += 1",
      "    return ans // 2",
      "  ",
      "  @ staticmethod",
      "  def _is_contains_bit(n, S):",
      "    return S & (1 << n)",
      "",
      "# usage",
      "# pg = ParticalGraph(N)",
      "# pg.add_edges(edge_subset)"
    ]
  },
  "twosat": {
    "prefix": "twosat",
    "body": [
      "# 2-SAT",
      "# scc スニペットの強連結成分分解 (scc_graph._ids) を利用する",
      "class two_sat:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # add_clause(i, f, j, g): 節 (x_i == f) or (x_j == g) を追加する",
      "  # satisfiable(): 全ての節を満たす割り当てが存在するか判定する O(n + m)",
      "  # answer(): satisfiable() が True のときの割り当て (x_0, ..., x_{n-1}) を返す",
      "  def __init__(self, n):",
      "    \"\"\"",
      "    n: 変数の個数",
      "    内部では変数 i について 2*i が x_i == False、2*i+1 が x_i == True を表す",
      "    \"\"\"",
      "    self._n = n",
      "    self._answer = [False] * n",
      "    self._adj = [[] for _ in range(2 * n)]",
      "",
      "  def add_clause(self, i, f, j, g):",
      "    \"\"\"",
      "    節 (x_i == f) or (x_j == g) を追加する",
      "    i, j: 変数の番号 (0-indexed)",
      "    f, g: それぞれの変数に要求する値 (True / False)",
      "    \"\"\"",
      "    self._adj[2 * i + (not f)].append(2 * j + g)",
      "    self._adj[2 * j + (not g)].append(2 * i + f)",
      "",
      "  def satisfiable(self):",
      "    \"\"\"",
      "    全ての節を同時に満たす割り当てが存在するか判定する O(n + m)",
      "    True のとき answer() で割り当てを取得できる",
      "    \"\"\"",
      "    _, ids = scc_graph._ids(2 * self._n, self._adj)",
      "    for i in range(self._n):",
      "      if ids[2 * i] == ids[2 * i + 1]: return False",
