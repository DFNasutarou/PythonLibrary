  "grid": {
    "prefix": "grid",
    "body": [
      "class gridMan:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # makeWall(x=-2): 四方を壁で囲む (範囲外アクセスを防ぐ)",
      "  # dist(S): S=(行, 列) から上下左右に進んで何手かかるかのリスト（到達不能は-1）と最大値を返す",
      "  #   makeWall の有無に関わらず元のグリッドの座標(0-indexed)で指定・返却する",
      "  def __init__(self, L):",
      "    # '#' は壁(-2)、それ以外の文字は通行可(0)。数値はそのまま（負なら壁）",
      "    L = [[c if type(c) is int else (-2 if c == '#' else 0) for c in row] for row in L]",
      "    self.L = L",
      "    self._off = 0 # makeWall した回数（self.L の添字のずれ）",
      "    self.H = len(self.L)",
      "    self.W = len(self.L[0])",
      "  def makeWall(self, x = -2):",
      "    w = len(self.L[0]) + 2",
      "    self.L = [[x] * w] + [[x] + i + [x] for i in self.L] + [[x] * w]",
      "    self._off += 1",
      "  def dist(self, S): #Sから上下左右に進んで何手かかるかのリスト　および　最大値",
      "    T = [[-1] * self.W for _ in range(self.H)]",
      "    List = [[S[0], S[1]]]",
      "    T[S[0]][S[1]] = 0",
      "    k = 0",
      "    while List != []:",
      "      newList = []",
      "      for h, w in List:",
      "        k = T[h][w]",
      "        for x, y in [[h - 1, w], [h + 1, w], [h, w - 1], [h, w + 1]]:",
      "          if not (0 <= x < self.H): continue",
      "          if not (0 <= y < self.W): continue",
      "          if self.L[x + self._off][y + self._off] >= 0 and T[x][y] == -1:",
      "            newList.append([x, y])",
      "            T[x][y] = k + 1",
      "      List = newList",
      "    return T, k",
      "  ",
      "",
      "# usage",
      "# g = gridMan(L)",
      "# g.makeWall()",
      "# D, mx = g.dist((sr, sc))"
    ],
