      "    for x in ids: counts[x] += 1",
      "    groups = [[] for _ in range(group_num)]",
      "    for i in range(N):",
      "      groups[ids[i]].append(i)",
      "    return groups",
      "",
      "# usage: groups = scc_graph.scc(g); n_components = len(groups)"
    ],
