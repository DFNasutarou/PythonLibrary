    "body": [
      "class TreePath:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # 木のパス・部分木クエリ（HLD + セグ木）。tree スニペットの Tree と seg スニペットの segtree が必要",
      "  #   TreePath(tr, val, op, e, edge=False, commutative=True)",
      "  #     val[v]: 頂点 v の値。edge=True なら辺 (par[v], v) の値を v に置く（根の値は無視）",
      "  #     commutative=False なら向きを考慮する（逆向きのセグ木も持つ）",
      "  #   set(v, x): 頂点 v（edge=True なら辺 (par[v], v)）の値を x にする O(log N)",
      "  #   get(v): 頂点 v の値 O(1)",
      "  #   path(u, v): u→v パス上の値を u 側から順に op した結果 O(log^2 N)",
      "  #   subtree(v): v の部分木の総積（edge=True なら部分木内の辺のみ）O(log N)",
      "  def __init__(self, tr, val, op, e, edge=False, commutative=True):",
      "    self.tr = tr; self.op = op; self.e = e; self.edge = edge",
      "    n = self.n = tr.N",
      "    a = [e()] * n",
      "    for v in range(n): a[tr.pos[v]] = val[v]",
      "    if edge: a[tr.pos[tr.root]] = e()",
      "    self.a = a",
      "    self.seg = segtree(a, op, e)",
      "    self.rseg = None if commutative else segtree(a[::-1], op, e)",
      "  def set(self, v, x):",
      "    p = self.tr.pos[v]",
      "    self.a[p] = x",
      "    self.seg.set(p, x)",
      "    if self.rseg is not None: self.rseg.set(self.n - 1 - p, x)",
      "  def get(self, v):",
      "    return self.a[self.tr.pos[v]]",
      "  def path(self, u, v):",
      "    x = self.e(); n = self.n",
      "    for l, r, rev in self.tr.path_ranges(u, v, self.edge):",
      "      if rev and self.rseg is not None: x = self.op(x, self.rseg.prod(n - r, n - l))",
      "      else: x = self.op(x, self.seg.prod(l, r))",
      "    return x",
      "  def subtree(self, v):",
      "    l, r = self.tr.subtree(v)",
      "    return self.seg.prod(l + self.edge, r)",
      "",
      "# usage",
      "# tr = Tree(N, edges)",
      "# tp = TreePath(tr, A, lambda a, b: a + b, lambda: 0)  # 頂点 v の値 A[v]、パス和",
      "# tp.set(v, x)",
      "# s = tp.path(u, v)",
      "# s = tp.subtree(v)",
      "# B = [0] * N",
      "# for u, v, w in wedges: B[tr.edge_vertex(u, v)] = w   # 辺の値は子側の頂点に置く",
      "# te = TreePath(tr, B, max, lambda: -10**18, edge=True)  # パス上の辺の最大値",
      "# m = te.path(u, v)"
    ],
    "description": "木のパス・部分木クエリ TreePath (HLD + セグ木、頂点/辺の値、非可換対応、tree と seg スニペットが必要、O(log^2 N))",
    "scope": "python"
