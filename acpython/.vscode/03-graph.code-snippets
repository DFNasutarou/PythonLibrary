  "dijkstra": {
    "prefix": "dijkstra",
    "body": [
      "class Graph:",
      "  __slots__ = ['N', 'directed', 'weighted', 'adj_list']",
      "  ",
      "  def __init__(self, N: int, directed: bool = False, weighted: bool = False):",
      "    self.N = N",
      "    self.directed = directed",
      "    self.weighted = weighted",
      "    self.adj_list = [[] for _ in range(N + 1)]",
      "  ",
      "  def add_edge(self, a: int, b: int, weight: int = 1):",
      "    \"\"\"",
      "    辺を追加",
      "    \"\"\"",
      "    if self.weighted:",
      "      self.adj_list[a].append((b, weight))",
      "      if not self.directed:",
      "        self.adj_list[b].append((a, weight))",
      "    else:",
      "      self.adj_list[a].append(b)",
      "      if not self.directed:",
      "        self.adj_list[b].append(a)",
      "  ",
      "  def add_edges(self, edges: list):",
      "    \"\"\"",
      "    辺リストの追加。",
      "    重みありの場合は (a, b, weight)、なしの場合は (a, b) の形で指定する。",
      "    \"\"\"",
      "    if self.weighted:",
      "      for edge in edges:",
      "        a, b, weight = edge",
      "        self.add_edge(a, b, weight)",
      "    else:",
      "      for edge in edges:",
      "        a, b = edge",
      "        self.add_edge(a, b)",
      "  ",
      "  def get_edges(self) -> list:",
      "    \"\"\"",
      "    全ての辺をリストで返す。",
      "    \"\"\"",
      "    edges = []",
      "    if self.weighted:",
      "      for a in range(len(self.adj_list)):",
      "        for b, weight in self.adj_list[a]:",
      "          edges.append((a, b, weight))",
      "    else:",
      "      for a in range(len(self.adj_list)):",
      "        for b in self.adj_list[a]:",
      "          edges.append((a, b))",
      "    return edges",
      "  ",
      "  def get_rvs_list(self):",
      "    \"\"\"",
      "      有向グラフの向きを逆にした隣接リストを返す",
      "      無向グラフの場合は意味なし",
      "    \"\"\"",
      "    if not self.directed: return self.adj_list",
      "    rvs_list = [[] for _ in range(self.N + 1)]",
      "    if self.weighted:",
      "      for a in range(len(self.adj_list)):",
      "        for b, weight in self.adj_list[a]:",
      "          rvs_list[b].append((a, weight))",
      "    else:",
      "      for a in range(len(self.adj_list)):",
      "        for b in self.adj_list[a]:",
      "          rvs_list[b].append(a)",
      "    return rvs_list",
      "",
      "  def getDrectedGraphMinimum(self) -> \"Graph\":",
      "    \"\"\"",
      "    無向グラフから",
      "    出次数の最大値が√2M以下になるように有向グラフを作成する",
      "    自己ループは無視",
      "    \"\"\"",
      "    graph = Graph(self.N, True, self.weighted)",
      "    if self.weighted:",
      "      for frm in range(len(self.adj_list)):",
      "        for to, value in self.adj_list[frm]:",
      "          if frm >= to: continue",
      "          if len(self.adj_list[frm]) < len(self.adj_list[to]): graph.add_edge(frm, to, value)",
      "          else: graph.add_edge(to, frm, value)",
      "    else:",
      "      for frm in range(len(self.adj_list)):",
      "        for to in self.adj_list[frm]:",
      "          if frm >= to: continue",
      "          if len(self.adj_list[frm]) < len(self.adj_list[to]): graph.add_edge(frm, to)",
      "          else: graph.add_edge(to, frm)",
      "    return graph",
      "  ",
      "  def getDfsTreeNodes(self, root = 0):",
      "    \"\"\"",
      "    DFS木を構築するノードと後退辺であるノードに分解する",
      "    \"\"\"",
      "    ans = [[], []]",
      "    find = [-2] * self.N",
      "    find[root] = -1",
      "    depth = [-1] * self.N",
      "    depth[root] = 0",
      "    q = []",
      "    if len(self.adj_list[root]) != 0:  q.append([root, 0])",
      "    while q:",
      "      x, n = q.pop()",
      "      if len(self.adj_list[x]) != n + 1: q.append([x, n + 1])",
      "      if self.weighted:",
      "        w, y = self.adj_list[x][n]",
      "        data = [x, y, w]",
      "      else:",
      "        y = self.adj_list[x][n]",
      "        data = [x, y]",
      "      if find[y] == -2:",
      "        ans[0].append(data)",
      "        find[y] = x",
      "        depth[y] = depth[x] + 1",
      "        if len(self.adj_list[y]) != 0: q.append([y, 0])",
      "      elif find[x] != y and depth[y] < depth[x]:",
      "        ans[1].append(data)",
      "    return ans",
      "",
      "import heapq",
      "pop = heapq.heappop",
      "push = heapq.heappush",
      "",
      "class Dijkstra:",
      "  \"\"\"",
      "  辺に重みがない場合は01bfsを使え!",
      "  \"\"\"",
      "  __slots__ = ['graph']",
      "  def __init__(self, graph : Graph):",
      "    self.graph = graph",
      "  ",
      "  def dist(self, start, L = None):",
      "    \"\"\"",
      "    startから各地点までの最短距離を返す",
      "    \"\"\"",
      "    N = self.graph.N",
      "    if L == None: L = self.graph.adj_list",
      "    D = [-1] * (N + 1) # その頂点までの距離",
      "    q  = []",
      "    push(q, (0, start))",
      "    while q:",
      "      d, x = pop(q)",
      "      if D[x] != -1:",
      "        continue",
      "      D[x] = d",
      "      for i, j in L[x]:",
      "        if D[i] != -1:",
      "          continue",
      "        push(q, (d + j, i))",
      "    return D",
      "  ",
      "  def dist_need_path(self, start, L):",
      "    \"\"\"",
      "    startから各地点までの最短距離を返す",
      "    その最短距離の経路数も合わせて返す",
      "    \"\"\"",
      "    N = self.graph.N",
      "    if L == None: L = self.graph.adj_list",
      "    D = [-1] * (N + 1) # その頂点までの距離",
      "    path_count_data = [0] * (N + 1) # その頂点までの経路数",
      "    path_count_data[start] = 1",
      "    q  = []",
      "    push(q, (0, start, -1))",
      "    while q:",
      "      d, x, t = pop(q)",
      "      if D[x] != -1:",
      "        if D[x] == d : path_count_data[x] += path_count_data[t]",
      "        continue",
      "      if t != -1: path_count_data[x] += path_count_data[t]",
      "      D[x] = d",
      "      for j, i in L[x]:",
      "        if D[i] != -1:",
      "          if D[i] == d + j: path_count_data[i] += path_count_data[x]",
      "          continue",
      "        push(q, (d + j, i, x))",
      "    return D, path_count_data",
      "",
      "  def get_bridge(self, start, goal, nodes):",
      "    \"\"\"",
      "    橋となっているノードの番号を返す",
      "    \"\"\"",
      "    way_there, path_count_there = self.dist_need_path(start, self.graph.adj_list)",
      "    way_back, path_count_back = self.dist_need_path(goal, self.graph.get_rvs_list())",
      "    way_length = way_there[goal]",
      "    path_count = path_count_there[goal]",
      "    N = len(nodes)",
      "    ans = [0] * N",
      "    for i, (x, y, value) in enumerate(nodes):",
      "      for frm, to in [[x, y], [y, x]]:",
      "        a = way_there[frm]",
      "        n = path_count_there[frm]",
      "        b = way_back[to]",
      "        m = path_count_back[to]",
      "        if a + b + value == way_length and n * m == path_count: ans[i] = 1",
      "    return ans",
      "  ",
      "  def get_shortest_path_graph(self, start, goal):",
      "    \"\"\"",
      "    最短ルートのみ残したグラフを返す",
      "    \"\"\"",
      "    way_there = self.dist(start, self.graph.adj_list)",
      "    way_back = self.dist(goal, self.graph.get_rvs_list())",
      "    way_length = way_there[goal]",
      "    gf = Graph(self.graph.N, self.graph.directed, True)",
      "    for frm in range(len(self.graph.adj_list)):",
      "      a = way_there[frm]",
      "      for to, value in self.graph.adj_list[frm]:",
      "        b = way_back[to]",
      "        if a + b + value == way_length: gf.add_edge(frm, to, value)",
      "    return gf",
      "",
      "# usage: g = Graph(N, directed=True, weighted=True); g.add_edge(a,b,w); d = g.dijkstra(s)"
    ],
    "description": "ダイクストラ法 (重み付きグラフの単一始点最短距離 O((N+M) log N))",
    "scope": "python"
