    "description": "最大二部マッチング (atcoder.maxflow 経由)",
    "body": [
      "from atcoder.maxflow import MFGraph",
      "",
      "class Matching:",
      "  def __init__(self, N, weight = 1):",
      "    self.N = N",
      "    M = 2 * N + 2",
      "    s = 2 * N",
      "    t = 2 * N + 1",
      "    self.g = MFGraph(M)",
      "    for i in range(N):",
      "      self.g.add_edge(s, i, weight)",
      "      self.g.add_edge(N + i, t, weight)",
      "  def add_edge(self, a, b, weight = 1):",
      "    self.g.add_edge(a, self.N + b, weight)",
      "  def flow(self, M = None):",
      "    s = 2 * self.N",
      "    t = 2 * self.N + 1",
      "    return self.g.flow(s, t, M)",
      "",
      "  @staticmethod",
      "  def list_matching(L : list[list[int]]):",
      "    \"\"\"",
      "    隣接リストを入力とした最大マッチング",
      "    \"\"\"",
      "    N = len(L)",
      "    mcg = Matching(N)",
      "    for i in range(N):",
      "      for j in L[i]: mcg.add_edge(i, j, 1)",
      "    return mcg",
      "",
      "# usage: m = Matching(L, R); m.add_edge(l, r); n = m.solve()"
    ]
  },
  "particalgraph": {
    "scope": "python",
    "prefix": "particalgraph",
    "description": "部分グラフ ParticalGraph (元グラフからエッジ集合で誘導)",
    "body": [
      "class ParticalGraph:",
      "  __slots__ = ['N', 'adj_list']",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.adj_list = [[] for _ in range(N)]",
      "",
      "  def add_edge(self, a: int, b: int):",
      "    \"\"\"",
      "    辺を追加",
      "    \"\"\"",
      "    self.adj_list[a].append(b)",
      "    self.adj_list[b].append(a)",
      "",
      "  def add_edges(self, edges: list):",
      "    \"\"\"",
      "    辺リストの追加。",
      "    (a, b) の形で指定する。",
      "    \"\"\"",
      "    for edge in edges:",
      "      a, b = edge",
      "      self.add_edge(a, b)",
      "",
      "  def partical_number_list(self):",
      "    \"\"\"",
      "    各Sについて、",
      "    Sを頂点集合とする部分グラフの個数",
      "    O(M*2^N)",
      "    \"\"\"",
      "    g = [0] * (1 << self.N)",
      "    for i in range(1 << self.N):",
      "      g[i] = self.partical_number(i)",
      "    return g",
      "",
      "  def partical_number(self, S):",
      "    \"\"\"",
      "    Sを頂点集合とする部分グラフの個数",
      "    Sは使用する頂点を1として二進数で表す",
      "    O(M)",
      "    \"\"\"",
      "    if S == 0: return 1",
      "    e = self._contain_edges_number(S)",
      "    return 1 << e",
      "    ",
      "  def connection_partical_number_list(self, g):",
      "    \"\"\"",
      "    各Sについて、",
      "    Sを頂点集合とする連結部分グラフの個数",
      "    O(3^N)",
      "    \"\"\"",
      "    f = [0] * (1 << self.N)",
      "    f[0] = 1",
      "    for i in range(1, self.N + 1):",
      "      n = (1 << i) - 1",
      "      while n < (1 << self.N):",
      "        f[n] = g[n]",
      "        v = -n & n",
      "        m = n ^ v",
      "        while m != 0:",
      "          f[n] -= f[n ^ m] * g[m]",
      "          m = (m - 1) & (n ^ v)",
      "        x = n & -n",
      "        y = n + x",
      "        n = ((n & ~y) >> x.bit_length()) | y",
      "    return f",
      "  ",
      "  def reachable_number_list(self, i):",
      "    \"\"\"",
      "    各頂点jについて、頂点iと連結である部分グラフの個数",
      "    O(N*2^N)",
      "    \"\"\"",
      "    g = self.partical_number_list()",
      "    f = self.connection_partical_number_list(g)",
      "    ans = [0] * self.N",
      "    for k in range(1 << self.N):",
      "      if not ParticalGraph._is_contains_bit(i, k): continue",
      "      x = self.entire_area_number(k, f, g)",
      "      n = k",
      "      while n:",
      "        lowest = n & -n",
      "        index = lowest.bit_length() - 1",
      "        ans[index] += x",
      "        n &= n - 1",
      "    return ans",
      "",
      "  def entire_area_number(self, S, f, g):",
      "    \"\"\"",
      "    Sが連結である全域部分グラフの個数",
      "    Sは使用する頂点を1として二進数で表す",
      "    \"\"\"",
      "    v = (1 << self.N) - 1",
      "    ans = f[S] * g[v ^ S]",
      "    return ans",
      "",
      "  def _contain_edges_number(self, S):",
      "    \"\"\"",
      "    Sに含まれる辺の数",
      "    Sは使用する頂点を1として二進数で表す",
      "    \"\"\"",
      "    ans = 0",
      "    for i in range(self.N):",
      "      if not ParticalGraph._is_contains_bit(i, S): continue",
      "      for j in self.adj_list[i]:",
      "        if ParticalGraph._is_contains_bit(j, S): ans += 1",
      "    return ans // 2",
      "  ",
      "  @ staticmethod",
      "  def _is_contains_bit(n, S):",
      "    return S & (1 << n)",
      "",
      "# usage: pg = ParticalGraph(N); pg.add_edges(edge_subset)"
    ]
  },
  "twosat": {
    "prefix": "twosat",
    "body": [
      "import sys",
      "sys.setrecursionlimit(1000000)",
      "",
      "# 2-SAT",
      "class two_sat:",
      "  def __init__(s):",
      "    s._n = 0",
      "    s.scc = scc_graph(0)",
      "  def __init__(s, n):",
      "    s._n = n",
      "    s._answer = [False] * n",
      "    s.scc = scc_graph(2 * n)",
      "",
      "  # クローズを足す",
      "  def add_clause(s, i, f, j, g):",
      "    s.scc.add_edge(2 * i + (not f), 2 * j + (g))",
      "    s.scc.add_edge(2 * j + (not g), 2 * i + (f))",
      "  ",
      "  # 判定",
      "  # O(n + m)",
      "  def satisfiable(s):",
      "    id = s.scc.scc_ids()[1]",
      "    for i in range(s._n):",
      "      if id[2 * i] == id[2 * i + 1]: return False",
      "      s._answer[i] = id[2 * i] < id[2 * i + 1]",
      "    return True",
      "",
      "  # クローズを満たす割当を返す",
      "  # satisfiableがTrueとなった後に呼ばないと意味ない",
      "  # O(1）",
      "  def answer(s): return s._answer",
      "",
      "class scc_graph:",
      "  # n 頂点数",
      "  def __init__(s, n): ",
      "    s._n = n",
      "    s.g = {}",
      "  def num_vertices(s): return s._n",
      "  # 辺を追加 frm 矢元 to 矢先",
      "  # O(1)",
      "  def add_edge(s, frm, to): ",
      "    if frm in s.g: s.g[frm].append(to)",
      "    else: s.g[frm] = [to]",
      "",
      "  # グループの個数と各頂点のグループidを返す",
      "  def scc_ids(s):",
      "    now_ord = group_num = 0",
      "    visited = []",
      "    low = [0] * s._n",
      "    ord = [-1] * s._n",
      "    ids = [0] * s._n",
      "    # 再帰関数 ",
      "    def dfs(self, v, now_ord, group_num):",
      "      low[v] = ord[v] = now_ord",
      "      now_ord += 1",
      "      visited.append(v)",
      "      if v in s.g:",
      "        for to in s.g[v]:",
      "          if ord[to] == -1:",
      "            now_ord, group_num = self(self, to, now_ord, group_num)",
      "            low[v] = min(low[v], low[to])",
      "          else:",
      "            low[v] = min(low[v], ord[to])",
      "      if low[v] == ord[v]:",
      "        while True:",
      "          u = visited.pop()",
      "          ord[u] = s._n",
      "          ids[u] = group_num",
      "          if u == v: break",
      "        group_num += 1",
      "      return now_ord, group_num",
      "",
      "    for i in range(s._n):",
      "      if ord[i] == -1: now_ord, group_num = dfs(dfs, i, now_ord, group_num)",
      "    for i in range(s._n):",
      "      ids[i] = group_num - 1 - ids[i]",
      "    return group_num, ids",
      "",
      "  # 強連結成分となっている頂点のリストのリスト トポロジカルソート済み",
      "  # O(n + m)",
      "  def scc(s):",
      "    group_num, ids = s.scc_ids()",
      "    counts = [0] * group_num",
      "    for x in ids: counts[x] += 1",
      "    groups = [[] for _ in range(group_num)]",
      "    for i in range(s._n):",
      "      groups[ids[i]].append(i)",
      "    return groups",
      "",
      "  class edge:",
      "    def __init__(s, frm, to):",
      "      s.frm = frm",
      "      s.to = to",
      "",
      "# usage: ts = TwoSAT(N); ts.add_clause(x, vx, y, vy); ok, assign = ts.solve()"
    ],
    "description": "2-SAT (含意グラフ + SCC、節集合を満たす変数割当を判定/構成)",
    "scope": "python"
  },
  "ushi": {
    "scope": "python",
    "prefix": "ushi",
    "description": "牛ゲー (差分制約 a - b ≤ w を最短路に帰着して整合性判定 / 最適値)",
    "body": [
      "class Ushi:",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.edge = []",
      "  def add_edge(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がv以下である",
      "      ※a < b",
      "    \"\"\"",
      "    self.edge.append([a, b, v])",
      "  def add_edge_gt(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がv以上である",
      "      ※a < b",
      "    \"\"\"",
      "    self.add_edge(b, a, -v)",
      "  def add_edge_eq(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がvである",
      "      ※a < b",
      "    \"\"\"",
      "    self.add_edge(a, b, v)",
      "    self.add_edge(b, a, -v)",
      "  def ushi_maximam(self, st, en):",
      "    \"\"\"",
      "      stからenまでの距離を最大化",
      "    \"\"\"",
      "    return self.bellman_ford(st, en)",
      "  def ushi_minimam(self, st, en):",
      "    \"\"\"",
      "      stからenまでの距離を最小化",
      "    \"\"\"",
      "    ans = self.bellman_ford(en, st)",
      "    if ans == None: return None",
      "    return -ans",
      "  def bellman_ford(self, st, en):",
      "    \"\"\"",
      "      O(頂点数×辺数)",
      "    \"\"\"",
      "    inf = 10 ** 18",
      "    dist = [inf] * self.N",
      "    dist[st] = 0",
      "    for _ in range(self.N):",
      "      complete = True",
      "      for a, b, v in self.edge:",
      "        if dist[a] + v < dist[b]:",
      "          dist[b] = dist[a] + v",
      "          complete = False",
      "      if complete: break",
      "    if complete: return dist[en]",
      "    else: return None",
      "",
      "# usage: u = Ushi(N); u.add_constraint(a, b, w); ok, vals = u.solve()"
    ]
  },
  "grid": {
    "prefix": "grid",
    "body": [
      "class gridMan:",
      "  def __init__(s, L):",
      "    s.L = L",
      "    s.H = len(s.L)",
      "    s.W = len(s.L[0])",
      "  def makeWall(s, x = -2):",
      "    w = len(s.L[0]) + 2",
      "    s.L = [[x] * w] + [[x] + i + [x] for i in s.L] + [[x] * w]",
      "  def dist(s, S): #Sから上下左右に進んで何手かかるかのリスト　および　最大値",
      "    T = [[-1] * s.W for _ in range(s.H)]",
      "    List = [[S[0], S[1]]]",
      "    T[S[0]][S[1]] = 0",
      "    k = 0",
      "    while List != []:",
      "      newList = []",
      "      for h, w in List:",
      "        k = T[h][w]",
      "        for x, y in [[h - 1, w], [h + 1, w], [h, w - 1], [h, w + 1]]:",
      "          if not (0 <= x < s.H): continue",
      "          if not (0 <= y < s.W): continue",
      "          if s.L[x + 1][y + 1] >= 0 and T[x][y] == -1:",
      "            newList.append([x, y])",
      "            T[x][y] = k + 1",
      "      List = newList",
      "    return T, k",
      "  ",
      "",
      "# usage: g = gridMan(L); g.makeWall(); D, mx = g.dist((sr, sc))"
    ],
    "description": "グリッド管理 gridMan (壁付与 + 4方向 BFS 距離 / 最大値)",
    "scope": "python"
