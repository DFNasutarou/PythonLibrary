  "ushi": {
    "scope": "python",
    "prefix": "ushi",
    "description": "牛ゲー (差分制約 a - b ≤ w を最短路に帰着して整合性判定 / 最適値)",
    "body": [
      "class Ushi:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.edge = []",
      "  def add_edge(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がv以下である",
      "      ※a < b",
      "    \"\"\"",
      "    self.edge.append([a, b, v])",
      "  def add_edge_gt(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がv以上である",
      "      ※a < b",
      "    \"\"\"",
      "    self.add_edge(b, a, -v)",
      "  def add_edge_eq(self, a, b, v):",
      "    \"\"\"",
      "      xaとxbの距離がvである",
      "      ※a < b",
      "    \"\"\"",
      "    self.add_edge(a, b, v)",
      "    self.add_edge(b, a, -v)",
      "  def ushi_maximam(self, st, en):",
      "    \"\"\"",
      "      stからenまでの距離(x_en - x_st)を最大化。上限なしは 10**18、矛盾（stから到達可能な負閉路）は None",
      "    \"\"\"",
      "    return self.bellman_ford(st, en)",
      "  def ushi_minimam(self, st, en):",
      "    \"\"\"",
      "      stからenまでの距離(x_en - x_st)を最小化。下限なしは -10**18、矛盾（enから到達可能な負閉路）は None",
      "    \"\"\"",
      "    ans = self.bellman_ford(en, st)",
      "    if ans == None: return None",
      "    return -ans",
      "  def bellman_ford(self, st, en):",
      "    \"\"\"",
      "      stからenへの最短距離 O(頂点数×辺数)",
      "      enに到達不能なら 10**18（制約がなく、いくらでも大きくできる）",
      "      stから到達可能な負閉路があれば None（制約が矛盾していて解なし）",
      "    \"\"\"",
      "    inf = 10 ** 18",
      "    dist = [inf] * self.N",
      "    dist[st] = 0",
      "    for _ in range(self.N):",
      "      complete = True",
      "      for a, b, v in self.edge:",
      "        if dist[a] == inf: continue",
      "        if dist[a] + v < dist[b]:",
      "          dist[b] = dist[a] + v",
      "          complete = False",
      "      if complete: break",
      "    if complete: return dist[en]",
      "    else: return None",
      "",
