  "mincost": {
    "prefix": "mincost",
    "body": [
      "import heapq",
      "NUMERIC_LIMITS = 10 ** 18",
      "",
      "class mcf_graph:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  def __init__ (self, n):",
      "    self._n = n",
      "    self.g = [[] for _ in range(n)]",
      "    self.pos = []",
      "",
      "  def add_edge(self, frm, to, cap, cost):",
      "    m = len(self.pos)",
      "    self.pos.append([frm, len(self.g[frm])])",
      "    self.g[frm].append(self._edge(to, len(self.g[to]) + (frm == to), cap, cost)) # 自己ループは逆辺が1つ後ろ",
      "    self.g[to].append(self._edge(frm, len(self.g[frm]) - 1, 0, -cost))",
      "    return m",
      "",
      "  class edge:",
      "    __slots__ = \"frm\", \"to\", \"cap\", \"flow\", \"cost\"",
      "    def __init__(self, frm, to, cap, flow, cost):",
      "      self.frm, self.to = frm, to",
      "      self.cap, self.flow, self.cost = cap, flow, cost",
      "",
      "  def get_edge(self, i):",
      "    _e = self.g[self.pos[i][0]][self.pos[i][1]]",
      "    _re = self.g[_e.to][_e.rev]",
      "    return self.edge(self.pos[i][0], _e.to, _e.cap + _re.cap, _re.cap, _e.cost)",
      "",
      "  def edges(self):",
      "    for i in range(len(self.pos)):",
      "      yield self.get_edge(i)",
      "",
      "  def flow(self, s, t, flow_limit = NUMERIC_LIMITS):",
      "    \"\"\"",
      "    flow_limitまで流したときの",
      "    最大流量/最小費用を返す",
      "    \"\"\"",
      "    return self.slope(s, t, flow_limit)[-1]",
      "",
      "  def dual_ref(self, s, t):",
      "    #priority_queueの代わり",
      "    push = heapq.heappush",
      "    pop = heapq.heappop",
      "",
      "    dist = [NUMERIC_LIMITS] * self._n",
      "    self.pv = [-1] * self._n",
      "    self.pe = [-1] * self._n",
      "    vis = [False] * self._n",
      "    que = []",
      "    dist[s] = 0",
      "    push(que, (0, s))",
      "    while que:",
      "      k, v = pop(que)",
      "      if vis[v]: continue",
      "      vis[v] = True",
      "      if v == t: break",
      "      for i in range(len(self.g[v])):",
      "        e = self.g[v][i]",
      "        if vis[e.to] or not e.cap: continue",
      "        cost = e.cost - self.dual[e.to] + self.dual[v]",
      "        if dist[e.to] - dist[v] > cost:",
      "          dist[e.to] = dist[v] + cost",
      "          self.pv[e.to] = v",
      "          self.pe[e.to] = i",
      "          push(que,(dist[e.to], e.to))",
      "    if not vis[t]: return False",
      "    for v in range(self._n):",
      "      if not vis[v]: continue",
      "      self.dual[v] -= dist[t] - dist[v]",
      "    return True",
      "",
      "  def slope(self, s, t, flow_limit = NUMERIC_LIMITS):",
      "    \"\"\"",
      "    各流量に対する最小コストのリスト",
      "    （流せなくなったら終了）",
      "    \"\"\"",
      "    self.dual = [0] * self._n",
      "    if any(e.cap and e.cost < 0 for es in self.g for e in es):",
      "      # 負コスト辺（残余グラフ上）がある場合のみ Bellman-Ford でポテンシャルを初期化 O(NM)",
      "      # 負閉路があると正しく動かない",
      "      dist = [NUMERIC_LIMITS] * self._n",
      "      dist[s] = 0",
      "      for _ in range(self._n):",
      "        upd = False",
      "        for v in range(self._n):",
      "          if dist[v] == NUMERIC_LIMITS: continue",
      "          for e in self.g[v]:",
      "            if e.cap and dist[v] + e.cost < dist[e.to]:",
      "              dist[e.to] = dist[v] + e.cost",
      "              upd = True",
      "        if not upd: break",
      "      if dist[t] == NUMERIC_LIMITS: return [(0, 0)]",
      "      # dual[t] = 0 を保つ（コスト計算 d = -dual[s] の前提）",
      "      self.dual = [d - dist[t] if d != NUMERIC_LIMITS else 0 for d in dist]",
      "",
      "    flow = 0",
      "    cost, prev_cost = 0, -1",
      "    result = [(flow, cost)]",
      "    while flow < flow_limit:",
      "      if not self.dual_ref(s, t): break",
      "      c = flow_limit - flow",
      "      v = t",
      "      while v != s:",
      "        c = min(c, self.g[self.pv[v]][self.pe[v]].cap)",
      "        v = self.pv[v]",
      "      v = t",
      "      while v != s:",
      "        e = self.g[self.pv[v]][self.pe[v]]",
      "        e.cap -= c",
      "        self.g[v][e.rev].cap += c",
      "        v = self.pv[v]",
      "      d = -self.dual[s]",
      "      flow += c",
      "      cost += c * d",
      "      if prev_cost == d:",
      "        result.pop()",
      "      result.append((flow, cost))",
      "      prev_cost = d",
      "    return result",
      "",
      "  class _edge:",
      "    __slots__ = \"to\", \"rev\", \"cap\", \"cost\"",
      "    def __init__(self, to, rev, cap, cost):",
      "      self.to, self.rev = to, rev",
      "      self.cap, self.cost = cap, cost",
      "",
      "# usage",
      "# mcf = mcf_graph(N)",
      "# mcf.add_edge(a, b, cap, cost)",
      "# flow, cost = mcf.flow(s, t, limit)"
    ],
