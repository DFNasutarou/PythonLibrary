    "body": [
      "class scc_graph:",
      "  @staticmethod",
      "  def scc(gf : GraphDataDirected):",
      "    \"\"\"",
      "    有向グラフから強連結成分分解",
      "    \"\"\"",
      "    return scc_graph._scc(gf.N, gf.AdjacencyList)",
      "  ",
      "  @staticmethod",
      "  def scc_graph(gf : GraphDataDirected):",
      "    \"\"\"",
      "    有向グラフから強連結成分を圧縮した有向グラフを返す",
      "    番号の昇順に見るとDAGになっている",
      "    戻り値：圧縮後の有向グラフ, 圧縮前と圧縮後のidの対応",
      "    \"\"\"",
      "    N, ids = scc_graph._scc_ids(gf.N, gf.AdjacencyList)",
      "    g = GraphDataDirected(N)",
      "    R = {}",
      "    for frm, to, _ in gf.get_edges():",
      "      a = ids[frm]",
      "      b = ids[to]",
      "      if a == b: continue",
