      "class warflo:",
      "  def __init__(s, N, inf):",
      "    s.inf = inf",
      "    s.D = [[s.inf] * N for _ in range(N)]",
      "    s.V = [[0] * N for _ in range(N)]",
      "    s.N = N",
      "  # aからbへcの辺を張る（負の辺は不可）",
      "  def add (s, a, b, c):",
      "    s.D[a][b] = c",
      "  # O(N^3)で各点間の距離を求める",
      "  def exe(s):",
      "    for i in range(s.N):",
      "      for j in range(s.N):",
      "        s.V[i][j] = i",
      "      s.D[i][i] = 0",
      "    for k in range(s.N):",
      "      for i in range(s.N):",
      "        for j in range(s.N):",
      "          if s.D[i][k] + s.D[k][j] < s.D[i][j]:",
      "            s.D[i][j] = s.D[i][k] + s.D[k][j]",
      "            s.V[i][j] = s.V[k][j]",
      "    return s.D",
      "  # aからbの経路を求める(先にexeをすること）",
      "  def route(s, a, b):",
      "    if s.D[a][b] == s.inf:",
      "      return []",
      "    c = b",
      "    L = [b]",
      "    while c != a:",
      "      c = s.V[a][c]",
      "      L.append(c)",
      "    L.reverse()",
      "    return L",
      "",
      "# usage: wf = warflo(N, inf); wf.add_edge(a, b, w); D = wf.calc()"
    ],
