    "body": [
      "class Union:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # root(x): x の属する集合の(代表元, サイズ)を返す",
      "  # merge(x, y): x と y の集合を併合する",
      "  # size(x): x の属する集合の要素数を返す",
      "  # same(x, y): x と y が同じ集合かを返す",
      "  def __init__(self, num):",
      "    self.T = [-1 for i in range(num)]",
      " ",
      "  def root(self, x):",
      "    if self.T[x] < 0: return x, -self.T[x]",
      "    t, k = self.root(self.T[x])",
      "    self.T[x] = t",
      "    return t, k",
      " ",
      "  def merge(self, x, y):",
      "    an, am = self.root(x)",
      "    bn, bm = self.root(y)",
      "    if an == bn: return False",
      "    if am < bm: an, bn  = bn, an",
      "    self.T[an] += self.T[bn]",
      "    self.T[bn] = an",
      "    return True",
      " ",
      "  def size(self, x):",
      "    return self.root(x)[1]",
      "",
      "  def same(self, x, y):",
      "    return self.root(x)[0] == self.root(y)[0]",
      "",
      "class Kruskal:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  # add(a, b, x): 重み x の辺 (a, b) を候補に追加する",
      "  # exe(): 最小全域木を構築し (総重み, 使用した辺のリスト) を返す",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.U = Union(N)",
      "    self.C = []",
      "",
      "  def add(self, a, b, x):",
      "    self.C.append([x, a, b, len(self.C)])",
      "",
      "  def exe(self):",
      "    self.C.sort()",
      "    ans = []",
      "    total = 0",
      "    for i in range(len(self.C)):",
      "      x, a, b, n = self.C[i]",
      "      if self.U.merge(a, b):",
      "        ans.append([n, a, b, x])",
      "        total += x",
      "    return total, ans",
      "",
      "# usage",
      "# k = Kruskal(N)",
      "# k.add(a, b, w)",
      "# total, mst_edges = k.exe()"
    ],
    "description": "クラスカル法 (最小全域木 MST、辺ソート + Union-Find)",
    "scope": "python"
