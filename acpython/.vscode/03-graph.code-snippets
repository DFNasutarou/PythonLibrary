  "maxflow": {
    "prefix": "maxflow",
    "body": [
      "NUMERIC_LIMITS = 10 ** 18",
      "from collections import deque",
      "class maxFlow:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/03-graph.code-snippets",
      "  class edge:",
      "    def __init__(self, frm, to, cap, flow):",
      "      self.frm, self.to = frm, to",
      "      self.cap, self.flow = cap, flow",
      "",
      "  def __init__(self,n):",
      "    self._n = n",
      "    self.g = [[] for _ in range(n)]",
      "    self.pos = []",
      "",
      "  def add_edge(self,frm, to, cap):",
      "    m = len(self.pos)",
      "    self.pos.append([frm, len(self.g[frm])])",
      "    self.g[frm].append(self._edge(to, len(self.g[to]) + (frm == to), cap)) # 自己ループは逆辺が1つ後ろ",
      "    self.g[to].append(self._edge(frm,len(self.g[frm]) - 1, 0))",
      "    return m",
      "",
      "  def get_edge(self,i):",
      "    m = len(self.pos)",
      "    _e = self.g[self.pos[i][0]][self.pos[i][1]]",
      "    _re = self.g[_e.to][_e.rev]",
      "    return self.edge(self.pos[i][0], _e.to, _e.cap + _re.cap, _re.cap)",
      "",
      "  def edges(self):",
      "    m = len(self.pos)",
      "    result = []",
      "    for i in range(m):",
      "      result.append(self.get_edge(i))",
      "    return result",
      "",
      "  def change_edge(self,i, new_cap, new_flow):",
      "    m = len(self.pos)",
      "    _e = self.g[self.pos[i][0]][self.pos[i][1]]",
      "    _re = self.g[_e.to][_e.rev]",
      "    _e.cap = new_cap - new_flow",
      "    _re.cap = new_flow",
      "",
      "  def flow(self, s, t, flow_limit = NUMERIC_LIMITS):",
      "    level = [0] * self._n",
      "    iter = [0] * self._n ",
      "",
      "    def bfs():",
      "      for i in range(self._n):",
      "        level[i] = -1",
      "      level[s] = 0",
      "      que = deque([s])",
      "      while que:",
      "        v = que.popleft()",
      "        for e in self.g[v]:",
      "           if e.cap == 0 or level[e.to] >= 0: continue",
      "           level[e.to] = level[v] + 1",
      "           if e.to == t: return",
      "           que.append(e.to)",
      "    def dfs(v, up):",
      "      # 非再帰版（ACL の再帰 dfs をフレーム (頂点, 上限, 流した量) のスタックで忠実に再現）",
      "      # 子の結果は親の「現在の辺」にまとめて反映するので、長い共通経路を何度も歩き直さない",
      "      sv = [v]; su = [up]; sr = [0]",
      "      while True:",
      "        x = sv[-1]",
      "        if x == s:",
      "          d = su[-1]",
      "        elif sr[-1] == su[-1]:",
      "          d = sr[-1]  # 上限に達したフレームを返す（iter は進めない）",
      "        else:",
      "          gx = self.g[x]; level_x = level[x]; i = iter[x]",
      "          found = False",
      "          while i < len(gx):",
      "            e = gx[i]",
      "            if level_x > level[e.to] and self.g[e.to][e.rev].cap > 0:",
      "              found = True; break",
      "            i += 1",
      "          iter[x] = i",
      "          if found:",
      "            sv.append(e.to); su.append(min(su[-1] - sr[-1], self.g[e.to][e.rev].cap)); sr.append(0)",
      "            continue",
      "          level[x] = self._n",
      "          d = sr[-1]",
      "        sv.pop(); su.pop(); sr.pop()",
      "        if not sv: return d",
      "        p = sv[-1]",
      "        if d > 0:",
      "          e = self.g[p][iter[p]]",
      "          e.cap += d; self.g[e.to][e.rev].cap -= d",
      "          sr[-1] += d",
      "          if sr[-1] == su[-1]: continue",
      "        iter[p] += 1",
      "",
      "    flow = 0",
      "    while flow < flow_limit:",
      "      bfs()",
      "      if level[t] == -1: break",
      "      for i in range(self._n): iter[i] = 0",
      "      while flow < flow_limit:",
      "        f = dfs(t, flow_limit - flow)",
      "        if not f: break",
      "        flow += f",
      "    return flow",
      "",
      "  def min_cut(self, s):",
      "    visited = [False] * self._n",
      "    que = deque([s])",
      "    while que:",
      "      p = que.popleft()",
      "      visited[p] = True",
      "      for e in self.g[p]:",
      "        if e.cap and not visited[e.to]:",
      "          visited[e.to] = True",
      "          que.append(e.to)",
      "    return visited",
      "",
      "  class _edge:",
      "    def __init__(self,to, rev, cap):",
      "      self.to, self.rev = to, rev",
      "      self.cap = cap",
      "",
      "# usage",
      "# mf = maxFlow(N)",
      "# mf.add_edge(a, b, cap)",
      "# f = mf.flow(s, t)"
    ],
    "description": "最大流 maxFlow (Dinic 系の自前実装、整数容量)",
    "scope": "python"
