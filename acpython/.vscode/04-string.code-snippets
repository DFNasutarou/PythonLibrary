  "rori": {
    "prefix": "rori",
    "body": [
      "class Rori:",
      "  B1 = 1009",
      "  B2 = 1007",
      "  MOD1 = 10 ** 9 + 7",
      "  MOD2 = 10 ** 9 + 9",
      "  H1, H2 = None, None",
      "  P1, P2 = None, None",
      "  def __init__(self, L):",
      "    n = len(L) + 1",
      "    self.H1 = [0] * n",
      "    self.H2 = [0] * n",
      "    self.P1 = [1] * n",
      "    self.P2 = [1] * n",
      "    for i in range(n - 1):",
      "      S = ord(L[i]) - ord('a') + 1",
      "      self.H1[i + 1] = (self.H1[i] * self.B1 + S) % self.MOD1",
      "      self.H2[i + 1] = (self.H2[i] * self.B2 + S) % self.MOD2",
      "      self.P1[i + 1] = self.P1[i] * self.B1 % self.MOD1",
      "      self.P2[i + 1] = self.P2[i] * self.B2 % self.MOD2",
      "  def hashLR(self, l, r):",
      "    t = ((self.H1[r] - self.H1[l] * self.P1[r - l]) % self.MOD1 + self.MOD1) % self.MOD1",
      "    k = ((self.H2[r] - self.H2[l] * self.P2[r - l]) % self.MOD2 + self.MOD2) % self.MOD2",
      "    return (t, k)",
      "",
      "# usage: r = Rori(S); r.hash(l, r); r.same(l1, r1, l2, r2)"
    ],
    "description": "ローリングハッシュ Rori (二重 mod、文字列の部分一致を O(1) で比較)",
    "scope": "python"
  },
  "string": {
    "prefix": "string",
    "body": [
      "from functools import cmp_to_key",
      "THRESHOLD_NAIVE = 10",
      "THRESHOLD_DOUBLING = 40",
      "",
      "# ull以下の配列の接尾辞配列",
      "# O(n log n）",
      "# O(n + upper) upper指定時(upper <= 10^8)",
      "# O(n) sが文字列の時",
      "def suffix_array(s, upper = -1):",
      "  if type(s) == str: return suffix_array_str(s)",
      "  if upper == -1:",
      "    vals = sorted(set(s))",
      "    comp = {v: i for i, v in enumerate(vals)}",
      "    return sa_is([comp[v] for v in s], len(vals) - 1)",
      "  def cmp(r, l):",
      "    return 1 if s[l] < s[r] else -1",
      "  n = len(s)",
      "  idx = [i for i in range(n)]",
      "  idx.sort(key=cmp_to_key(cmp))",
      "  s2 = [0] * n",
      "  now = 0",
      "  for i in range(n):",
      "    if i and s[idx[i - 1]] != s[idx[i]]: now += 1",
      "    s2[idx[i]] = now",
      "  return sa_is(s2, now)",
      "",
      "# 最長共通接頭辞配列",
      "# saはsのsuffix_array",
      "# O(n)",
      "def lcp_array(s, sa):",
      "  if type(s) == str: s = list(map(ord, s))",
      "  n = len(s)",
      "  rnk = [0] * n",
      "  for i in range(n):",
      "    rnk[sa[i]] = i",
      "  lcp = [0] * (n - 1)",
      "  h = 0",
      "  for i in range(n):",
      "    if h > 0: h -= 1",
      "    if rnk[i] == 0: continue",
      "    j = sa[rnk[i] - 1]",
      "    while j + h < n and i + h < n:",
      "      if s[j + h] != s[i + h]: break",
      "      h += 1",
      "    lcp[rnk[i] - 1] = h",
      "  return lcp",
      "",
      "# zアルゴリズム",
      "# Longest Common Prefix",
      "def z_algorithm(s):",
      "  if type(s) == str: s = list(map(ord, s))",
      "  n = len(s)",
      "  if n == 0: return []",
      "  z = [0] * n",
      "  j = 0",
      "  for i in range(1, n):",
      "    z[i] = 0 if j + z[j] <= i else min(j + z[j] - i, z[i - j])",
      "    while i + z[i] < n and s[z[i]] == s[i + z[i]]: z[i] += 1",
      "    if j + z[j] < i + z[i]: j = i",
      "  z[0] = n",
      "  return z",
      "",
      "# O(n + upper)",
      "def sa_is(s, upper):",
      "  n = len(s)",
      "  if n == 0: return []",
      "  if n == 1: return [0]",
      "  if n == 2:",
      "    if s[0] < s[1]: return [0, 1]",
      "    else: return [1, 0]",
      "  if n < THRESHOLD_NAIVE:",
      "    return sa_naive(s)",
      "  if n < THRESHOLD_DOUBLING:",
      "    return sa_doubling(s)",
      "",
      "  sa = [0] * n",
      "  ls = [False] * n",
      "  for i in range(n - 2, -1, -1):",
      "    ls[i] = ls[i + 1] if s[i] == s[i + 1] else s[i] < s[i + 1]",
      "  sum_l = [0] * (upper + 1)",
      "  sum_s = [0] * (upper + 1)",
      "  for i in range(n):",
      "    if not ls[i]: sum_s[s[i]] += 1",
      "    else: sum_l[s[i] + 1] += 1",
      "  for i in range(upper + 1):",
      "    sum_s[i] += sum_l[i]",
      "    if i < upper: sum_l[i + 1] += sum_s[i]",
      "",
      "  def induce(lms):",
      "    for i in range(n): sa[i] = -1",
      "    buf = [0] * (upper + 1)",
      "    for i in range(len(sum_s)): buf[i] = sum_s[i]",
      "    for d in lms:",
      "      if d == n: continue",
      "      sa[buf[s[d]]] = d",
      "      buf[s[d]] += 1",
      "    for i in range(len(sum_l)): buf[i] = sum_l[i]",
      "    sa[buf[s[n - 1]]] = n - 1",
      "    buf[s[n - 1]] += 1",
      "    for i in range(n):",
      "      v = sa[i]",
      "      if v >= 1 and not ls[v - 1]:",
      "        sa[buf[s[v - 1]]] = v - 1",
      "        buf[s[v - 1]] += 1",
      "    for i in range(len(sum_l)): buf[i] = sum_l[i]",
      "    for i in range(n - 1, -1, -1):",
      "      v = sa[i]",
      "      if v >= 1 and ls[v - 1]:",
      "       buf[s[v - 1] + 1] -= 1",
      "       sa[buf[s[v - 1] + 1]] = v - 1",
      "",
      "  lms_map = [-1] * (n + 1)",
      "  m = 0",
      "  for i in range(1, n):",
      "    if not ls[i - 1] and ls[i]:",
      "      lms_map[i] = m",
      "      m += 1",
      "  lms = []",
      "  for i in range(1, n):",
      "    if not ls[i - 1] and ls[i]:",
      "      lms.append(i)",
      "",
      "  induce(lms)",
      "",
      "  if m:",
      "    sorted_lms = []",
      "    for v in sa:",
      "      if lms_map[v] != -1: sorted_lms.append(v)",
      "    rec_s = [0] * m",
      "    rec_upper = 0",
      "    rec_s[lms_map[sorted_lms[0]]] = 0",
      "    for i in range(1, m):",
      "      l, r = sorted_lms[i - 1], sorted_lms[i]",
      "      end_l = lms[lms_map[l] + 1] if lms_map[l] + 1 < m else n",
      "      end_r = lms[lms_map[r] + 1] if lms_map[r] + 1 < m else n",
      "      same = True",
      "      if end_l - l != end_r - r:",
      "        same = False",
      "      else:",
      "        while l < end_l:",
      "          if s[l] != s[r]: break",
      "          l += 1",
      "          r += 1",
      "        if l == n or s[l] != s[r]: same = False",
      "      if not same: rec_upper += 1",
      "      rec_s[lms_map[sorted_lms[i]]] = rec_upper",
      "",
      "    rec_sa = sa_is(rec_s, rec_upper)",
      "",
      "    for i in range(m):",
      "      sorted_lms[i] = lms[rec_sa[i]]",
      "    induce(sorted_lms)",
      "",
      "  return sa",
      "",
      "# ナイーブ実装",
      "# O(n^2 log n)",
      "def sa_naive(s):",
      "  def cmp(r, l):",
      "    if l == r: return -1",
      "    while (l < n and r < n):",
      "      if s[l] != s[r]: return 1 if s[l] < s[r] else -1",
      "      l += 1",
      "      r += 1",
      "    return 1 if l == n else -1",
      "  n = len(s)",
      "  sa = [i for i in range(n)]",
      "  sa.sort(key=cmp_to_key(cmp))",
      "  return sa",
      "#doubling",
      "def sa_doubling(s):",
      "  n = len(s)",
      "  sa = [i for i in range(n)]",
      "  rnk = s",
      "  tmp = [0] * n",
      "  k = 1",
      "  while k < n:",
      "    def cmp(y, x):",
      "      if rnk[x] != rnk[y]: return 1 if rnk[x] < rnk[y] else -1",
      "      rx = rnk[x + k] if x + k < n else -1",
      "      ry = rnk[y + k] if y + k < n else -1",
      "      return 1 if rx < ry else -1",
      "    sa.sort(key=cmp_to_key(cmp))",
      "    tmp[sa[0]] = 0",
      "    for i in range(1, n):",
      "      tmp[sa[i]] = tmp[sa[i - 1]] + (1 if cmp(sa[i], sa[i - 1]) == 1 else 0)",
      "    tmp, rnk = rnk, tmp",
      "    k *= 2",
      "  return sa",
      "",
      "# 文字列の接尾辞配列",
      "# O(n)",
      "def suffix_array_str(s):",
      "  n = len(s)",
      "  s2 = list(map(ord, s))",
      "  return sa_is(s2, 255)",
      "",
      "# usage: 内部関数を直接 import する用途別ライブラリ"
    ],
    "description": "文字列アルゴリズム集 (suffix array / LCP / 文字列ソート関連まとめ)",
    "scope": "python"
  },
  "eertree": {
    "scope": "python",
    "prefix": "eertree",
    "description": "eertree / 回文木 (文字列内の全ての異なる回文部分文字列を管理)",
    "body": [
      "class eertree:",
      "  class node:",
      "    def __init__(self, d: int, p: int, n: int):",
      "      \"\"\"",
      "      Args:",
      "          d (int): 回文の長さ",
      "          p (int): 親ノードの番号",
      "          n (int): 自分の番号",
      "      \"\"\"",
      "      self.next = {}",
      "      self.link: eertree.node = self",
      "      self.length: int = d",
      "      self.count: int = 0; #カウント",
      "      self.parent: int = p",
      "      self.number: int = n",
      "    def getCount(self) -> int:",
      "      \"\"\"",
      "      Returns:",
      "          int: 自分が最後尾となるような回文の個数",
      "      \"\"\"",
      "      return self.count",
      "    def getLengthIndex(self):",
      "      \"\"\"",
      "      Returns:",
      "          int: 自分が最後尾となるような回文のなかで最も長いものの長さ",
      "      \"\"\"",
      "      return self.length",
      "    def _add(self, x: str, p: int, n: int) -> int:",
      "      \"\"\"",
      "      Args:",
      "          x (str): 追加された文字(回文の外側の文字)",
      "          p (int): 親ノードの番号",
      "          n (int): 自分の番号",
      "",
      "      Returns:",
      "          int: 追加あり: 1, 追加なし(既に存在する): 0",
      "      \"\"\"",
      "      if x in self.next: return 0 ",
      "      self.next[x] = eertree.node(self.length + 2, p, n)  ",
      "      return 1",
      "    def _get(self, x):",
      "      return self.next[x]",
      "    def _find(self, x):",
      "      return x in self.next",
      "  # 文字の追加",
      "  def addChar(self, x): self._add(x)",
      "  # 文字列の追加",
      "  def addString(self, xs):",
      "    for x in list(xs): self._add(x)",
      "  def getIndex(self, i) -> node:",
      "    \"\"\"",
      "    Args:",
      "        i (int): 文字番号",
      "",
      "    Returns:",
      "        node: i文字目に対応するnode",
      "    \"\"\"",
      "    return self.index[i]",
      "  def getCount(self)  -> int: ",
      "    \"\"\"",
      "    Returns:",
      "        int: 全ての回文の個数",
      "    \"\"\"",
      "    return self.allcnt",
      "  # ユニークな回文の個数",
      "  def getCountUnique(self)  -> int:",
      "    \"\"\"",
      "    Returns:",
      "        int: ユニークな回文の種類数",
      "    \"\"\"",
      "    return len(self.nodelist)",
      "  # 最大の長さの文字数",
      "  def getMaxSize(self) : return self.maxNode.length",
      "  # 最大の長さの文字",
      "  def getMaxWord(self):",
      "    d = self.maxNode.length",
      "    t = self.maxNodeInd + 1",
      "    return self.S[t - d:t]",
      "  # nodeリスト",
      "  def getNodeList(self): return self.nodelist",
      "  def __init__(self):",
      "    self.S = []",
      "    self.odd = self.node(-1, -1, -1)",
      "    self.even = self.node(0, -1, 0)",
      "    self.odd.link = self.odd",
      "    self.even.link = self.odd",
      "    self.now = self.odd",
      "    self.index: list[eertree.node] = [] # i番目を末尾とするnode",
      "    self.nodelist = [self.even] # node作られた順",
      "    self.maxNodeInd = 0 # 一番大きいnodeの番号",
      "    self.maxNode = self.even # 一番大きいnode",
      "    self.allcnt = 0",
      "  def _add(self, x):",
      "    self.S.append(x)",
      "    while not self.checkStr(x, self.now.length): self.now = self.now.link",
      "    if self.now._add(x, self.now.number, len(self.nodelist)):",
      "      self.nodelist.append(self.now._get(x))",
      "    g = self.now.link",
      "    while not self.checkStr(x, g.length): g = g.link",
      "    self.now = self.now._get(x)",
      "    if self.now.length == 1: self.now.link = self.even",
      "    else: self.now.link = g._get(x)",
      "    self.now.count = self.now.link.count + 1",
      "    self.index.append(self.now)",
      "    self.allcnt += self.now.count",
      "    if self.maxNode.length < self.now.length:",
      "      self.maxNode = self.now",
      "      self.maxNodeInd = len(self.index) - 1",
      "  def checkStr(self,  x, length):",
      "    if length >= len(self.S) - 1 : return False",
      "    return x == self.S[-2 - length]",
      "  ",
      "",
      "# usage: et = eertree(); et.add(c); et.count_palindromes()"
    ]
  },
  "hensyukyori": {
    "scope": "python",
    "prefix": "hensyukyori",
    "description": "編集距離 (Levenshtein 距離、時間 O(|S| * |T|) / メモリ O(min(|S|, |T|)))",
    "body": [
      "def chmin(data, i, x):",
      "  if data[i] > x: data[i] = x",
      "",
      "def hensyuKyori(S, T):",
      "  if len(S) < len(T): S, T = T, S",
      "  M = len(T)",
      "  prev = list(range(M + 1))",
      "  for i, s in enumerate(S, 1):",
      "    cur = [i] + [0] * M",
      "    for j, t in enumerate(T, 1):",
      "      cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (s != t))",
      "    prev = cur",
      "  return prev[M]",
      "",
      "def hensyuKyoriK(S, T, K):",
      "  N = len(S) + 1",
      "  M = len(T) + 1",
      "  inf = N + M + 1",
      "  if abs(N - M) > K: return inf",
      "  dp = [[inf] * (2 * K + 2) for _ in range(N)]",
      "  for i in range(2 * K + 1):",
      "    dp[0][i] = abs(i - K)",
      "  for i in range(min(N, K + 1)):",
      "    dp[i][K - i] = i ",
      "  for i in range(1, N):",
      "    for j in range(max(1, i - K), min(M, i + K + 1)):",
      "      k = K + j - i",
      "      if not (0 <= k < 2 * K + 1): continue",
      "      chmin(dp[i], k, dp[i - 1][k + 1] + 1)",
      "      chmin(dp[i], k, dp[i][k - 1] + 1)",
      "      c = (S[i - 1] != T[j - 1])",
      "      chmin(dp[i], k, dp[i - 1][k] + c)",
      "  k = M - N + K",
      "  # for d in dp: print(d)",
      "  return dp[-1][k]",
      "",
      "# usage: d = edit_distance(S, T)"
    ]
  },
  "suffixarray": {
    "scope": "python",
    "prefix": "suffixarray",
    "description": "Suffix Array (atcoder.string ラッパ、部分文字列順序付け + LCP)",
    "body": [
      "import atcoder.string",
      "class SA:",
      "  \"\"\"",
      "  SuffixArrayアルゴリズム",
      "  \"\"\"",
      "  def __init__(self, S):",
      "    self.S = S",
      "    self.sa = SA.suffix_array(S)",
      "    self.lcp = SA.lcp_array(S, self.sa)",
      "    self.N = len(self.sa)",
      "",
      "  def restore_list(self, L):",
      "    \"\"\"",
      "    Suffix Array順に処理したデータを元の順番に復元する",
      "    \"\"\"",
      "    X = [0] * self.N",
      "    for i in range(self.N):",
      "      X[self.sa[i]] = L[i]",
      "    return X",
      "",
      "  @ staticmethod",
      "  def suffix_array(s, upper = -1):",
      "    \"\"\"",
      "    ull以下の配列の接尾辞配列",
      "    O(n log n）",
      "    O(n + upper) upper指定時(upper <= 10^8)",
      "    O(n) sが文字列の時",
      "    \"\"\"",
      "    return atcoder.string.suffix_array(s, upper)",
      "",
      "  @staticmethod",
      "  def lcp_array(s, sa):",
      "    \"\"\"",
      "    最長共通接頭辞配列",
      "    saはsのsuffix_array",
      "    O(n)",
      "    \"\"\"",
      "    return atcoder.string.lcp_array(s, sa)",
      "",
      "  def debug_suffix_str(self):",
      "    \"\"\"",
      "    デバッグ用 O(N^2)",
      "    suffix arrayの順に表示する",
      "    \"\"\"",
      "    for i in range(self.N):",
      "      print(self.S[self.sa[i]:])",
      "",
      "# usage: sa = SA(S); sa.suffix_array(); sa.lcp_array()"
    ]
  },
