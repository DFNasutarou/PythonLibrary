    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "# 1 + x + x^2 + ... + x^t (初項1 公比x 項数t+1) の和を mod で求め、[和, x^t] を返す",
      "def nib(x, t, MOD):",
      "  # calc(n) = [1 + x + ... + x^(n-1), x^n]",
      "  x %= MOD",
      "  def calc(n):",
      "    if n == 0: return [0, 1]",
      "    s, p = calc(n >> 1)",
      "    s = s * (1 + p) % MOD",
      "    p = p * p % MOD",
      "    if n & 1:",
      "      s = (s + p) % MOD",
      "      p = p * x % MOD",
      "    return [s, p]",
      "  s, _ = calc(t + 1)",
      "  return [s, pow(x, t, MOD)]"
    ],
    "description": "等比数列和 (1 + x + ... + x^t mod MOD、ダブリング O(log t))",
    "scope": "python"
