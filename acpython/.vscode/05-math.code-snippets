      "    y = [[0] * len(x) for _ in range(len(x))]",
      "    for i in range(len(x)):",
      "        y[i][i] = 1",
      "    while n > 0:",
      "        if n & 1:",
      "            y = mat_mul(x, y)",
      "        x = mat_mul(x, x)",
      "        n >>= 1",
      "    return y",
