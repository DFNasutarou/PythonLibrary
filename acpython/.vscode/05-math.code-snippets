      "    n進数を10進数に変換",
      "    \"\"\"",
      "    x = str(x)",
      "    return int(x, n)",
      "  @staticmethod",
      "  def fromDec(x, n):",
      "    \"\"\"",
      "    10進数をn進数に変換",
      "    \"\"\"",
      "    if x == 0:",
      "      return \"0\"",
      "    if n < 2:",
      "      raise ValueError(\"n は 2 以上の自然数でなければなりません\")",
      "    ",
      "    digits = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
      "    if n > len(digits):",
      "      raise ValueError(f\"n は {len(digits)} 以下でなければなりません\")",
      "    ",
      "    res = []",
      "    while x > 0:",
      "      res.append(digits[x % n])",
      "      x //= n",
      "    ans = \"\".join(res[::-1])",
      "    return ans",
      "  @staticmethod",
      "  def n2m(x, n, m):",
      "    \"\"\"",
      "    n進数をm進数に変換",
      "    \"\"\"",
      "    x = Radix_Convert.toDec(x, n)",
