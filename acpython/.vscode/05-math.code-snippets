      "          l = a[i + offset]",
      "          r = a[i + offset + p] * now % self.MOD",
      "          a[i + offset] = (l + r) % self.MOD",
      "          a[i + offset + p] = (l - r) % self.MOD",
      "        now = now * sum_e[self.bsf(~ss)] % self.MOD",
      "    return a",
      "",
      "  def butterfly_inv(self, a):",
      "    g = self.PrimitiveRoot",
      "    n = len(a)",
      "    h = self.ceil_pow2(n)",
      "",
      "    first = True",
      "    sum_ie = [0] * 30",
