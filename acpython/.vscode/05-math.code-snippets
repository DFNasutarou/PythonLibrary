      "# 行列累乗",
      "# mat_pow(行列, 累乗)",
      "# MOD を設定しておく",
      "MOD = 998244353",
      "def mat_mul(a, b) :",
      "    I, J, K = len(a), len(b[0]), len(b)",
      "    c = [[0] * J for _ in range(I)]",
      "    for i in range(I) :",
      "        for j in range(J) :",
      "            for k in range(K) :",
      "                c[i][j] += a[i][k] * b[k][j]",
      "            c[i][j] %= MOD",
