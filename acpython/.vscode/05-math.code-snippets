  "convolvell": {
    "prefix": "convolvell",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "import numpy as np",
      "",
      "def convolve(f, g):",
      "    \"\"\"多項式 f, g の積を計算する。",
      "",
      "    Parameters",
      "    ----------",
      "    f : np.ndarray (int64)",
      "        f[i] に、x^i の係数が入っている",
      "",
      "    g : np.ndarray (int64)",
      "        g[i] に、x^i の係数が入っている",
      "",
      "",
      "    Returns",
      "    -------",
      "    h : np.ndarray",
      "        f,g の積",
      "    \"\"\"",
      "    # h の長さ以上の n=2^k を計算",
      "    fft_len = 1",
      "    while 2 * fft_len < len(f) + len(g) - 1:",
      "        fft_len *= 2",
      "    fft_len *= 2",
      "",
      "    # フーリエ変換",
      "    Ff = np.fft.rfft(f, fft_len)",
      "    Fg = np.fft.rfft(g, fft_len)",
      "",
      "    # 各点積",
      "    Fh = Ff * Fg",
      "",
      "    # フーリエ逆変換",
      "    h = np.fft.irfft(Fh, fft_len)",
      "",
      "    # 小数になっているので、整数にまるめる",
      "    h = np.rint(h).astype(np.int64)",
      "",
      "    return h[:len(f) + len(g) - 1]"
    ],
    "description": "畳み込み (numpy FFT、整数係数 / 高速だが MOD 不可。float64 精度のため結果の各係数の絶対値が 1e15 程度を超えると丸め誤差で不正確)",
    "scope": "python"
  },
  "divhoujo": {
    "prefix": "divhoujo",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "# exe(d): 「d の約数 x 全てについての R[x] の総和」になる量を書く (例: 周期が d の約数である個数)",
      "#   → divhoujo で R[d] = 「ちょうど d」の量に変換し、その総和を返す",
      "# 前提: D は約数について閉じた昇順リスト (D の各要素の約数がすべて D に含まれる。例: D = divisor(N))",
      "#       グローバルの MOD を使う",
      "def exe(x):",
      "  ans = 0",
      "  return ans % MOD",
      "",
      "import math",
      "def divisor(n):",
      "  if n == 1: return [1]",
      "  L, R = [1], [n]",
      "  last = math.floor(n ** 0.5)",
      "  for i in range(2, last + 1):",
      "    if n % i == 0:",
      "      L.append(i)",
      "      if i != n // i:",
      "        R.append(n // i)",
      "  return L + R[::-1]",
      "",
      "def divhoujo(D):",
      "  R = {}",
      "  ans = 0",
      "  for d in D:",
      "    p = exe(d)",
      "    for x in divisor(d)[:-1]:",
      "      p -= R[x]",
      "      p %= MOD",
      "    R[d] = p",
      "    ans += p",
      "    ans %= MOD",
      "  return ans"
    ],
    "description": "除数包除 (約数について閉じた昇順リスト D 上で「d の約数についての和」→「ちょうど d」を求めて総和、O(Σ d(x)) + 約数列挙)",
    "scope": "python"
