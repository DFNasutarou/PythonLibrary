  "gyoretu": {
    "prefix": "gyoretu",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "# 行列累乗",
      "# mat_pow(行列, 累乗)",
      "# MOD を設定しておく",
      "MOD = 998244353",
      "def mat_mul(a, b) :",
      "    I, J, K = len(a), len(b[0]), len(b)",
      "    c = [[0] * J for _ in range(I)]",
      "    for i in range(I) :",
      "        ci = c[i]",
      "        ai = a[i]",
      "        for k in range(K) :",
      "            aik = ai[k]",
      "            if aik == 0: continue",
      "            bk = b[k]",
      "            for j in range(J) :",
      "                ci[j] = (ci[j] + aik * bk[j]) % MOD",
      "    return c",
      "",
      "def mat_pow(x, n):",
      "    y = [[0] * len(x) for _ in range(len(x))]",
      "    for i in range(len(x)):",
      "        y[i][i] = 1",
      "    while n > 0:",
      "        if n & 1:",
      "            y = mat_mul(x, y)",
      "        x = mat_mul(x, x)",
      "        n >>= 1",
      "    return y"
    ],
    "description": "行列累乗 mat_pow (ダブリング、MOD は冒頭で要定義)",
    "scope": "python"
  },
  "hakidasi": {
    "prefix": "hakidasi",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "def hakidasi(L):",
      "  # L: 空でない非負整数のリスト (破壊的に変更して返す)",
      "  # 返り値: 先頭 rank 個が上位ビットから階段状の基底、残りは 0",
      "  n = len(bin(max(L))) - 2",
      "  k, end = 0, len(L)",
      "  for i in range(n - 1, -1, -1):",
      "    for j in range(k, end):",
      "      if (L[j] >> i) & 1:",
      "        L[k], L[j] = L[j], L[k]",
      "        break",
      "    else:",
      "      continue",
      "    k += 1",
      "    for j in range(k, end):",
      "      if (L[j] >> i) & 1:",
      "        L[j] ^= L[k - 1]",
      "  return L"
    ],
    "description": "XOR 掃き出し (整数列を GF(2) 上で階段化、in-place)",
    "scope": "python"
  },
  "inv": {
    "prefix": "inv",
    "body": [
      "class Inv:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "  # invx(a): a の逆元 (a^-1 mod MOD) を返す",
      "  # invL(n): 0 <= x <= n の逆元リストを返す",
      "  # invpowL(a, n): a^-x (0 <= x <= n) のリストを返す",
      "  def __init__(self, mod):",
      "    self.MOD = mod",
      "  def modpow(self, a, n):",
      "    res = 1",
      "    while n > 0:",
      "      if n & 1:",
      "        res = res * a % self.MOD",
      "      a = a * a % self.MOD",
      "      n >>= 1",
      "    return res",
      "  def invx(self, a):",
      "    return self.modpow(a, self.MOD - 2)",
      "  def invpowL(self, a, n): # a^-x (0 <= x <= n)リスト",
      "    ia = self.invx(a)",
      "    L = [1] * (n + 1)",
      "    for i in range(1, n + 1):",
      "      L[i] = L[i - 1] * ia % self.MOD",
      "    return L",
      "  def invL(self, n): # 0 <= x <= n 逆元リスト",
      "    I = [0, 1]",
      "    for i in range(2, n + 1):",
