      "        a, b = b, a",
      "      ans = [0] * (n + m - 1)",
      "      for i in range(n):",
      "        for j in range(m):",
      "          ans[i + j] = (ans[i + j] + a[i] * b[j]) % self.MOD",
      "      return ans",
      "    z = 1 << self.ceil_pow2(n + m - 1)",
      "    a = a + [0] * (z - n)",
      "    a = self.butterfly(a)",
      "    b = b + [0] * (z - m)",
