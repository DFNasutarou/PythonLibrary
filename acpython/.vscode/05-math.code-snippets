  "inv": {
    "prefix": "inv",
    "body": [
      "class Inv:",
      "  def __init__(self, mod):",
      "    self.MOD = mod",
      "  def modpow(self, a, n):",
      "    res = 1",
      "    while n > 0:",
      "      if n & 1:",
      "        res = res * a % self.MOD",
      "      a = a * a % self.MOD",
      "      n >>= 1",
      "    return res",
      "  def invx(self, a):",
      "    return self.modpow(a, self.MOD - 2)",
      "  def invpowL(self, a, n): # a^-x (0 <= x <= n)リスト",
      "    ia = self.invx(a)",
      "    L = [1] * (n + 1)",
      "    for i in range(1, n + 1):",
      "      L[i] = L[i - 1] * ia % self.MOD",
      "    return L",
      "  def invL(self, n): # 0 <= x <= n 逆元リスト",
      "    I = [0, 1]",
      "    for i in range(2, n + 1):",
      "      I.append(self.MOD - I[self.MOD % i] * (self.MOD // i) % self.MOD)",
      "    return I",
      "",
      "# usage: inv = Inv(MOD); inv.invx(a); inv.invL(n)"
    ],
    "description": "逆元 Inv クラス (modpow + 単発逆元 + 逆元リスト)",
    "scope": "python"
