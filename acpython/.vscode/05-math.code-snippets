      "        sum_ie[i] = ies[i] * now % self.MOD",
      "        now = now * es[i] % self.MOD",
      "    for ph in range(h, 0, -1):",
      "      w, p = 1 << (ph - 1), 1 << (h - ph)",
      "      inow = 1",
