  },
  "prime": {
    "prefix": "prime",
    "body": [
      "import math",
      "import bisect",
      "class Prime:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "  # getPrimeList(): 素数リスト(Nまで)を返す",
      "  # isPrime(x): 素数判定を行う (x<=N: 篩の結果 / x>N: ミラーラビン法)",
      "  # primeFactorization(x): 素因数分解を行い {素数: 指数} を返す (x<=N: lpf表 / N<x<=N**2: 素数リストで試し割り / それ以上: O(√x) 試し割り)",
      "  #   x >= 1 が前提 (x=1 は {}、x<=0 は ValueError)",
      "  # factorize(x): primeFactorization のエイリアス",
      "  LPF_LIMIT = 5 * 10 ** 6 # これを超える N では lpf 表を持たずメモリを節約する (Prime(10**8) 等での MLE を防ぐ)",
      "  def __init__(self, N: int = 1):",
      "    self.N = N",
      "    if N <= Prime.LPF_LIMIT:",
      "      self.lpf, self.prime = self.makeLpf(N)",
      "    else:",
      "      self.lpf = None",
      "      self.prime = self.makePrimeList(N)",
      "  def getPrimeList(self):",
      "    \"\"\"素数リスト(Nまで)\"\"\"",
      "    return self.prime",
      "  def isPrime(self, x : int):",
      "    \"\"\"素数判定\"\"\"",
      "    if x > self.N: return self.isPrimeBig(x)",
      "    if self.lpf is not None: return x >= 2 and self.lpf[x] == x",
      "    i = bisect.bisect_left(self.prime, x)",
      "    return i < len(self.prime) and self.prime[i] == x",
      "  def primeFactorization(self, x: int):",
      "    \"\"\"素因数分解 (x >= 1)\"\"\"",
      "    if x <= 0: raise ValueError(\"primeFactorization: x must be >= 1\")",
      "    if self.lpf is not None and x <= self.N: return self.primeFactrizationSmall(x)",
      "    if x <= self.N * self.N: return self.primeFactrizationTrial(x)",
      "    return self.primeFactrizationBig(x)",
      "  def makeLpf(self, N: int):",
      "    \"\"\"前計算O(N) (最小素因数リスト + 素数リスト。LPF_LIMIT 以下の N でのみ使う想定)\"\"\"",
      "    lpf = [0] * (N + 1)",
      "    prime = []",
      "    for i in range(2, N + 1):",
      "      if lpf[i] == 0:",
      "        lpf[i] = i",
      "        prime.append(i)",
      "      for p in prime:",
      "        if p > lpf[i]: break",
      "        j = i * p",
      "        if j > N: break",
      "        lpf[j] = p",
      "    return lpf, prime",
      "  def makePrimeList(self, N: int):",
      "    \"\"\"",
      "    メモリ節約版のエラトステネスの篩 (lpf 表を持たず素数リストのみ作る)",
      "    N = 10**8 程度でも動作する (bytearray の篩は構築中のみ保持し、後は素数リストだけ残す)",
      "    \"\"\"",
      "    is_composite = bytearray(N + 1)",
      "    primes = []",
      "    for i in range(2, N + 1):",
      "      if is_composite[i]: continue",
      "      primes.append(i)",
      "      if i * i <= N:",
      "        is_composite[i * i::i] = b\"\\x01\" * len(range(i * i, N + 1, i))",
      "    return primes",
      "  def isPrimeBig(self, x):",
      "    \"\"\"素数判定\"\"\"",
      "    if x <= 1: return False",
      "    if x == 2: return True",
      "    if x % 2 == 0: return False",
      "    if x < 4759123141: return self.millerRabin(x, [2, 7, 61])",
      "    return self.millerRabin(x, [2, 325, 9375, 28178, 450775, 9780504, 1795265022])",
      "  def millerRabin(self, n, L):",
      "    \"\"\"ミラーラビン法\"\"\"",
      "    s = 0",
      "    d = n - 1",
      "    while d % 2 == 0:",
      "      s += 1",
      "      d >>= 1",
      "    for a in L:",
      "      if n <= a: return True",
      "      x = pow(a, d, n)",
      "      if x != 1:",
      "        for t in range(s):",
      "          if x == n - 1: break",
      "          x = x * x % n",
      "        else: return False",
      "    return True",
      "  def primeFactrizationSmall(self, x):",
      "    \"\"\"前計算O(N), クエリO(素因数の数)で素因数分解\"\"\"",
      "    p = {}",
      "    while x != 1:",
      "      n = self.lpf[x]",
      "      if n in p: p[n] += 1",
      "      else: p[n] = 1",
      "      x = x // n",
      "    return p",
      "  def primeFactrizationTrial(self, x):",
      "    \"\"\"",
      "    前計算した素数リスト(Nまで)で試し割りして素因数分解する",
      "    x <= N**2 程度まで対応。O(π(√x))",
      "    \"\"\"",
      "    p = {}",
      "    for pr in self.prime:",
      "      if pr * pr > x: break",
      "      while x % pr == 0:",
      "        p[pr] = p.get(pr, 0) + 1",
      "        x //= pr",
      "    if x != 1: p[x] = 1",
      "    return p",
      "  def primeFactrizationBig(self, x):",
      "    \"\"\"O(√x)で素因数分解\"\"\"",
      "    p = {}",
      "    if x % 2 == 0:",
      "      p[2] = 1",
      "      x //= 2",
      "      while x & 1 == 0:",
      "        x //= 2",
      "        p[2] += 1",
      "    i = 3",
      "    while i * i <= x: # 割った後の x で打ち切る",
      "      if x % i == 0:",
      "        x //= i",
      "        p[i] = 1",
      "        while x % i == 0:",
      "          x //= i",
      "          p[i] += 1",
      "      i += 2",
      "    if x != 1:",
      "      p[x] = 1",
      "    return p",
      "  def factorize(self, x):",
      "    return self.primeFactorization(x)"
    ],
    "description": "素数列挙 + 素因数分解 Prime クラス (N<=5*10**6: 線形篩+lpf表 / それ以上: メモリ節約篩、素因数分解は N**2 まで素数リストで試し割り・それ超は O(√x) 試し割り、x>N の素数判定はミラーラビン)",
    "scope": "python"
  },
  "totu": {
    "prefix": "totu",
    "body": [
      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "import math",
      "def det(p, q):",
      "    return p[0]*q[1] - p[1]*q[0]",
      "def sub(p, q):",
      "    return (p[0]-q[0], p[1]-q[1])",
      "def get_convex_hull(points):",
      "    # どの3点も直線上に並んでいないと仮定する。",
      "    n = len(points)",
      "    points.sort()",
      "    size_convex_hull = 0",
      "    ch = []",
      "    for i in range(n):",
      "        while size_convex_hull > 1:",
      "            v_cur = sub(ch[-1], ch[-2])",
      "            v_new = sub(points[i], ch[-2])",
      "            if det(v_cur, v_new) > 0:",
      "                break",
      "            size_convex_hull -= 1",
      "            ch.pop()",
      "        ch.append(points[i])",
      "        size_convex_hull += 1",
      "    t = size_convex_hull",
      "    for i in range(n-2, -1, -1):",
      "        while size_convex_hull > t:",
      "            v_cur = sub(ch[-1], ch[-2])",
      "            v_new = sub(points[i], ch[-2])",
      "            if det(v_cur, v_new) > 0:",
      "                break",
      "            size_convex_hull -= 1",
      "            ch.pop()",
      "        ch.append(points[i])",
      "        size_convex_hull += 1",
      "    return ch[:-1]",
      "",
      "# 多角形の面積 * 2 (2をかけると必ず整数になる)",
      "def area(points):",
      "  ans = 0",
      "  N = len(points)",
      "  x0, y0 = points[N - 1]",
      "  for i in range(N):",
      "    x1, y1 = points[i]",
      "    ans += (x0 - x1) * (y0 + y1)",
      "    x0, y0 = x1, y1",
      "  return abs(ans)",
      "",
      "# 多角形の線分上の格子点の数の和",
      "def all_points_ontotu(points):",
      "  ans = 0",
      "  N = len(points)",
      "  x0, y0 = points[N - 1]",
      "  for i in range(N):",
      "    x1, y1 = points[i]",
      "    ans += points_online(x0, y0, x1, y1) - 1",
      "    x0, y0 = x1, y1",
      "  return ans",
      "",
      "# 線分上の格子点の数",
      "def points_online(x0, y0, x1, y1):",
      "  return math.gcd(abs(x0 - x1), abs(y0 - y1)) + 1",
      "",
      "# 凸包に含まれる格子点の数",
      "def inner_points(points):",
      "  D = get_convex_hull(points)",
      "  S2 = area(D)",
      "  b = all_points_ontotu(D)",
      "  # ピックの定理で凸包に含まれる格子点の数を求める",
      "  ans = (S2 - b) // 2 + 1",
      "  ans += b # (辺上の格子点を含める)",
      "  return ans"
    ],
    "description": "凸包 (Andrew monotone chain、上下凸包の併合 O(N log N))",
    "scope": "python"
  },
  "touhi": {
