      "  N = len(L)",
      "  D = [0] * N",
      "  n = 1",
      "  V = []",
      "  while D[x] == 0:",
      "    D[x] = n",
      "    V.append(x)",
      "    x = L[x]",
      "    n += 1",
      "  v = D[x] - 1",
      "  head, loop = V[:v], V[v:]",
      "",
      "  D = [0] * N",
      "  for i in range(len(head)):",
      "    D[head[i]] = 1",
      "    K -= 1",
      "    if K == 0: break",
      "  d, m = divmod(K, len(loop))",
      "  for i in range(len(loop)):",
      "    if i < m:",
      "      D[loop[i]] = d + 1",
      "    else:",
      "      D[loop[i]] = d",
      "  return D",
