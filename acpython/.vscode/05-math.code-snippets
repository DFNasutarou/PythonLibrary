  "gyoretu": {
    "prefix": "gyoretu",
    "body": [
      "# 行列累乗",
      "# mat_pow(行列, 累乗)",
      "# MOD を設定しておく",
      "MOD = 998244353",
      "def mat_mul(a, b) :",
      "    I, J, K = len(a), len(b[0]), len(b)",
      "    c = [[0] * J for _ in range(I)]",
      "    for i in range(I) :",
      "        ci = c[i]",
      "        ai = a[i]",
      "        for k in range(K) :",
      "            aik = ai[k]",
      "            if aik == 0: continue",
      "            bk = b[k]",
      "            for j in range(J) :",
      "                ci[j] = (ci[j] + aik * bk[j]) % MOD",
      "    return c",
      "",
      "def mat_pow(x, n):",
      "    y = [[0] * len(x) for _ in range(len(x))]",
      "    for i in range(len(x)):",
      "        y[i][i] = 1",
      "    while n > 0:",
      "        if n & 1:",
      "            y = mat_mul(x, y)",
      "        x = mat_mul(x, x)",
      "        n >>= 1",
      "    return y",
      "",
      "# usage: A = mat_pow(M, k)  # M 正方、k 指数"
    ],
    "description": "行列累乗 mat_pow (ダブリング、MOD は冒頭で要定義)",
    "scope": "python"
  },
  "hakidasi": {
    "prefix": "hakidasi",
    "body": [
      "def hakidasi(L):",
      "  n = len(bin(max(L))) - 2",
      "  k, end = 0, len(L)",
      "  for i in range(n - 1, -1, -1):",
      "    for j in range(k, end):",
      "      if (L[j] >> i) & 1:",
      "        L[k], L[j] = L[j], L[k]",
      "        break",
      "    else:",
      "      continue",
      "    k += 1",
      "    for j in range(k, end):",
      "      if (L[j] >> i) & 1:",
      "        L[j] ^= L[k - 1]",
      "  return L",
      "",
      "# usage: basis = hakidasi(L)"
    ],
    "description": "XOR 掃き出し (整数列を GF(2) 上で階段化、in-place)",
    "scope": "python"
