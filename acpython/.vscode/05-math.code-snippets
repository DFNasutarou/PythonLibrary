      "# 0 <= x <= n 逆元リスト",
      "def invL(n, MOD): ",
      "  I = [0, 1]",
      "  for i in range(2, n + 1):",
      "    I.append(MOD - I[MOD % i] * (MOD // i) % MOD)",
      "  return I",
      "",
      "# アダマール変換",
      "def fwt(f):",
      "  n = len(f)",
      "  i = 1",
      "  while i < n:",
      "    for j in range(n):",
      "      if j & i == 0:",
      "        x, y = f[j], f[j | i]",
      "        f[j], f[j | i]  = x + y, x - y",
      "    i <<= 1",
      "",
