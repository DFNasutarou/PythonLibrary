      "def edist(a, b):",
      "  x = (a[0] - b[0]) ** 2",
      "  y = (a[1] - b[1]) ** 2",
      "  return (x + y) ** (1 / 2)",
      "",
      "def mdist(a, b):",
      "  x = abs(a[0] - b[0])",
      "  y = abs(a[1] - b[1])",
      "  return x + y",
      "",
      "def cdist(a, b):",
      "  ma = abs(a[0] - b[0])",
