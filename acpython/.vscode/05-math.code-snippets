  "convolution": {
    "scope": "python",
    "prefix": "convolution",
    "description": "その他の畳み込み集 (AND / OR / SUBSET, Zeta/Mobius 変換)",
    "body": [
      "class Convolution:",
      "  @staticmethod",
      "  def andProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    and畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans = Convolution.adm(a, b, Hadamard.opAndFwt, Hadamard.opAndIfwt, op) ",
      "    return [a % MOD for a in ans]",
      "  @staticmethod",
      "  def orProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    or畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans = Convolution.adm(a, b, Hadamard.opOrFwt, Hadamard.opOrIfwt, op) ",
      "    return [a % MOD for a in ans]",
      "  @staticmethod",
      "  def xorProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    xor畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans =  Convolution.adm(a, b, Hadamard.opXorFwt, Hadamard.opXorFwt, op)",
      "    I = [0, 1]",
      "    for i in range(2, n + 1):",
      "      I.append(MOD - I[MOD % i] * (MOD // i) % MOD)",
      "    for i in range(n):",
      "      ans[i] *= I[n]",
      "      ans[i] %= MOD",
      "    return ans",
      "  @staticmethod",
      "  def minPlusConv(a: list[int], b: list[int]):",
      "    \"\"\"",
      "    各kに対して、i+j=kとなるai+bjの最小値",
      "    制約: aが下に凸",
      "    \"\"\"",
      "    N = len(a) + len(b) - 1",
      "    M = len(b)",
      "    gen = Convolution.minplus",
      "    data = [a, b]",
      "    def op(old: int, new: int): return old > new",
      "    return Convolution.monge(N, M, gen, data, op)",
      "",
      "  @staticmethod",
      "  def adm(a, b, fwt, ifwt, op):",
      "    Hadamard.fwt(a, fwt)",
      "    Hadamard.fwt(b, fwt)",
      "    ans = op(a, b)",
      "    Hadamard.fwt(ans, ifwt)",
      "    return ans",
      " ",
      "  @staticmethod",
      "  def monge(N: int, M: int, generator, data, op):",
      "    ans = [0] * N",
      "    q = [0, N, 0, M]",
      "    while q:",
      "      r, l, y, x = q.pop(), q.pop(), q.pop(), q.pop()",
      "      res = None",
      "      t = 0",
      "      n = (x + y) // 2",
      "      for i, a in generator(n, l, r, data):",
      "        if res == None or op(res, a):",
      "           res= a",
      "           t = i",
      "      ans[n] = res if res != None else -1 # generatorが値を返せば-1になることはない",
      "      if (x + n) // 2 != n: q.extend([x, n, l, t + 1])",
      "      if (n + y) // 2 != n: q.extend([n + 1, y, t, r])",
      "    return ans",
      "",
      "  @staticmethod",
      "  def minplus(n: int, l: int, r: int, data: list[list[int]]):",
      "    a, b = data",
      "    N = len(a)",
      "    M = len(b)",
      "    for i in range(l, r):",
      "      if not 0 <= i < M: continue",
      "      j = n - i",
      "      if not 0 <= j < N: continue",
      "      yield i, a[j] + b[i]",
      "",
      "class Hadamard:",
      "  @staticmethod",
      "  def opAndFwt(f : list[int], i: int, j: int) : f[j] += f[j | i]",
      "  @staticmethod",
      "  def opAndIfwt(f : list[int], i: int, j: int): f[j] -= f[j | i]",
      "  @staticmethod",
      "  def opOrFwt(f : list[int], i: int, j: int) : f[j | i] += f[j]",
      "  @staticmethod",
      "  def opOrIfwt(f : list[int], i: int, j: int): f[j | i] -= f[j]",
      "  @staticmethod",
      "  def opXorFwt(f : list[int], i: int, j: int) : ",
      "    x, y = f[j], f[j | i]",
      "    f[j], f[j | i]  = x + y, x - y",
      "  @staticmethod",
      "  def fwt(f, op):",
      "    n = len(f)",
      "    i = 1",
      "    while i < n:",
      "      for j in range(n):",
      "        if j & i == 0: op(f, i, j)",
      "      i <<= 1",
      "",
      "# usage: h = Convolution.andProductConv(a, b, MOD)"
    ]
  },
  "gensikon": {
    "scope": "python",
    "prefix": "gensikon",
    "description": "原始根関連 Gensikon (位数判定 / 原始根求解)",
    "body": [
      "class Gensikon:",
      "  #xの原子根を求める",
      "  def primitive_root(x):",
      "    \"\"\"",
      "    xの原子根を求める",
      "    \"\"\"",
      "    L = Gensikon.prime(x - 1)",
      "    a, i = 2, 0",
      "    k = len(L) - 1",
      "    while i != k:",
      "      if pow(a, L[i], x) == 1:",
      "        a += 1",
      "        i = 0",
      "      else:",
      "        i += 1",
      "    return a",
      "  ",
      "  def prime(x):",
      "    L, U = [], []",
      "    i = 1",
      "    while i * i <= x:",
      "      if x % i == 0:",
      "        L.append(i)",
      "        if i != x // i:",
      "          U.append(x // i)",
      "      i += 1",
      "    return L + U[::-1]",
      "",
      "  def solve(X, Y, M):",
      "    \"\"\"",
      "    X^K ≡ Y (mod M) となるような K を求める",
      "    \"\"\"",
      "    D = {1: 0}",
      "    sq = int(M**.5)+1",
      "    # Baby-step",
      "    Z = 1",
      "    for i in range(sq):",
      "      Z = Z * X % M",
      "      D[Z] = i+1",
      "    if Y in D:",
      "      return D[Y]",
      "    # Giant-step",
      "    R = pow(Z, M-2, M) # R = X^(-sq)",
      "    for i in range(1, sq+1):",
      "      Y = Y * R % M",
      "      if Y in D:",
      "          return D[Y] + i*sq",
      "    return -1",
      "",
      "# usage: g = Gensikon.primitive_root(p)"
    ]
  },
  "Packer": {
    "scope": "python",
    "prefix": "Packer",
    "description": "タプル↔整数パッカー (辞書 key 高速化、(a,b) を 1 整数に)",
    "body": [
      "class Packer():",
      "  def __init__(self, N: int = 10**6, size = 2) -> None:",
      "    self.N = N",
      "    self.size = size",
      "    # b < N を満たすために必要なビット数を計算",
      "    bits = (N - 1).bit_length()",
      "    # 最低でも 1 ビットは確保（N=1 のとき bits=0 なので shift=1）",
      "    self.shift = bits if bits > 0 else 1",
      "    # b を取り出すためのマスク (1 << shift) - 1",
      "    self.mask = (1 << self.shift) - 1",
      "  def pack(self, data):",
      "    ans = 0",
      "    for d in data:",
      "      ans = ans << self.shift | d",
      "    return ans",
      "  def unpack(self, packed):",
      "    data = []",
      "    for i in range(self.size - 1):",
      "      data.append(packed & self.mask)",
      "      packed >>= self.shift",
      "    data.append(packed)",
      "    return data[::-1]",
      "",
      "# usage: p = Packer(N=10**6, size=2); k = p.pack(a, b); a, b = p.unpack(k)"
    ]
  },
  "radix_convert": {
    "scope": "python",
    "prefix": "radix_convert",
    "description": "進数変換 Radix_Convert (任意基数 ↔ 10 進の相互変換)",
    "body": [
      "class Radix_Convert:",
      "  @staticmethod",
      "  def toDec(x, n):",
      "    \"\"\"",
      "    n進数を10進数に変換",
      "    \"\"\"",
      "    x = str(x)",
      "    return int(x, n)",
      "  @staticmethod",
      "  def fromDec(x, n):",
      "    \"\"\"",
      "    10進数をn進数に変換",
      "    \"\"\"",
      "    if x == 0:",
      "      return \"0\"",
      "    if n < 2:",
      "      raise ValueError(\"n は 2 以上の自然数でなければなりません\")",
      "    ",
      "    digits = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
      "    if n > len(digits):",
      "      raise ValueError(f\"n は {len(digits)} 以下でなければなりません\")",
      "    ",
      "    res = []",
      "    while x > 0:",
      "      res.append(digits[x % n])",
      "      x //= n",
      "    ans = \"\".join(res[::-1])",
      "    return ans",
      "  @staticmethod",
      "  def n2m(x, n, m):",
      "    \"\"\"",
      "    n進数をm進数に変換",
      "    \"\"\"",
      "    x = Radix_Convert.toDec(x, n)",
      "    return Radix_Convert.fromDec(x, m)",
      "",
      "# usage: dec = Radix_Convert.toDec(x, n); x = Radix_Convert.fromDec(dec, n)"
    ]
  },
  "hakidasi2": {
    "scope": "python",
    "prefix": "hakidasi2",
    "description": "XOR 基底クラス XORBasis (掃き出し法のクラス版、追加/包含/次元)",
    "body": [
      "class XORBasis:",
      "  \"\"\"",
      "  整数リスト x = [x0, x1, ..., x_{m-1}] から GF(2) 上の基底を作り、",
      "  任意のターゲット値 t を x の XOR 組み合わせで表現できるかを判定・復元する。",
      "  \"\"\"",
      "",
      "  def __init__(self, x_list):",
      "    \"\"\"",
      "    :param x_list: list of int",
      "      元になる整数のリスト。各 x_list[i] は非負整数とする。",
      "    \"\"\"",
      "    # 元データをコピー",
      "    self.x = list(x_list)",
      "    self.m = len(self.x)",
      "",
      "    # ビット長を求める（基底構築の際の最大ビット位置）",
      "    # - Python の int は無限長なので、最大ビット位置は個々の要素の bit_length() の最大値 - 1",
      "    max_bl = 0",
      "    for v in self.x:",
      "      bl = v.bit_length()",
      "      if bl > max_bl:",
      "        max_bl = bl",
      "    # もし全て v = 0 だけなら bit_length() = 0 なので、max_bl = 0 → ただちにビットは使わない",
      "    self.max_bit = max_bl - 1  # 最上位ビット位置（0 始まり）",
      "",
      "    # 「各ビット位置 j に対応する基底ベクトル」と「そのベクトルが x のどの要素から作られたか」を保持する配列",
      "    #   basis[j]   = 基底ベクトルとなった整数値（そのビット位置 j のビットが 1）",
      "    #   basis_mask[j]= もとのリスト x のインデックスマスク（ビットマスク: x[i] をいくつ XOR したか）",
      "    # max_bit が負 (= -1) のときは空の基底とみなす",
      "    size = self.max_bit + 1",
      "    self.basis = [0] * size",
      "    self.basis_mask = [0] * size",
      "",
      "    # 実際に「ガウス–ジョルダン（XOR）消去」を行い、基底を構築する",
      "    # 各 x[i] を「自分より高いビットから順に消去していき、残ったら新しい基底に登録」する",
      "    for i, val in enumerate(self.x):",
      "      mask = 1 << i  # 「今これを基底に使うとき、元のどのインデックスを XOR したか」を示すマスク",
      "      v = val",
      "      # 高位ビットから 0 ビットまで順に処理",
      "      for bit in range(self.max_bit, -1, -1):",
      "        if not ((v >> bit) & 1):",
      "          continue  # そのビット位置は 0 → 無視",
      "        if self.basis[bit] == 0:",
      "          # このビット位置を消せる基底がまだない ⇒ 新しい基底として登録",
      "          self.basis[bit] = v",
      "          self.basis_mask[bit] = mask",
      "          break",
      "        # もし basis[bit] がすでに存在するなら、XOR して消去し続行",
      "        v ^= self.basis[bit]",
      "        mask ^= self.basis_mask[bit]",
      "      # もし v が 0 になると、すべて消去されたので（x[i] は既存の基底の組み合わせで表現できる）何もしない",
      "",
      "  def represent(self, target):",
      "    \"\"\"",
      "    :param target: int",
      "      表現したい目標値（非負整数）",
      "    :return: ",
      "      - もし target が x の XOR 組み合わせで表せるなら、",
      "        使用するxを1, それ以外を0としたリストを返す。",
      "      - 表せない場合は None を返す。",
      "    \"\"\"",
      "    # まず、対象をマスク (max_bit+1) ビットに制限する必要は特にないが、",
      "    # 基底構築時と同様に「高いビット」から処理する",
      "    t = target",
      "    mask = 0  # 表現に使う x のインデックスのマスク",
      "",
      "    # 高位ビットから順にターゲットのビットを消去していく",
      "    for bit in range(self.max_bit, -1, -1):",
      "      if not ((t >> bit) & 1):",
      "        continue  # すでに 0 ならパス",
      "      if self.basis[bit] == 0:",
      "        # そのビットを消去できる基底がない → 表現不可能",
      "        return None",
      "      # 消去可能 → XOR してビットを落とす",
      "      t ^= self.basis[bit]",
      "      # 同時に「この基底を作っている x のインデックス集合」を mask に XOR しておく",
      "      mask ^= self.basis_mask[bit]",
      "",
      "    # 最終的に t が 0 になれば表現可能。そのとき mask のビットが 1 の位置を列挙して返す",
      "    if t == 0:",
      "      result = []",
      "      for i in range(self.m):",
      "        if (mask >> i) & 1:",
      "          result.append(1)",
      "        else:",
      "          result.append(0)",
      "      return result",
      "    else:",
      "      # t が非ゼロなら何らかのビットを消去できず → 表現不可能",
      "      return None",
      "",
      "  def get_basis_list(self):",
      "    \"\"\"",
      "    （デバッグ用）内部に構築された基底を「(bit_position, basis_vector, mask)」のリストとして返す。",
      "    \"\"\"",
      "    lst = []",
      "    for bit in range(self.max_bit + 1):",
      "      if self.basis[bit] != 0:",
      "        lst.append((bit, self.basis[bit], self.basis_mask[bit]))",
      "    return lst",
      "",
      "# usage: b = XORBasis(); b.add(x); b.contains(x); b.dim()"
    ]
  },
  "way12": {
    "scope": "python",
    "prefix": "way12",
    "description": "写像 12 相 (n 玉を k 箱に入れる、玉/箱/制約 の 12 通り)",
    "body": [
      "class way12():",
      "  def __init__(self, num, mod):",
      "    self.F = [1, 1]",
      "    self.Fi = [1, 1]",
      "    self.I = [0, 1]",
      "    self.S = None # スターリング数",
      "    self.P = None # 分割数",
      "    self.MOD = mod",
      "    self.num = num",
      "    for i in range(2, num + 1):",
      "      self.F.append((self.F[-1] * i) % mod)",
      "      self.I.append(mod - self.I[mod % i] * (mod // i) % mod)",
      "      self.Fi.append(self.Fi[-1] * self.I[i] % mod)",
      "  def com(self, n, k):",
      "    # n個からk個選ぶ",
      "    if n < k: return 0",
      "    if n < 0 or k < 0: return 0",
      "    return self.F[n] * (self.Fi[k] * self.Fi[n - k] % self.MOD) % self.MOD",
      "  def per(self, n, k):",
      "    # n個からk個並べる",
      "    if n < k: return 0",
      "    if n < 0 or k < 0: return 0",
      "    return self.F[n] * self.Fi[k] % self.MOD ",
      "  def com2(self, n, k):",
      "    ans = 0",
      "    for i in range(1, n + 1):",
      "      t = (-1) ** ((n - i) % 2)",
      "      ans += t * self.com(n, i) * pow(i, k, self.MOD) % self.MOD",
      "    return ans",
      "  def sti(self, n, k):",
      "    \"\"\"",
      "    第二種スターリング数 (nとkが逆らしい)",
      "    O(n)",
      "    \"\"\"",
      "    if self.S != None:",
      "      if (n, k) not in self.S: return 0",
      "      return self.S[n, k]",
      "    if n == 0 and k == 0: return 1",
      "    if k == 0: return 0",
      "    return self.com2(n, k) * self.Fi[n] % MOD",
      "  def sti_init(self):",
      "    P = {}",
      "    for i in range(self.num + 1):",
      "      for j in range(self.num + 1):",
      "        P[i, j] = self.sti(i, j)",
      "    self.S = P",
      "  def bel(self, n, k):",
      "    \"\"\"",
      "    ベル数 (nとkが逆?)",
      "    O(n) 初回だけO(N ^ 2)",
      "    \"\"\"",
      "    if self.S == None: self.sti_init()",
      "    if self.S == None: return 0",
      "    if n == 0 and k == 0: return 1",
      "    ans = 0",
      "    for i in range(1, n + 1):",
      "      ans += self.S[i, k]",
      "      ans %= self.MOD",
      "    return ans",
      "  def part(self, n, k):",
      "    \"\"\"",
      "    kをn個に分割する方法の数",
      "    O(1) 初回だけO(N ^ 2)",
      "    \"\"\" ",
      "    if self.P == None:",
      "      self.P = {}",
      "      for i in range(self.num):",
      "        for j in range(self.num):",
      "          if i == 0:",
      "            if j == 0:",
      "              self.P[i, j] = 1",
      "            else:",
      "              self.P[i, j] = 0",
      "          elif i > j:",
      "            self.P[i, j] = self.P[i - 1, j]",
      "          else:",
      "            self.P[i, j] = (self.P[i - 1, j] + self.P[i, j - i]) % self.MOD",
      "    if n < 0 or k < 0: return 0",
      "    return self.P[n, k]",
      "  def way(self, n : int, k : int, box : bool, ball : bool, limit : int):",
      "    \"\"\"",
      "    n : 箱の数",
      "    k : ボールの数",
      "    box: 箱を区別するならTrue",
      "    ball : ボールを区別するならTrue",
      "    limit : 0 条件なし, 1 1つ以下しか入れない, 2 1つ以上入れる",
      "    \"\"\"",
      "    if box:",
      "      if ball:",
      "        match limit:",
      "          case 0: return pow(n, k, self.MOD)",
      "          case 1: return self.per(n, k)",
      "          case 2: return self.com2(n, k)",
      "      else:",
      "        match limit:",
      "          case 0: return self.com(n + k - 1, k)",
      "          case 1: return self.com(n, k)",
      "          case 2: return self.com(k - 1, n - 1)",
      "    else:",
      "      if ball:",
      "        match limit:",
      "          case 0: return self.bel(n, k)",
      "          case 1: return 1",
      "          case 2: return self.sti(n, k)",
      "      else:",
      "        match limit:",
      "          case 0: return self.part(n, k)",
      "          case 1: return 1",
      "          case 2: return self.part(k, n - k)",
      "    return 0",
      "",
      "# usage: w = way12(N, MOD); w.case_XX(n, k)"
    ]
  },
  "bunkatu": {
    "scope": "python",
    "prefix": "bunkatu",
    "description": "整数分割の列挙 (n を正整数の順不同和で表す全パターンを生成)",
    "body": [
      "class Bunkatu:",
      "  @staticmethod",
      "  def bunkatu(N):",
      "    \"\"\"",
      "    自然数Nを分割する方法のリスト",
      "    \"\"\"",
      "    return Bunkatu._bunkatu_sub(N, 1, [])",
      "",
      "  @staticmethod",
      "  def bunkatu_map(N):",
      "    \"\"\"",
      "    自然数Nを分割する方法をMAPで表したもののリスト",
      "    \"\"\"",
      "    ML = Bunkatu.bunkatu(N)",
      "    RL = []",
      "    for L in ML:",
      "      if len(L) > N: continue",
      "      R = {}",
      "      for d in L:",
      "        if d in R: R[d] += 1",
      "        else: R[d] = 1",
      "      RL.append(R)",
      "    return RL",
      "",
      "  @staticmethod",
      "  def _bunkatu_sub(N, a, D):",
      "    ans = []",
      "    for i in range(a, N):",
      "      if N - i < i: continue",
      "      T = D[:] + [i]",
      "      ans.extend(Bunkatu._bunkatu_sub(N - i, i, T))",
      "    ans.append(D + [N])",
      "    return ans",
      "",
      "# usage: P = Bunkatu.bunkatu(N)  # P[i] = i の分割数"
    ]
  },
  "ragu": {
    "prefix": "ragu",
    "body": [
      "class Inv:",
      "  def __init__(self, mod):",
      "    self.MOD = mod",
      "  def modpow(self, a, n):",
      "    res = 1",
      "    while n > 0:",
      "      if n & 1:",
      "        res = res * a % self.MOD",
      "      a = a * a % self.MOD",
      "      n >>= 1",
      "    return res",
      "  def invx(self, a):",
      "    return self.modpow(a, self.MOD - 2)",
      "  def invpowL(self, a, n): # a^-x (0 <= x <= n)リスト",
      "    ia = self.invx(a)",
      "    L = [1] * (n + 1)",
      "    for i in range(1, n + 1):",
      "      L[i] = L[i - 1] * ia % self.MOD",
      "    return L",
      "  def invL(self, n): # 0 <= x <= n 逆元リスト",
      "    I = [0, 1]",
      "    for i in range(2, n + 1):",
      "      I.append(self.MOD - I[self.MOD % i] * (self.MOD // i) % self.MOD)",
      "    return I",
      "",
      "# ラグ何とか補間 f(x) = y の値からf(T)を求める",
      "def ragu1(x, y, T):",
      "  n = len(x) - 1",
      "  ret = 0",
      "  for i in range(n + 1):",
      "    t = 1",
      "    for j in range(n + 1):",
      "      if i == j: continue",
      "      t *= T - x[j]",
      "      t *= inv.invx(x[i] - x[j])",
      "      t %= MOD",
      "    ret += t * y[i]",
      "    ret %= MOD",
      "  return ret",
      "",
      "# ラグ何とか補間 f(x) = y の値からx^kの係数リストを求める",
      "def ragu2(x, yy):",
      "  y = [yy[i] for i in range(len(yy))]",
      "  n = len(x) - 1",
      "  for i in range(n + 1):",
      "    t = 1",
      "    for j in range(n + 1):",
      "      if i != j: t *= x[i] - x[j]",
      "    t %= MOD",
      "    y[i] *= inv.invx(t)",
      "    y[i] %= MOD",
      "",
      "  cur = 0",
      "  nxt = 1",
      "  dp = [[0] * (n + 2) for _ in range(2)]",
      "  dp[0][0] = -1 * x[0]",
      "  dp[0][1] = 1",
      "  for i in range(1, n + 1):",
      "    for j in range(n + 2):",
      "      dp[nxt][j] = dp[cur][j] * -1 * x[i]",
      "      if j >= 1: dp[nxt][j] += dp[cur][j - 1]",
      "    nxt, cur = cur, nxt",
      "  xinv = inv.invL(len(x))",
      "  ret = [0] * (n + 1)",
      "  for i in range(n + 1):",
      "    if y[i] == 0: continue",
      "    if x[i] == 0:",
      "      for j in range(n + 1): ret[j] += dp[cur][j + 1] * y[i]",
      "    else:",
      "      ret[0] -= dp[cur][0] * xinv[i] * y[i] % MOD",
      "      ret[0] %= MOD",
      "      pre = -1 * dp[cur][0] * xinv[i] % MOD",
      "      for j in range(1, n + 1):",
      "        ret[j] -= (dp[cur][j] - pre) * xinv[i] * y[i] % MOD",
      "        pre = -1 * (dp[cur][j] - pre) * xinv[i] % MOD",
      "        ret[j] %= MOD",
      "  return ret",
      "",
      "x = [0, 1, 2, 3]",
      "y = [1, 3, 5, 7]",
      "",
      "MOD = 998244353",
      "inv = Inv(MOD)",
      "",
      "# usage: y = ragu1(xs, ys, target_x)  # 等間隔なら ragu2"
    ],
    "description": "ラグランジュ補間 (1 次元、O(N) で f(x_target) を求める)",
    "scope": "python"
  }
}
