      "class Convolution:",
      "  # https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "  def __init__(self, MOD):",
      "    self.MOD = MOD",
      "    self.PrimitiveRoot = self.primitive_root(MOD)",
      "    self._BIT_TABLE = [0] * 64",
      "    _BIT_HASH = 0x03F566ED27179461",
      "    for i in range(64):",
      "      self._BIT_TABLE[_BIT_HASH >> 58] = i",
      "      _BIT_HASH <<= 1",
      "      _BIT_HASH &= 0xFFFFFFFFFFFFFFFF",
      "",
      "  def convolution(self, a, b):",
      "    n, m = len(a), len(b)",
      "    if not n or not m: return []",
      "    if min(n, m) <= 60:",
      "      if n < m:",
      "        n, m = m, n",
      "        a, b = b, a",
      "      ans = [0] * (n + m - 1)",
      "      for i in range(n):",
      "        for j in range(m):",
      "          ans[i + j] = (ans[i + j] + a[i] * b[j]) % self.MOD",
      "      return ans",
      "    z = 1 << self.ceil_pow2(n + m - 1)",
      "    a = a + [0] * (z - n)",
      "    a = self.butterfly(a)",
      "    b = b + [0] * (z - m)",
      "    b = self.butterfly(b)",
      "    for i in range(z): a[i] = a[i] * b[i] % self.MOD",
      "    a = self.butterfly_inv(a)",
      "    iz = pow(z, self.MOD - 2, self.MOD)",
      "    for i in range(n + m - 1): a[i] = a[i] * iz % self.MOD",
      "    return a[:n + m - 1]",
      "",
      "  def butterfly(self, a):",
      "    g = self.PrimitiveRoot",
      "    n = len(a)",
      "    h = self.ceil_pow2(n)",
      "",
      "    first = True",
      "    sum_e = [0] * 30",
      "    if first:",
      "      first = False",
      "      es, ies = [0] * 30, [0] * 30",
      "      cnt2 = self.bsf(self.MOD - 1)",
      "      e = pow(g, ((self.MOD - 1) >> cnt2), self.MOD)",
      "      ie = pow(e, self.MOD - 2, self.MOD)",
      "      for i in range(cnt2, 1, -1):",
      "        es[i - 2] = e",
      "        ies[i - 2] = ie",
      "        e = e * e % self.MOD",
      "        ie = ie * ie % self.MOD",
      "      now = 1",
      "      for i in range(cnt2 - 2):",
      "        sum_e[i] = es[i] * now % self.MOD",
      "        now = now * ies[i] % self.MOD",
      "    for ph in range(1, h + 1):",
      "      w, p = 1 << (ph - 1), 1 << (h - ph)",
      "      now = 1",
      "      for ss in range(w):",
      "        offset = ss << (h - ph + 1)",
      "        for i in range(p):",
      "          l = a[i + offset]",
      "          r = a[i + offset + p] * now % self.MOD",
      "          a[i + offset] = (l + r) % self.MOD",
      "          a[i + offset + p] = (l - r) % self.MOD",
      "        now = now * sum_e[self.bsf(~ss)] % self.MOD",
      "    return a",
      "",
      "  def butterfly_inv(self, a):",
      "    g = self.PrimitiveRoot",
      "    n = len(a)",
      "    h = self.ceil_pow2(n)",
      "",
      "    first = True",
      "    sum_ie = [0] * 30",
      "    if first:",
      "      first = False",
      "      es, ies = [0] * 30, [0] * 30",
      "      cnt2 = self.bsf(self.MOD - 1)",
      "      e = pow(g, ((self.MOD - 1) >> cnt2), self.MOD)",
      "      ie = pow(e, self.MOD - 2, self.MOD)",
      "      for i in range(cnt2, 1, -1):",
      "        es[i - 2] = e",
      "        ies[i - 2] = ie",
      "        e = e * e % self.MOD",
      "        ie = ie * ie % self.MOD",
      "      now = 1",
      "      for i in range(cnt2 - 2):",
      "        sum_ie[i] = ies[i] * now % self.MOD",
      "        now = now * es[i] % self.MOD",
      "    for ph in range(h, 0, -1):",
      "      w, p = 1 << (ph - 1), 1 << (h - ph)",
      "      inow = 1",
      "      for ss in range(w):",
      "        offset = ss << (h - ph + 1)",
      "        for i in range(p):",
      "          l = a[i + offset]",
      "          r = a[i + offset + p]",
      "          a[i + offset] = (l + r) % self.MOD",
      "          a[i + offset + p] = (self.MOD + l - r) * inow % self.MOD",
      "        inow = inow * sum_ie[self.bsf(~ss)] % self.MOD",
      "    return a",
      "",
      "  def ceil_pow2(self, n):",
      "    x = 0",
      "    while (1 << x) < n: x += 1",
      "    return x",
      "",
      "  def bsf(self, n):",
      "    if n == 0: return 64",
      "    x = n",
      "    y = x & -x",
      "    i = ((y * 0x03F566ED27179461) & 0xFFFFFFFFFFFFFFFF) >> 58",
      "    return self._BIT_TABLE[i]",
      "",
      "  def prime(self, x):",
      "    L, U = [], []",
      "    i = 1",
      "    while i * i <= x:",
      "      if x % i == 0:",
      "        L.append(i)",
      "        if i != x // i:",
      "          U.append(x // i)",
      "      i += 1",
      "    return L + U[::-1]",
      "",
      "  def primitive_root(self, x):",
      "    L = self.prime(x - 1)",
      "    a, i = 2, 0",
      "    k = len(L) - 1",
      "    while i != k:",
      "      if pow(a, L[i], x) == 1:",
      "        a += 1",
      "        i = 0",
      "      else:",
      "        i += 1",
      "    return a"
    ],
    "description": "畳み込み MOD (NTT、特定 mod 用)",
    "scope": "python"
