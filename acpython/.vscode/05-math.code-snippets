      "# 初項x 公比x 項数t の等比数列の和",
      "def nib(x, t, MOD):",
      "  # [和, その項の値]",
      "  if t == 0: return [0, 1]",
      "  p = nib(x, t >> 1)",
      "  p[0] += p[0] * p[1]",
      "  p[0] %= MOD",
      "  p[1] *= p[1]",
      "  p[1] %= MOD",
      "  if t & 1:",
      "    p[1] *= x",
      "    p[1] % MOD",
      "    p[0] += p[1]",
      "    p[0] %= MOD",
      "  return p",
