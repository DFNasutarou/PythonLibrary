      "    for i in range(n + m - 1): a[i] = a[i] * iz % self.MOD",
      "    return a[:n + m - 1]",
      "",
      "  def butterfly(self, a):",
      "    g = self.PrimitiveRoot",
      "    n = len(a)",
      "    h = self.ceil_pow2(n)",
      "",
      "    first = True",
      "    sum_e = [0] * 30",
      "    if first:",
      "      first = False",
      "      es, ies = [0] * 30, [0] * 30",
      "      cnt2 = self.bsf(self.MOD - 1)",
      "      e = pow(g, ((self.MOD - 1) >> cnt2), self.MOD)",
      "      ie = pow(e, self.MOD - 2, self.MOD)",
      "      for i in range(cnt2, 1, -1):",
      "        es[i - 2] = e",
      "        ies[i - 2] = ie",
      "        e = e * e % self.MOD",
      "        ie = ie * ie % self.MOD",
      "      now = 1",
      "      for i in range(cnt2 - 2):",
      "        sum_e[i] = es[i] * now % self.MOD",
      "        now = now * ies[i] % self.MOD",
