      "class Gensikon:",
      "  #xの原子根を求める",
      "  def primitive_root(x):",
      "    \"\"\"",
      "    xの原子根を求める",
      "    \"\"\"",
      "    L = Gensikon.prime(x - 1)",
      "    a, i = 2, 0",
      "    k = len(L) - 1",
      "    while i != k:",
      "      if pow(a, L[i], x) == 1:",
      "        a += 1",
      "        i = 0",
      "      else:",
      "        i += 1",
      "    return a",
      "  ",
      "  def prime(x):",
      "    L, U = [], []",
      "    i = 1",
      "    while i * i <= x:",
      "      if x % i == 0:",
      "        L.append(i)",
      "        if i != x // i:",
      "          U.append(x // i)",
      "      i += 1",
      "    return L + U[::-1]",
      "",
      "  def solve(X, Y, M):",
      "    \"\"\"",
      "    X^K ≡ Y (mod M) となるような K を求める",
      "    \"\"\"",
      "    D = {1: 0}",
      "    sq = int(M**.5)+1",
      "    # Baby-step",
      "    Z = 1",
      "    for i in range(sq):",
      "      Z = Z * X % M",
      "      D[Z] = i+1",
      "    if Y in D:",
      "      return D[Y]",
      "    # Giant-step",
      "    R = pow(Z, M-2, M) # R = X^(-sq)",
      "    for i in range(1, sq+1):",
      "      Y = Y * R % M",
      "      if Y in D:",
      "          return D[Y] + i*sq",
      "    return -1"
    ]
  },
  "Packer": {
    "scope": "python",
    "prefix": "Packer",
    "description": "配列を整数にする",
    "body": [
      "class Packer():",
      "  def __init__(self, N: int = 10**6, size = 2) -> None:",
      "    self.N = N",
      "    self.size = size",
      "    # b < N を満たすために必要なビット数を計算",
      "    bits = (N - 1).bit_length()",
      "    # 最低でも 1 ビットは確保（N=1 のとき bits=0 なので shift=1）",
      "    self.shift = bits if bits > 0 else 1",
      "    # b を取り出すためのマスク (1 << shift) - 1",
      "    self.mask = (1 << self.shift) - 1",
      "  def pack(self, data):",
      "    ans = 0",
      "    for d in data:",
      "      ans = ans << self.shift | d",
      "    return ans",
      "  def unpack(self, packed):",
      "    data = []",
      "    for i in range(self.size - 1):",
      "      data.append(packed & self.mask)",
      "      packed >>= self.shift",
      "    data.append(packed)",
      "    return data[::-1]"
    ]
  },
