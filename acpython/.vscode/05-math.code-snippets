      "# ------------------------------------------------",
      "# https://github.com/DFNasutarou/PythonLibrary/blob/main/acpython/.vscode/05-math.code-snippets",
      "# ------------------------------------------------",
      "def period(L, K, x = 0):",
      "  # L: 関数グラフ (i -> L[i])、K >= 0",
      "  # 返り値 D: D[v] = 列 x, L[x], L[L[x]], ... の先頭 K 項に v が現れる回数",
      "  N = len(L)",
      "  D = [0] * N",
      "  n = 1",
      "  V = []",
      "  while D[x] == 0:",
      "    D[x] = n",
      "    V.append(x)",
      "    x = L[x]",
      "    n += 1",
      "  v = D[x] - 1",
      "  head, loop = V[:v], V[v:]",
      "",
      "  D = [0] * N",
      "  for i in range(len(head)):",
      "    if K == 0: break",
      "    D[head[i]] = 1",
      "    K -= 1",
      "  d, m = divmod(K, len(loop))",
      "  for i in range(len(loop)):",
      "    if i < m:",
      "      D[loop[i]] = d + 1",
      "    else:",
      "      D[loop[i]] = d",
      "  return D"
    ],
    "description": "周期検出 (関数グラフで x から K 項たどったときの各頂点の訪問回数、K が巨大でも O(N))",
