      "class DFAFactory:",
      "  @staticmethod",
      "  def make_dfa(state_size: int, transitions: dict[tuple[int, str], int], dfa_start_state: int, accept_states: list[int]) -> I_DFA:",
      "    \"\"\"",
      "    DFAを生成するファクトリメソッド。",
      "    - transitions: NFAの遷移関数",
      "    - start_state: 開始状態",
      "    - accept_states: 受理状態集合",
      "    \"\"\"",
      "    class ConcreteDFA(I_DFA):",
      "      def __init__(self):",
      "        self.transitions = transitions",
      "        self.start_state = dfa_start_state",
      "        self.accept_states = set(accept_states)",
      "      def init(self) -> int: ",
      "        return self.start_state",
      "      def next(self, state: int, symbol: str, index: int) -> int: ",
      "        return self.transitions.get((state, symbol), -1)",
      "      def accept(self, state: int) -> bool: ",
      "        return state in self.accept_states",
      "      def unsuccessful(self, state: int) -> bool: ",
      "        return state == -1",
      "      def stateList(self):",
      "        return range(state_size)",
      "    return ConcreteDFA()",
      "",
      "  @staticmethod",
      "  def make_dfa_by_nfa(",
      "      state_size: int,",
      "      alphabet: str,",
      "      transitions: dict[tuple[int, str], list[int]],",
      "      start_state: list[int],",
      "      accept_states: list[int],",
      "      eps: dict[int, list[int]] | None = None",
      "  ) -> I_DFA:",
      "      \"\"\"",
      "      NFAをDFAに変換し、DFAを生成するファクトリメソッド。",
      "      \"\"\"",
      "      dfa_state_size, _, dfa_transitions, dfa_start_state, dfa_accept_states = DFAFactory._nfa_to_dfa(",
      "          state_size, alphabet, transitions, start_state, accept_states, eps or {}",
      "      )",
      "      return DFAFactory.make_dfa(dfa_state_size, dfa_transitions, dfa_start_state, dfa_accept_states)",
      "",
      "  @staticmethod",
      "  def _epsilon_closure(state, transitions, eps):",
      "    \"\"\"",
      "    NFAの1つの状態について、ε-閉包を計算する関数。",
      "    \"\"\"",
      "    stack = [state]  # 初期状態をスタックに追加",
      "    closure = set(stack)  # ε-閉包には少なくとも自身が含まれる",
      "",
      "    while stack:",
      "      current = stack.pop()  # スタックから状態を取り出す",
      "      # 現在の状態からのε遷移を確認",
      "      for next_state in eps.get(current, []):  # epsが存在する場合のみ参照",
      "        if next_state not in closure:  # 未訪問の状態のみ追加",
      "          closure.add(next_state)",
      "          stack.append(next_state)  # 新たに訪問するためスタックに追加",
      "",
      "    return closure",
      "",
      "  @staticmethod",
      "  def _epsilon_closure_set(states, transitions, eps):",
      "    \"\"\"",
      "    NFAの状態集合について、ε-閉包を計算する関数。",
      "    \"\"\"",
      "    closure = set()",
      "    # 各状態についてε-閉包を計算し、全てを統合",
      "    for state in states:",
      "      closure.update(DFAFactory._epsilon_closure(state, transitions, eps))",
      "    return closure",
      "",
      "  @staticmethod",
      "  def _move(states, symbol, transitions):",
      "    \"\"\"",
      "    特定の入力シンボルに基づいて、NFAの状態集合から到達可能な状態集合を計算する関数。",
      "    \"\"\"",
      "    result = set()",
      "    # 各状態からシンボルに対応する遷移先を確認",
      "    for state in states:",
      "      result.update(transitions.get((state, symbol), []))",
      "    return result",
      "",
      "  @staticmethod",
      "  def _nfa_to_dfa(state_size, alphabet, transitions, start_state, accept_states, eps):",
      "    \"\"\"",
      "    ε遷移を含むNFAを同等のDFAに変換する関数。",
      "    入力:",
      "      - state_size: NFAの状態数",
      "      - alphabet: 文字集合（str）",
      "      - transitions: NFAの遷移関数",
      "      - start_state: 開始状態",
      "      - accept_states: 受理状態集合",
      "      - eps: 各状態のε遷移辞書",
      "    戻り値:",
      "      - dfa_state_size: DFAの状態数",
      "      - alphabet: 文字集合（str）",
      "      - transitions: DFAの遷移関数",
      "      - start_state: DFAの開始状態",
      "      - accept_states: DFAの受理状態集合",
      "    \"\"\"",
      "    # ステップ1: ε遷移を除去してεなしのNFAを作成",
      "    new_transitions = defaultdict(list)",
      "",
      "    for state in range(state_size):",
      "      e_closure = DFAFactory._epsilon_closure(state, transitions, eps)  # 各状態のε-閉包を計算",
      "      for symbol in alphabet:",
      "        reachable = set()",
      "        for s in e_closure:",
      "          reachable.update(transitions.get((s, symbol), []))  # シンボルで到達可能な状態を収集",
      "        if reachable:",
      "          new_closure = DFAFactory._epsilon_closure_set(reachable, transitions, eps)  # ε-閉包を計算",
      "          new_transitions[(state, symbol)] = list(new_closure)  # 新たな遷移関数を設定",
      "",
      "    # ステップ2: Powerset Constructionを用いてNFAをDFAに変換",
      "    dfa_states = []  # DFAの状態集合",
      "    dfa_transitions = {}  # DFAの遷移関数",
      "    dfa_start_state = frozenset(DFAFactory._epsilon_closure_set(start_state, transitions, eps))  # 開始状態のε-閉包をDFAの開始状態に設定",
      "    dfa_accept_states = set()  # DFAの受理状態集合",
      "",
      "    unmarked_states = [dfa_start_state]  # 未処理の状態集合",
      "    state_map = {dfa_start_state: 0}  # DFAの状態を整数にマッピング",
      "",
      "    while unmarked_states:",
      "      current = unmarked_states.pop()  # 未処理状態を1つ取り出す",
      "      if current not in dfa_states:",
      "        dfa_states.append(current)  # 処理済みとして追加",
      "",
      "      # 現在の状態が受理状態かどうかをチェック",
      "      if any(s in accept_states for s in current):",
      "        dfa_accept_states.add(state_map[current])",
      "",
      "      # アルファベット内の各シンボルについて遷移を処理",
      "      for symbol in alphabet:",
      "        next_state = frozenset(DFAFactory._move(current, symbol, new_transitions))  # 次の状態を計算",
      "",
      "        if next_state and next_state not in state_map:  # 未訪問の状態なら追加",
      "          state_map[next_state] = len(state_map)",
      "          unmarked_states.append(next_state)  # 新しい状態を未処理リストに追加",
      "",
      "        if next_state:  # 遷移関数を更新",
      "          dfa_transitions[(state_map[current], symbol)] = state_map[next_state]",
      "",
      "    dfa_state_size = len(state_map)  # DFAの状態数",
      "",
      "    return dfa_state_size, alphabet, dfa_transitions, state_map[dfa_start_state], list(dfa_accept_states)",
      "",
      "# usage: nfa = NFA(...); nfa.add_transition(...); ans = nfa.run()"
    ]
  },
  "slopetrick": {
    "scope": "python",
    "prefix": "slopetrick",
    "description": "Slope Trick (区分線形凸関数を左右ヒープで管理、最小値追跡)",
    "body": [
      "import heapq",
      "class HeapQue:",
      "  def __init__(self, is_max = False, default = None):",
      "    self.q = []",
      "    self.mlt = -1 if is_max else 1 # 最大値を管理する場合は反転させる",
      "    self.default = default",
      "  def pop(self): ",
      "    if self.is_empty(): return self.default",
      "    return heapq.heappop(self.q) * self.mlt",
      "  def top(self):",
      "    if self.is_empty(): return self.default",
      "    n = self.pop(); self.push(n); return n",
      "  def push(self, x): heapq.heappush(self.q, x * self.mlt)",
      "  def pushpop(self, x): return heapq.heappushpop(self.q, x * self.mlt) * self.mlt",
      "  def is_empty(self): return self.q == []",
      "  def reset(self): self.q = []",
      "",
      "class SlopeTrick:",
      "  def __init__(self, default = None):",
      "    self.L = HeapQue(True, default)",
      "    self.R = HeapQue(False, default)",
      "    self.min = 0; self.add_L = 0; self.add_R = 0",
      "    self.default = default",
      "  def get_min(self):",
      "    \"\"\"",
      "    最小値を返す",
      "    \"\"\"",
      "    return self.min",
      "  def get_min_range(self):",
      "    \"\"\"",
      "    最小値を満たす範囲l, rを返す",
      "    \"\"\"",
      "    l = self.L.top()",
      "    r = self.R.top()",
      "    return l, r",
      "  def add_constant(self, a):",
      "    \"\"\"",
      "    全体にaを追加する",
      "    \"\"\"",
      "    self.min += a",
      "  def add_right(self, a):",
      "    \"\"\"",
      "    点aから右上がりの直線を追加する",
      "    \"\"\"",
      "    if not self.L.is_empty(): self.min += max(0, self.L.top() - a)",
      "    n = self.L.pushpop(a)",
      "    self.R.push(n)",
      "  def add_left(self, a):",
      "    \"\"\"",
      "    点aから左上がりの直線を追加する",
      "    \"\"\"",
      "    if not self.R.is_empty(): self.min += max(0, a - self.R.top())",
      "    n = self.R.pushpop(a)",
      "    self.L.push(n)",
      "  def add_absolute(self, a):",
      "    \"\"\"",
      "    点aから両上がりの直線を追加する",
      "    \"\"\"",
      "    self.add_right(a)",
      "    self.add_left(a)",
      "  def comulative_minimum(self, reverse = False):",
      "    \"\"\"",
      "    累積最小値",
      "    reverse = Trueの場合は右側累積最小値",
      "    \"\"\"",
      "    if reverse: self.L.reset()",
      "    else: self.R.reset()",
      "  def slide(self, a, b):",
      "    self.add_L += a",
      "    self.add_R += b",
      "  def debug(self):",
      "    print(self.min, self.L.q, self.R.q)",
      "",
      "# usage: st = SlopeTrick(); st.add_left(a); st.add_right(a); st.min()"
    ]
  },
  "LIS": {
    "scope": "python",
    "prefix": "LIS",
    "description": "最長増加部分列 LIS (bisect で O(N log N))",
    "body": [
      "import bisect",
      "",
      "class LIS:",
      "  @ staticmethod",
      "  def lis(A):",
      "    \"\"\"",
      "    各要素を末尾にもつ最長増加部分列の長さのリストを返す",
      "    \"\"\"",
      "    return LIS.lis_ext(A)[1]",
      "  @ staticmethod",
      "  def lis_max(A):",
      "    \"\"\"",
      "    各要素の最長増加部分列の長さのリストを返す",
      "    ※各要素が末尾にくるとは限らない",
      "    \"\"\"",
      "    ans = LIS.lis(A)",
      "    for i in range(1, len(A)):",
      "      ans[i] = max(ans[i - 1], ans[i])",
      "    return ans",
      "  @ staticmethod",
      "  def lis_min_ind(A):",
      "    \"\"\"",
      "    各長さの最長部分増加列を持つ最小の要素番号を返す",
      "    1-indexed",
      "    \"\"\"",
      "    return LIS.lis_ext(A)[0]",
      "  @ staticmethod",
      "  def lis_length(A):",
      "    \"\"\"",
      "    最長部分増加列の長さを返す",
      "    \"\"\"",
      "    return len(LIS.lis_ext(A)[0])",
      "",
      "  @ staticmethod",
      "  def lis_ext(A):",
      "    N = len(A)",
      "    LIS = [A[0]]",
      "    data = [0] * N",
      "    for i in range(len(A)):",
      "      if A[i] > LIS[-1]:",
      "        LIS.append(A[i])",
      "        data[i] = len(LIS)",
      "      else:",
      "         n = bisect.bisect_left(LIS, A[i])",
      "         LIS[n] = A[i]",
      "         data[i] = n + 1",
      "    return LIS, data",
      "",
      "# usage: lis = LIS(); lis.add(x); length = lis.length()"
    ]
  },
  "cht": {
    "prefix": "cht",
    "description": "Convex Hull Trick (傾き単調なら直線追加 O(1)、min/max クエリ)",
    "scope": "python",
    "body": [
      "class CHT:",
      "  # 最大値 を取得",
      "  def __init__(self):",
      "    self.L = []",
      "    self.cnt = 0",
      "  # ax + b の直線を追加",
      "  # aが昇順になるように追加すること",
      "  def add(self, a, b):",
      "    ab3 = [a, b]",
      "    while len(self.L) >= 2:",
      "      ab1 = self.L[-2]",
      "      ab2 = self.L[-1]",
      "      x1 = self.renritu(ab1, ab2)",
      "      x2 = self.renritu(ab2, ab3)",
      "      if x1 < x2: break",
      "      self.L.pop()",
      "    self.L.append(ab3)",
      "  # xの最大値を取得",
      "  # 前回チェックしたxより小さい値はチェックできない",
      "  def check(self, x):",
      "    a = self.func(x, self.cnt)",
      "    while self.cnt < len(self.L) - 1:",
      "      b = self.func(x, self.cnt + 1)",
      "      if a > b: break",
      "      self.cnt += 1",
      "      a = b",
      "    return a",
      "  def renritu(self, ab1, ab2):",
      "    a1, b1 = ab1",
      "    a2, b2 = ab2",
      "    return (b2 - b1) / (a1 - a2)",
      "  def func(self, x, n):",
      "    a, b = self.L[n]",
      "    return a * x + b",
      "",
      "# usage: cht = CHT(); cht.add(a, b); v = cht.query(x)"
    ]
  }
}
