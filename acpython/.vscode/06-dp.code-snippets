  "treedp": {
    "prefix": "treedp",
    "body": [
      "class Tree:",
      "  def __init__(self, num):",
      "    self.N = num",
      "    self.C = {}",
      "    self.RL = {}",
      "  # 隣接リストから木作成 1-indexedならindex = 1にする",
      "  def setByAdjacencyList(self, list, index = 0):",
      "    for u, v in list:",
      "      u -= index",
      "      v -= index",
      "      self.set(u, v)",
      "  # 親リストから木作成 1-indexedならindex = 1にする",
      "  def setByParentList(self, list, index = 0):",
      "    for i in range(self.N - 1):",
      "      self.set(i + 1, list[i] - index)",
      "  def set(self, a, b):",
      "    if a in self.C: self.C[a].append(b)",
      "    else: self.C[a] = [b]",
      "    if b in self.C: self.C[b].append(a)",
      "    else: self.C[b] = [a]",
      "  def makeRank(self, root):",
      "    self.R = [-1] * self.N #各ノードのランク",
      "    self.R[root] = 0",
      "    self.RL[0] = [root] #各ランクのノード",
      "    self.S = {} #各ノードの子ノード",
      "    self.P = [-1] * self.N #各ノードの親ノード",
      "    self.D = 0",
      "    while self.RL[self.D] != []:",
      "      self.D += 1",
      "      self.RL[self.D] = []",
      "      for i in self.RL[self.D - 1]:",
      "        for j in self.C[i]:",
      "          if self.R[j] == -1:",
      "            self.R[j] = self.D",
      "            self.RL[self.D].append(j)",
      "            if i not in self.S: self.S[i] = [j]",
      "            else: self.S[i].append(j)",
      "            self.P[j] = i     ",
      "  def bottomUpDP(self):",
      "    for i in range(self.D - 1, -1, -1):",
      "      T = self.RL[i]",
      "      for j in T:",
      "        if j not in self.S: continue",
      "        for k in self.S[j]:",
      "          self.dp_sub_exe(j, k)",
      "  def topDownDP(self):",
      "    for i in range(1, self.D):",
      "      T = self.RL[i]",
      "      for j in T:",
      "        self.dp_sub_exe_inv(j, self.P[j])",
      "  def allDP(self):",
      "    self.dp_init()",
      "    self.bottomUpDP()",
      "    self.topDownDP()",
      "    return self.DP",
      "  def dp_init(self): #単位元で初期化",
      "    self.DP = [1] * self.N",
      "  def dp_sub_exe(self, x, y): #ボトムアップの処理",
      "    self.DP[x] += self.DP[y]",
      "  def dp_sub_exe_inv(self, x, y): #トップダウンの処理",
      "    self.DP[x] += self.DP[y]",
      "  def inv(self, a, mod): #逆元",
      "    return pow(a, mod - 2, mod)",
      "",
      "# usage: t = Tree(N); t.set(u, v); ans = t.dp(root)"
    ],
    "description": "木 DP (子の DFS 結果から親へ集約する典型木 DP テンプレ)",
    "scope": "python"
  },
