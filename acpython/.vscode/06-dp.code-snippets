    "description": "オートマトン DP (桁 DP 含む、I-DFA を構築して状態遷移で集計)",
    "body": [
      "from collections import defaultdict",
      "import itertools ",
      "class I_DFA:",
      "  \"\"\"",
      "  M=(Q,Σ,δ,q0,F) であって、以下の性質を満たすものを DFA とする。",
      "  Q:有限集合（状態集合） -> stateが取りうる値",
      "  Σ:有限集合（文字集合） -> alphabet",
      "  δ:QxΣ→Q（遷移関数）   -> next",
      "  q0∈Q（初期状態）     -> init時のstate",
      "  F⊂Q（受理状態の集合） -> accept",
      "  参考 https://shino16.github.io/blog/post/algo/%E3%82%AA%E3%83%BC%E3%83%88%E3%83%9E%E3%83%88%E3%83%B3/#%E3%82%84%E3%81%A3%E3%81%A6%E3%81%BF%E3%82%88%E3%81%86%E6%A1%81dp%E3%81%A3%E3%81%BD%E3%81%84%E3%82%84%E3%81%A4",
      "  \"\"\"",
      "  def __init__(self):",
      "    pass",
      "  def init(self) -> int:",
      "    \"\"\"初期状態を返す\"\"\"",
      "    raise NotImplementedError",
      "  def next(self, state, alphabet: str, index: int) -> int:",
      "    \"\"\"状態遷移を返す\"\"\"",
      "    raise NotImplementedError",
      "  def accept(self, state) -> bool:",
      "    \"\"\"現在の状態が受理状態か確認する\"\"\"",
      "    raise NotImplementedError",
      "  def successful(self, state) -> bool:",
      "    \"\"\"探索を続けるべきか確認する\"\"\"",
      "    return True",
      "  def unsuccessful(self, state) -> bool:",
      "    \"\"\"探索を終了すべきか確認する\"\"\"",
      "    return False",
      "  def stateList(self): ",
      "    raise NotImplementedError",
      "",
      "class DFA:",
      "  ALP_DIGIT   = \"0123456789\"",
      "  ALP_ABC     = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
      "  ALP_ABC_LOW = \"abcdefghijklmnopqrstuvwxyz\"",
      "  @staticmethod",
      "  def count(dfa: I_DFA, n, alphabet, mod = -1) -> int:",
      "    \"\"\"",
      "    数え上げの実行",
      "    dfa : 決定性有限オートマトン",
      "    n : ループ回数（桁DPの桁数）",
      "    alphabet : 文字集合 (数値なら\"0123456789\")",
      "    mod : MODを取る値 指定しなければMODを取らずに数え上げる",
      "    \"\"\"",
      "    ",
      "    states = tuple(dfa.stateList())",
      "    N = len(states)",
      "    dic = {v: i for i, v in enumerate(states)}",
      "    dp = [0] * N",
      "    dp[dic[dfa.init()]] = 1",
      "    dp2 = [0] * N",
      "    for i in range(n):",
      "      for ind, s in enumerate(states):",
      "        if dp[ind] == 0: continue",
      "        for a in alphabet:",
      "          s1 = dfa.next(s, a, i)",
      "          if dfa.unsuccessful(s1): continue",
      "          key = dic[s1]",
      "          dp2[key] += dp[ind]",
      "          if mod >= 1: dp2[key] %= mod",
      "      dp, dp2 = dp2, dp",
      "      for i in range(N): dp2[i] = 0",
      "    ans = 0",
      "    for i, s in enumerate(states):",
      "      k = dp[i]",
      "      if dfa.accept(s):",
      "        ans += k",
      "        if mod >= 1: ans %= mod",
      "    return ans",
      "  @staticmethod",
      "  def count_sum(dfa: I_DFA, n, alphabet, mod = -1) -> int:",
      "    \"\"\"",
      "    数え上げの実行 該当する値の合計値を数え上げる",
      "    dfa : 決定性有限オートマトン",
      "    n : ループ回数（桁DPの桁数）",
      "    alphabet : 文字集合 (数値限定\"0123456789\"など)",
      "    mod : MODを取る値 指定しなければMODを取らずに数え上げる",
      "    \"\"\"",
      "    ",
      "    base = len(alphabet)",
      "    states = tuple(dfa.stateList())",
      "    N = len(states)",
      "    dic = {v: i for i, v in enumerate(states)}",
      "    dp = [[0] * 2 for _ in range(N)]",
      "    dp[dic[dfa.init()]][0] = 1",
      "    dp2: list[list[int]] = [[0] * 2 for _ in range(N)]",
      "    for i in range(n):",
      "      for ind, s in enumerate(states):",
      "        if dp[ind][0] == 0: continue",
      "        for a in alphabet:",
      "          s1 = dfa.next(s, a, i)",
      "          if dfa.unsuccessful(s1): continue",
      "          key = dic[s1]",
      "          dp2[key][0] += dp[ind][0]",
      "          dp2[key][1] += (dp[ind][1] * base + dp[ind][0] * int(a)) % mod",
      "          if mod >= 1:",
      "            dp2[key][0] %= mod",
      "            dp2[key][1] %= mod",
      "      dp, dp2 = dp2, dp",
      "      for i in range(N): dp2[i] = [0, 0]",
      "    ans = 0",
      "    for i, s in enumerate(states):",
      "      k = dp[i][1]",
      "      if dfa.accept(s):",
      "        ans += k",
      "        if mod >= 1: ans %= mod",
      "    return ans",
      "  @staticmethod",
      "  def count_list(dfa: I_DFA, n, alphabet, op, mod = -1) -> dict:",
      "    \"\"\"",
      "    数え上げの実行 opで条件を指定して、各keyに結果を振り分ける",
      "    dfa : 決定性有限オートマトン",
      "    n : ループ回数（桁DPの桁数）",
      "    alphabet : 文字集合 (数値なら\"0123456789\")",
      "    op : stateを受け取ってkeyを返す",
      "    mod : MODを取る値 指定しなければMODを取らずに数え上げる",
      "    \"\"\"",
      "    states = tuple(dfa.stateList())",
      "    N = len(states)",
      "    dic = {v: i for i, v in enumerate(states)}",
      "    dp = [0] * N",
      "    dp[dic[dfa.init()]] = 1",
      "    dp2 = [0] * N",
      "    for i in range(n):",
      "      for ind, s in enumerate(states):",
      "        if dp[ind] == 0: continue",
      "        for a in alphabet:",
      "          s1 = dfa.next(s, a, i)",
      "          if dfa.unsuccessful(s1): continue",
      "          key = dic[s1]",
      "          dp2[key] += dp[ind]",
      "          if mod >= 1: dp2[key] %= mod",
      "      dp, dp2 = dp2, dp",
      "      for i in range(N): dp2[i] = 0",
      "    ans = defaultdict(int)",
      "    for i, s in enumerate(states):",
      "      k = dp[i]",
      "      if dfa.accept(s):",
      "        key = op(s)",
      "        ans[key] += k",
      "        if mod >= 1: ans[key] %= mod",
      "    return ans",
      "  class And(I_DFA):",
      "    \"\"\"",
      "    複数条件を満たす状態の数え上げ",
      "    三つ以上の場合は入れ子にすることで対応",
      "    \"\"\"",
      "    def __init__(self, A : I_DFA, B : I_DFA):",
      "      self.A = A",
      "      self.B = B",
      "    def init(self): return (self.A.init(), self.B.init())",
      "    def next(self, state, symbol, i):",
      "      return (self.A.next(state[0], symbol, i), self.B.next(state[1], symbol, i))",
      "    def accept(self, state) -> bool:",
      "      return self.A.accept(state[0]) and self.B.accept(state[1])",
      "    def successful(self, state) -> bool:",
      "      return self.A.successful(state[0]) and self.B.successful(state[1])",
      "    def unsuccessful(self, state) -> bool:",
      "      return self.A.unsuccessful(state[0]) or self.B.unsuccessful(state[1])",
      "    def stateList(self):",
      "      return itertools.product(self.A.stateList(), self.B.stateList())",
      "  class Not(I_DFA):",
      "    \"\"\"",
      "    否定条件(テスト未実施)",
      "    \"\"\"",
      "    def __init__(self, dfa : I_DFA):",
      "      self._dfa: I_DFA = dfa",
      "    def init(self):",
      "      return self._dfa.init()",
      "    def next(self, state : int, symbol : str, i : int):",
      "      return self._dfa.next(state, symbol, i)",
      "    def accept(self, state) -> bool: return not self._dfa.accept(state)",
      "    def successful(self, state) -> bool: return self._dfa.unsuccessful(state)",
      "    def unsuccessful(self, state) -> bool: return self._dfa.successful(state)",
      "  class Leq(I_DFA):",
      "    \"\"\"",
      "    N以下の整数を数えあげるオートマトン",
      "    alphabetの進数に合わせる",
      "    \"\"\"",
      "    def __init__(self, N: int | str):",
      "      self._n = str(N)",
      "    def init(self):",
      "      return 0",
      "    def next(self, state : int, symbol : str, i : int):",
      "      if state != 0: return state",
      "      if symbol > self._n[i]: return 1",
      "      elif symbol < self._n[i]: return -1",
      "      else: return 0",
      "    def accept(self, state) -> bool: return state != 1",
      "    def successful(self, state) -> bool: return state == -1",
      "    def unsuccessful(self, state) -> bool: return state == 1",
      "    def stateList(self): return [-1, 0]",
      "  class Deb(I_DFA):",
      "    \"\"\"",
      "    デバッグ用",
      "    \"\"\"",
      "    def init(self):",
      "      return 0",
      "    def next(self, state : int, alphabet : str, i : int):",
      "      return state * 10 + int(alphabet)",
      "    def accept(self, state) -> bool: return True",
      "    def unsuccessful(self, state) -> bool: return False",
      "",
      "  class DigitSumMultipleOF(I_DFA):",
      "    \"\"\"",
      "    桁和がNの倍数を数えあげるオートマトン",
      "    \"\"\"",
      "    def __init__(self, N: int | str): self._n = int(N)",
      "    def init(self)  -> int: return 0",
      "    def next(self, state, symbol, i): return (state + int(symbol)) % self._n ",
      "    def accept(self, state) -> bool: return state == 0",
      "    def stateList(self): return range(self._n)",
      "  class SumMultipleOF(I_DFA):",
      "    \"\"\"",
      "    値がNの倍数を数えあげるオートマトン",
      "    \"\"\"",
      "    def __init__(self, N: int | str): self._n = int(N)",
      "    def init(self)  -> int: return 0",
      "    def next(self, state, alphabet, i): return (state * 10 + int(alphabet)) % self._n ",
      "    def accept(self, state) -> bool: return state == 0",
      "    def stateList(self): return range(self._n)",
      "  class DigitSumOF(I_DFA):",
      "    \"\"\"",
      "    桁和がNを数えあげるオートマトン",
      "    二進数ならpopcountになる",
      "    \"\"\"",
      "    def __init__(self, N: int | str): self._n = int(N)",
      "    def init(self)  -> int: return 0",
      "    def next(self, state, alphabet, i): return state + int(alphabet) ",
      "    def accept(self, state) -> bool: return state == self._n",
      "    def unsuccessful(self, state) -> bool: return state == self._n + 1",
      "    def stateList(self): return range(self._n + 1)",
      "",
      "# usage: dfa = I_DFA(...); dfa.add_transition(s, c, t); ans = dfa.run(N)"
    ]
