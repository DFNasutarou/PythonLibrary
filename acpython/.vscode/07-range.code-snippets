  "mo": {
    "prefix": "mo",
    "body": [
      "class Mo:",
      "  # Mo(N, Query): Query は (l, r) の列。1-indexed 半開区間 [l, r) = 要素 l..r-1 (1 <= l <= r <= N+1)",
      "  #   区間は空 [1, 1) から始まり、l_plus/l_minus/r_plus/r_minus で 1 ずつ伸縮して各クエリ区間に合わせる",
      "  # getAns(): 各クエリの答えのリストを返す (入力順)",
      "  # 以下はサブクラスでオーバーライドして使う拡張点:",
      "  # ini(): 初期化 / l_plus,l_minus,r_plus,r_minus(): 区間の伸縮時の処理 / anser(i): i番目の答えを確定させる",
      "  def __init__(self, N, Query):",
      "    self.N = N",
      "    self.Query = Query",
      "    self.Q = len(Query)",
      "    n = max(1, int(N ** (1 / 2)))",
      "    B = [[] for _ in range(N // n + 1)]",
      "    i = 0",
      "    for que in Query:",
      "      t = que[0]",
      "      p = (t - 1) // n",
      "      B[p].append(list(que) + [i])",
      "      i += 1",
      "    for i in range(len(B)):",
      "      B[i].sort(key = lambda x:x[1])",
      "      if i % 2:",
      "        B[i].reverse()",
      "    self.ini()",
      "    for b in B:",
      "      for x, y, i in b:",
      "        if self.l > x:",
      "          for _ in range(self.l - x):",
      "            self.l_minus()",
      "        if self.r > y:",
      "          for _ in range(self.r - y):",
      "            self.r_minus()",
      "        if self.r < y:",
      "          for _ in range(y - self.r):",
      "            self.r_plus()",
      "        if self.l < x:",
      "          for _ in range(x - self.l):",
      "            self.l_plus()",
      "        self.anser(i)",
      "  def getAns(self):",
      "    return self.Ans",
      "  def anser(self, i):",
      "    self.Ans[i] = self.ans",
      "  def ini(self):",
      "    self.l, self.r = 1, 1",
      "    self.Ans = [0] * self.Q",
      "    self.ans = 0",
      "  def l_plus(self):",
      "    self.l += 1",
      "  def l_minus(self):",
      "    self.l -= 1",
      "  def r_plus(self):",
      "    self.r += 1",
      "  def r_minus(self):",
      "    self.r -= 1",
      "",
      "# usage",
      "# A = [0] + A  # 1-indexed にする",
      "# class MyMo(Mo):  # 例: 区間和",
      "#   def l_plus(self): self.ans -= A[self.l]; self.l += 1   # 要素 l を除く",
      "#   def l_minus(self): self.l -= 1; self.ans += A[self.l]  # 要素 l-1 を加える",
      "#   def r_plus(self): self.ans += A[self.r]; self.r += 1   # 要素 r を加える",
      "#   def r_minus(self): self.r -= 1; self.ans -= A[self.r]  # 要素 r-1 を除く",
      "# Query = [(l, r + 1) for l, r in LR]  # 閉区間 [l, r] (1-indexed) の入力なら r + 1 にする",
      "# ans = MyMo(N, Query).getAns()"
    ],
    "description": "Mo's algorithm (区間クエリのオフライン処理、クエリは 1-indexed 半開区間 [l, r)、√N ブロック並べ替え O((N + Q)√N))",
    "scope": "python"
  },
  "rangeaffine": {
    "scope": "python",
    "prefix": "rangeaffine",
    "description": "区間 min/max の総和 RangeAffine (一列の N+1 点と辺重み L について、各点から他の全点へのパス上の min / max の総和を O(N) で全点分求める)",
    "body": [
      "class RangeAffine:",
      "  # 区間 min/max の総和 (一列に並んだ N+1 点、点 i と i+1 の間の重みが L[i])",
      "  #   range_min_sum_list(L): 各点 i について、全ての j != i への区間 L[min(i,j):max(i,j)] の最小値の和のリスト(長さ N+1)を返す O(N)",
      "  #   range_max_sum_list(L): 同様に最大値の和のリストを返す O(N)",
      "  @ staticmethod",
      "  def range_min_sum_list(L):",
      "    \"\"\"",
      "    最小和",
      "    N+1個の点が一列に並んでいて、点間の重みのリストL(要素数N)が与えられたとき、",
      "    各点iについて、以下の答えを求めて、答えのリストを返す。",
      "     各点j(i!=j)について、i-j_path上の重みの最小値の和",
      "     O(N)",
      "    \"\"\"",
      "    X= RangeAffine._range_min_sum_list(L)",
      "    Y = RangeAffine._range_min_sum_list(L[::-1])",
      "    for i in range(len(L)): X[i] += Y[-1-i]",
      "    return X",
      "  ",
      "  @ staticmethod",
      "  def range_max_sum_list(L):",
      "    \"\"\"",
      "    最大和",
      "    N+1個の点が一列に並んでいて、点間の重みのリストL(要素数N)が与えられたとき、",
      "    各点iについて、以下の答えを求めて、答えのリストを返す。",
      "     各点j(i!=j)について、i-j_path上の重みの最大値の和",
      "     O(N)",
      "    \"\"\"",
      "    X= RangeAffine._range_max_sum_list(L)",
      "    Y = RangeAffine._range_max_sum_list(L[::-1])",
      "    for i in range(len(L)): X[i] += Y[-1-i]",
      "    return X",
      "",
      "  @ staticmethod",
      "  def _range_min_sum_list(L):",
      "    \"\"\"",
      "    各iについて、0 <= j < i のrange_min(j, i)の合計を求める",
      "    \"\"\"",
      "    N = len(L)",
      "    D = []",
      "    ans = [0] * (N + 1)",
      "    sm = 0",
      "    for i in range(N):",
      "      n = 1",
      "      while D:",
      "        if D[-1][0] >= L[i]:",
      "          sm -= D[-1][0] * D[-1][1]",
      "          n += D[-1][1]",
      "          D.pop()",
      "        else: break",
      "      sm += L[i] * n",
      "      D.append([L[i], n])",
      "      ans[i + 1] = sm",
      "    return ans",
      "  ",
      "  @ staticmethod",
      "  def _range_max_sum_list(L):",
      "    \"\"\"",
      "    各iについて、0 <= j < i のrange_max(j, i)の合計を求める",
      "    \"\"\"",
      "    N = len(L)",
      "    D = []",
      "    ans = [0] * (N + 1)",
      "    sm = 0",
      "    for i in range(N):",
      "      n = 1",
      "      while D:",
      "        if D[-1][0] <= L[i]:",
      "          sm -= D[-1][0] * D[-1][1]",
      "          n += D[-1][1]",
      "          D.pop()",
      "        else: break",
      "      sm += L[i] * n",
      "      D.append([L[i], n])",
      "      ans[i + 1] = sm",
      "    return ans",
      "",
      "# usage",
      "# m = RangeAffine.range_min_sum_list(L)  # 長さ len(L) + 1",
      "# M = RangeAffine.range_max_sum_list(L)",
      "# total = sum(m) // 2  # 全区間 (i < j) の min の総和"
    ]
  },
  "imos2d": {
    "scope": "python",
    "prefix": "imos2d",
    "description": "2D いもす法 (矩形加算 + 累積和、計算 O(HW))",
    "body": [
      "class Imos2D:",
      "  # add(h1, w1, h2, w2, value): 矩形範囲[h1,h2)x[w1,w2)に value を加算する (0-indexed 半開、範囲外は自動クランプ)",
      "  # get_data(): 累積和を取って現在の2次元配列を返す",
      "  def __init__(self, H, W) -> None:",
      "    self.H = H",
      "    self.W = W",
      "    self.Data = [[0] * (W + 1) for _ in range(H + 1)]",
      "  def add(self, h1, w1, h2, w2, value) -> None:",
      "    # 指定範囲に加算",
      "    # 範囲外は [0, H] x [0, W] にクランプし、空矩形なら何もしない",
      "    h1 = min(max(h1, 0), self.H)",
      "    w1 = min(max(w1, 0), self.W)",
      "    h2 = min(max(h2, 0), self.H)",
      "    w2 = min(max(w2, 0), self.W)",
      "    if h1 >= h2 or w1 >= w2: return",
      "    self.Data[h1][w1] += value",
      "    self.Data[h1][w2] -= value",
      "    self.Data[h2][w1] -= value",
      "    self.Data[h2][w2] += value",
      "  def get_data(self):",
      "    # 現在の結果を取得",
      "    ret = [d[:self.W] for d in self.Data[:self.H]]",
      "    for i in range(self.H):",
      "      for j in range(1, self.W):",
      "        ret[i][j] += ret[i][j - 1]",
      "    for j in range(self.W):",
      "      for i in range(1, self.H):",
      "        ret[i][j] += ret[i - 1][j]",
      "    return ret",
      "",
      "# usage",
      "# im = Imos2D(H, W)",
      "# im.add(r1, c1, r2, c2, v)",
      "# G = im.get_data()"
    ]
  },
  "squaresplit": {
    "scope": "python",
    "prefix": "squaresplit",
    "description": "グラフの次数による平方分割 Square Split (クラス名は互換のため SquareSpilit、頂点更新を隣接頂点へ伝播、graph スニペットの GraphData(重みなし) 前提、1 クエリ O(√N + M/√N))",
    "body": [
      "class SquareSpilit:",
      "  # 次数が √N 以上の頂点(重い頂点)は隣接頂点へ push せず、隣接頂点側がクエリ時に pull することで 1 クエリ O(√N + M/√N) にする",
      "  #   SquareSpilit(gf, qs): gf は graph スニペットの GraphData (重みなし: adj_list[i] が頂点番号のリスト)、qs は Query_solve",
      "  #   query(q): クエリ q を処理し、qs.solve_myself の戻り値を返す",
      "  #   Query_solve: クエリ内容に応じて書き換える部分。デフォルトは「頂点 a の現在値を返し、a と隣接頂点を value にする」(初期値 1)",
      "  class Query_solve:",
      "    def __init__(self, N):",
      "      self.data = [1] * N # 現在の値",
      "      self.time = [-1] * N # 現在の値が更新された時間",
      "      self.effort = [1] * N # 自分が影響を与える値",
      "      self.effort_time = [-1] * N #自分が影響を与える値が更新された時間",
      "      self.count = 0",
      "    def effort_other(self, a, b, value):",
      "      \"\"\"",
      "      aが更新されたときのbへの影響を記述する",
      "      \"\"\"",
      "      self.data[b] = self.effort[a]",
      "      self.time[b] = self.effort_time[a]",
      "    def solve_myself(self, a, value):",
      "      \"\"\"",
      "      aが更新されたときのa自身への影響を記述する",
      "      \"\"\"",
      "      ans = self.data[a]",
      "      self.data[a] = value",
      "      self.time[a] = self.count",
      "      self.effort[a] = value",
      "      self.effort_time[a] = self.count",
      "      self.count += 1",
      "      return ans",
      "    def solve_other(self, a, b, value):",
      "      \"\"\"",
      "      aが更新されるとき、bの更新の影響を取りに行く",
      "      \"\"\"",
      "      if self.time[a] < self.effort_time[b]:",
      "        self.time[a] = self.effort_time[b]",
      "        self.data[a] = self.effort[b]",
      "    def get_index(self, q):",
      "      \"\"\"",
      "      クエリから変更されたノードのインデックスを取得",
      "      \"\"\"",
      "      return q[0]",
      "    def get_value(self, q):",
      "      \"\"\"",
      "      クエリから変更値を取得",
      "      複数ある場合はq[1:]に変える",
      "      \"\"\"",
      "      return q[1]",
      "    def debug(self):",
      "      print(\"---debug---\")",
      "      print(self.data)",
      "      print(self.time)",
      "      print(self.effort)",
      "      print(self.effort_time)",
      "  def __init__(self, gf: \"GraphData\", qs: Query_solve):",
      "    self.qs = qs",
      "    self.effort_list = [[] for _ in range(gf.N)]",
      "    self.solve_list = [[] for _ in range(gf.N)]",
      "    m = (gf.N ** (1 / 2)) // 1",
      "    for i in range(gf.N):",
      "      if len(gf.adj_list[i]) < m:",
      "        self.effort_list[i] = gf.adj_list[i]",
      "      else:",
      "        for ind in gf.adj_list[i]:",
      "          self.solve_list[ind].append(i)",
      "  def query(self, q):",
      "    ind = self.qs.get_index(q)",
      "    value = self.qs.get_value(q)",
      "    for b in self.solve_list[ind]: # ソートが必要なケースがあるかも？",
      "      self.qs.solve_other(ind, b, value)",
      "    ans = self.qs.solve_myself(ind, value)",
      "    for b in self.effort_list[ind]:",
      "      self.qs.effort_other(ind, b, value)",
      "    return ans",
      "",
      "# usage",
      "# gf = GraphData(N)  # graph スニペットを先に展開しておく。重みなし前提 (weighted=True だと adj_list がタプルになり動かない)",
      "# gf.add_edges(edges)  # 0-indexed",
      "# qs = SquareSpilit.Query_solve(N)",
      "# sq = SquareSpilit(gf, qs)",
      "# ans = sq.query((x, y))  # q = (頂点, 値)"
    ]
  }
