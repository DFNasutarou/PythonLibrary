  "bitall": {
    "prefix": "bitall",
    "body": [
      "class BitAll:",
      "  \"\"\"",
      "  BIT全炭次郎クラス",
      "  \"\"\"",
      "  @staticmethod",
      "  def bitall(M):",
      "    \"\"\"",
      "    2進数M桁以下で立っているbitが少ないものから順に返す",
      "    \"\"\"",
      "    for i in range(M + 1):",
      "      for n in BitAll.bitall_line(i, M):",
      "        yield n",
      "",
      "  @staticmethod",
      "  def bitall_index_list(M):",
      "    \"\"\"",
      "    2進数M桁以下で立っているbitが少ないものから",
      "    立っているビットのインデックスのリストを返す",
      "    \"\"\"",
      "    for n in BitAll.bitall(M):",
      "      yield BitAll.set_bit_indices(n)",
      "",
      "  @staticmethod",
      "  def bitall_line(N, M):",
      "    \"\"\"",
      "    2進数M桁以下でNbit立っているものを順に返す",
      "    \"\"\"",
      "    if N == 0: ",
      "      yield 0",
      "      return",
      "    n = (1 << N) - 1",
      "    while n < (1 << M):",
      "      yield n",
      "      x = n & -n",
      "      y = n + x",
      "      n = ((n & ~y) >> x.bit_length()) | y",
      "",
      "  @staticmethod",
      "  def subset_of(n):",
      "    \"\"\"",
      "    与えられた整数 n の、M桁の2進数表記において立っているビット位置の部分集合を順に返す",
      "    例: n=5 (101) の場合、0, 1, 4, 5 を返す(順不同)",
      "    \"\"\"",
      "    s = n",
      "    while s != 0:",
      "      yield s",
      "      s = (s - 1) & n",
      "    yield 0",
      "",
      "  @staticmethod",
      "  def bitall_with_subsets(M):",
      "    \"\"\"",
      "    M桁の2進数の各整数 n (0 <= n < 2**M) について、",
      "    n と、n のビット集合から作れる部分集合の値 s を",
      "    nについてBitAll.bitall の順に返す(sについては順不同)",
      "    例: n=5 の場合、(5,0), (5,1), (5,4), (5,5) を返す",
      "    \"\"\"",
      "    for n in BitAll.bitall(M):",
      "      for s in BitAll.subset_of(n):",
      "        yield (n, s)",
      "",
      "  @staticmethod ",
      "  def set_bit_indices(n):",
      "    \"\"\"",
      "    n の二進数表記で立っているビットのインデックスのリストを返す。",
      "    例: n = 13 (1101) の場合、[0, 2, 3] を返す",
      "    \"\"\"",
      "    L = []",
      "    while n:",
      "      lowest = n & -n",
      "      index = lowest.bit_length() - 1",
      "      L.append(index)",
      "      n &= n - 1",
      "    return L",
      "",
      "  @staticmethod",
      "  def debug_bit(n, M):",
      "    \"\"\"",
      "    デバッグ用: n を2進数表記（M桁まで0埋め）した文字列を返す",
      "    \"\"\"",
      "    binary_str = bin(n)[2:]",
      "    return binary_str.zfill(M)",
      "",
      "# usage",
      "# for s in BitAll.bitall(M): ...",
      "# idx = BitAll.set_bit_indices(s)"
    ],
    "description": "BIT 全部入り BitAll (用途別 BIT の集合管理、index 振り分け)",
    "scope": "python"
  },
  "nibutan": {
    "prefix": "nibutan",
    "body": [
      "class nibutan:",
      "  @staticmethod",
      "  def nibutan(ok, ng, op):",
      "    while abs(ok - ng) > 1:",
      "      mid = (ok + ng) >> 1",
      "      if op(mid):",
      "        ok = mid",
      "      else:",
      "        ng = mid",
      "    return ok",
      "  @staticmethod",
      "  def lt(L, n):",
      "    \"\"\"Lのうちn未満の最大の要素\"\"\"",
      "    if L[0] >= n: return -1",
      "    def op(mid):",
      "      return L[mid] < n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "",
      "  @staticmethod",
      "  def le(L, n):",
      "    \"\"\"Lのうちn以下の最大の要素\"\"\"",
      "    if L[0] > n: return -1",
      "    def op(mid):",
      "      return L[mid] <= n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def gt(L, n):",
      "    \"\"\"Lのうちn超過の最小の要素\"\"\"",
      "    if L[-1] <= n: return len(L)",
      "    def op(mid):",
      "      return L[mid] > n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def ge(L, n):",
      "    \"\"\"Lのうちn以上の最小の要素\"\"\"",
      "    if L[-1] < n: return len(L)",
      "    def op(mid):",
      "      return L[mid] >= n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)",
      "",
      "# usage",
      "# x = nibutan.nibutan(ok, ng, op)",
      "# i = nibutan.le(L, n)"
    ],
    "description": "二分探索 (汎用 nibutan + ソート列向け lt / le / gt / ge staticmethod)",
    "scope": "python"
  },
  "tentou": {
    "prefix": "tentou",
    "body": [
      "class BIT:",
      "  ini = 0",
      "  def __init__(self, num):",
      "    self.N = 1",
      "    while self.N <= num:",
      "      self.N *= 2",
      "    self.T = [self.ini] * self.N",
      "  def set(self, L):",
      "    for i in range(len(L)):",
      "      self.update(i, L[i])",
      "  def update(self, x, n): # xにnを加える",
      "    k = x + 1",
      "    self.T[k - 1] += n",
      "    k += k & -k",
      "    while k <= self.N:",
      "      self.T[k - 1] += n",
      "      k += k & -k",
      "  def getV(self, x): # xまでの和(x含む)",
      "    if x < 0: return 0",
      "    x += 1",
      "    ans = self.T[x - 1]",
      "    x -= x & -x",
      "    while x != 0:",
      "      ans += self.T[x - 1]",
      "      x -= x & -x",
      "    return ans",
      " ",
      "def tentou(L):",
      "  if len(L) <= 1:",
      "    return 0",
      "  D = sorted(L)",
      "  R = {}",
      "  cnt = 0",
      "  for d in D:",
      "    if d not in R:",
      "      R[d] = cnt",
      "      cnt += 1",
      "  b = BIT(cnt + 1)",
      "  ans = (len(L) * (len(L) - 1)) // 2",
      "  for d in L:",
      "    d = R[d]",
      "    ans -= b.getV(d)",
      "    b.update(d, 1)",
      "  return ans",
      "",
      "# usage",
      "# cnt = tentou(A)"
    ],
    "description": "転倒数 (BIT で O(N log N))",
    "scope": "python"
  },
  "prev_greater": {
    "prefix": "prevgreater",
    "body": [
      "def prev_greater(A):",
      "  \"\"\"",
      "  各要素について、それより前にある要素のうち、その要素より真に大きいものの",
      "  一番右(要素番号が最大)の要素番号を返す",
      "  A: 数値のリスト",
      "  戻り値: A と同じ長さのリスト。該当なしは -1  (0-indexed)",
      "  O(N)",
      "  \"\"\"",
      "  ans = [-1] * len(A)",
      "  stack = []  # 値が単調減少になるように要素番号を保持",
      "  for i, a in enumerate(A):",
      "    while stack and A[stack[-1]] <= a: stack.pop()",
      "    if stack: ans[i] = stack[-1]",
      "    stack.append(i)",
      "  return ans",
      "",
      "# usage",
      "# res = prev_greater(A)  # res[i] = i より前で A[i] より大きい最も右の番号 / なければ -1"
    ],
    "description": "各要素の左側で、それより大きい最も右の要素の番号 (単調スタック O(N))",
    "scope": "python"
  },
  "grundy": {
    "prefix": "grundy",
    "body": [
      "import sys",
      "from functools import lru_cache",
      "sys.setrecursionlimit(10**6)",
      "",
      "class Grundy:",
      "  # 組み合わせゲームの Grundy 数を総当たりで求める（小さい状態で周期・規則性を探す実験用）",
      "  #   g(s): 状態 s の Grundy 数を返す（0 なら手番側の負け）",
      "  #   table(states): 各状態の Grundy 数を print する",
      "  # moves(s): s から 1 手で移れる状態のリストを返す関数（利用者が定義）",
      "  #   遷移先を list で返すと「独立な複数ゲームの和」とみなし、各 Grundy 数の XOR を取る",
      "  # 状態は hashable（int / tuple / frozenset 等）であること。再帰なので深い状態は PyPy 推奨",
      "  def __init__(self, moves):",
      "    self.moves = moves",
      "    self.g = lru_cache(maxsize=None)(self._g)",
      "  def _g(self, s):",
      "    st = set()",
      "    for t in self.moves(s):",
      "      if isinstance(t, list):",
      "        x = 0",
      "        for u in t: x ^= self.g(u)",
      "        st.add(x)",
      "      else:",
      "        st.add(self.g(t))",
      "    m = 0",
      "    while m in st: m += 1",
      "    return m",
      "  def table(self, states):",
      "    for s in states: print(s, self.g(s))",
      "",
      "# usage",
      "# def moves(n):  # 1〜3 個取れる石取り",
      "#   return [n - k for k in (1, 2, 3) if n - k >= 0]",
      "# gr = Grundy(moves)",
      "# gr.table(range(20))  # 0 1 2 3 0 1 2 3 ... の周期が見える",
      "# def moves2(n):  # 山を 2 つの空でない山に分ける",
      "#   return [[a, n - a] for a in range(1, n)]",
      "# Grundy(moves2).table(range(10))"
    ],
    "description": "組み合わせゲームの Grundy 数を総当たり計算 (遷移関数を渡す・ゲームの和は XOR・小さい状態の実験用)",
