      "class nibutan:",
      "  @staticmethod",
      "  def nibutan(ok, ng, op):",
      "    while abs(ok - ng) > 1:",
      "      mid = (ok + ng) >> 1",
      "      if op(mid):",
      "        ok = mid",
      "      else:",
      "        ng = mid",
      "    return ok",
      "  @staticmethod",
      "  def lt(L, n):",
      "    \"\"\"Lのうちn未満の最大の要素\"\"\"",
      "    if L[0] >= n: return -1",
      "    def op(mid):",
      "      return L[mid] < n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "",
      "  @staticmethod",
      "  def le(L, n):",
      "    \"\"\"Lのうちn以下の最大の要素\"\"\"",
      "    if L[0] > n: return -1",
      "    def op(mid):",
      "      return L[mid] <= n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def gt(L, n):",
      "    \"\"\"Lのうちn超過の最小の要素\"\"\"",
      "    if L[-1] <= n: return len(L)",
      "    def op(mid):",
      "      return L[mid] > n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def ge(L, n):",
      "    \"\"\"Lのうちn以上の最小の要素\"\"\"",
      "    if L[-1] < n: return len(L)",
      "    def op(mid):",
      "      return L[mid] >= n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)"
    ],
