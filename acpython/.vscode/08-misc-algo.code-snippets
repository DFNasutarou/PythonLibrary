    "description": "分割数",
    "body": [
      "class Bunkatu:",
      "  @staticmethod",
      "  def bunkatu(N):",
      "    \"\"\"",
      "    自然数Nを分割する方法のリスト",
      "    \"\"\"",
      "    return Bunkatu._bunkatu_sub(N, 1, [])",
      "",
      "  @staticmethod",
      "  def bunkatu_map(N):",
      "    \"\"\"",
      "    自然数Nを分割する方法をMAPで表したもののリスト",
      "    \"\"\"",
      "    ML = Bunkatu.bunkatu_map(N)",
      "    RL = []",
      "    for L in ML:",
      "      if len(L) > N: continue",
      "      R = {}",
      "      for d in L:",
      "        if d in R: R[d] += 1",
      "        else: R[d] = 1",
      "      RL.append(R)",
      "    return RL",
      "",
      "  @staticmethod",
      "  def _bunkatu_sub(N, a, D):",
      "    ans = []",
      "    for i in range(a, N):",
      "      if N - i < i: continue",
      "      T = D[:] + [i]",
      "      ans.extend(Bunkatu._bunkatu_sub(N - i, i, T))",
      "    ans.append(D + [N])",
      "    return ans",
      ""
    ]
