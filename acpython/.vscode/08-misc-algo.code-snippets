  "bitall": {
    "prefix": "bitall",
    "body": [
      "class BitAll:",
      "  \"\"\"",
      "  BIT全炭次郎クラス",
      "  \"\"\"",
      "  @staticmethod",
      "  def bitall(M):",
      "    \"\"\"",
      "    2進数M桁以下で立っているbitが少ないものから順に返す",
      "    \"\"\"",
      "    for i in range(M + 1):",
      "      for n in BitAll.bitall_line(i, M):",
      "        yield n",
      "",
      "  @staticmethod",
      "  def bitall_index_list(M):",
      "    \"\"\"",
      "    2進数M桁以下で立っているbitが少ないものから",
      "    立っているビットのインデックスのリストを返す",
      "    \"\"\"",
      "    for n in BitAll.bitall(M):",
      "      yield BitAll.set_bit_indices(n)",
      "",
      "  @staticmethod",
      "  def bitall_line(N, M):",
      "    \"\"\"",
      "    2進数M桁以下でNbit立っているものを順に返す",
      "    \"\"\"",
      "    if N == 0: ",
      "      yield 0",
      "      return",
      "    n = (1 << N) - 1",
      "    while n < (1 << M):",
      "      yield n",
      "      x = n & -n",
      "      y = n + x",
      "      n = ((n & ~y) >> x.bit_length()) | y",
      "",
      "  @staticmethod",
      "  def subset_of(n):",
      "    \"\"\"",
      "    与えられた整数 n の、M桁の2進数表記において立っているビット位置の部分集合を順に返す",
      "    例: n=5 (101) の場合、0, 1, 4, 5 を返す(順不同)",
      "    \"\"\"",
      "    s = n",
      "    while s != 0:",
      "      yield s",
      "      s = (s - 1) & n",
      "    yield 0",
      "",
      "  @staticmethod",
      "  def bitall_with_subsets(M):",
      "    \"\"\"",
      "    M桁の2進数の各整数 n (0 <= n < 2**M) について、",
      "    n と、n のビット集合から作れる部分集合の値 s を",
      "    nについてBitAll.bitall の順に返す(sについては順不同)",
      "    例: n=5 の場合、(5,0), (5,1), (5,4), (5,5) を返す",
      "    \"\"\"",
      "    for n in BitAll.bitall(M):",
      "      for s in BitAll.subset_of(n):",
      "        yield (n, s)",
      "",
      "  @staticmethod ",
      "  def set_bit_indices(n):",
      "    \"\"\"",
      "    n の二進数表記で立っているビットのインデックスのリストを返す。",
      "    例: n = 13 (1101) の場合、[0, 2, 3] を返す",
      "    \"\"\"",
      "    L = []",
      "    while n:",
      "      lowest = n & -n",
      "      index = lowest.bit_length() - 1",
      "      L.append(index)",
      "      n &= n - 1",
      "    return sorted(L)",
      "",
      "  @staticmethod",
      "  def debug_bit(n, M):",
      "    \"\"\"",
      "    デバッグ用: n を2進数表記（M桁まで0埋め）した文字列を返す",
      "    \"\"\"",
      "    binary_str = bin(n)[2:]",
      "    return binary_str.zfill(M)",
      "",
      "# usage: ba = BitAll(N); ba.update(i, x, kind); ba.getV(r, kind)"
    ],
    "description": "BIT 全部入り BitAll (用途別 BIT の集合管理、index 振り分け)",
    "scope": "python"
  },
  "nibutan": {
    "prefix": "nibutan",
    "body": [
      "class nibutan:",
      "  @staticmethod",
      "  def nibutan(ok, ng, op):",
      "    while abs(ok - ng) > 1:",
      "      mid = (ok + ng) >> 1",
      "      if op(mid):",
      "        ok = mid",
      "      else:",
      "        ng = mid",
      "    return ok",
      "  @staticmethod",
      "  def lt(L, n):",
      "    \"\"\"Lのうちn未満の最大の要素\"\"\"",
      "    if L[0] >= n: return -1",
      "    def op(mid):",
      "      return L[mid] < n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "",
      "  @staticmethod",
      "  def le(L, n):",
      "    \"\"\"Lのうちn以下の最大の要素\"\"\"",
      "    if L[0] > n: return -1",
      "    def op(mid):",
      "      return L[mid] <= n ",
      "    ok = 0",
      "    ng = len(L)",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def gt(L, n):",
      "    \"\"\"Lのうちn超過の最小の要素\"\"\"",
      "    if L[-1] <= n: return len(L)",
      "    def op(mid):",
      "      return L[mid] > n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)",
      "      ",
      "  @staticmethod",
      "  def ge(L, n):",
      "    \"\"\"Lのうちn以上の最小の要素\"\"\"",
      "    if L[-1] < n: return len(L)",
      "    def op(mid):",
      "      return L[mid] >= n ",
      "    ok = len(L) - 1",
      "    ng = -1",
      "    return nibutan.nibutan(ok, ng, op)",
      "",
      "# usage: x = nibutan.nibutan(ok, ng, op); i = nibutan.le(L, n)"
    ],
    "description": "二分探索 (汎用 nibutan + ソート列向け lt / le / gt / ge staticmethod)",
    "scope": "python"
  },
  "tentou": {
    "prefix": "tentou",
    "body": [
      "class BIT:",
      "  ini = 0",
      "  def __init__(s, num):",
      "    s.N = 1",
      "    while s.N <= num:",
      "      s.N *= 2",
      "    s.T = [s.ini] * s.N",
      "  def set(s, L):",
      "    for i in range(len(L)):",
      "      s.update(i, L[i])",
      "  def update(s, x, n): # xにnを加える",
      "    k = x + 1",
      "    s.T[k - 1] += n",
      "    k += k & -k",
      "    while k <= s.N:",
      "      s.T[k - 1] += n",
      "      k += k & -k",
      "  def getV(s, x): # xまでの和(x含む)",
      "    if x < 0: return 0",
      "    x += 1",
      "    ans = s.T[x - 1]",
      "    x -= x & -x",
      "    while x != 0:",
      "      ans += s.T[x - 1]",
      "      x -= x & -x",
      "    return ans",
      " ",
      "import copy",
      "def tentou(L):",
      "  if len(L) <= 1:",
      "    return 0",
      "  D = copy.deepcopy(L)",
      "  D.sort()",
      "  R = {}",
      "  cnt = 0",
      "  for d in D:",
      "    if d not in R:",
      "      R[d] = cnt",
      "      cnt += 1",
      "  b = BIT(cnt + 1)",
      "  ans = (len(L) * (len(L) - 1)) // 2",
      "  for d in L:",
      "    d = R[d]",
      "    ans -= b.getV(d)",
      "    b.update(d, 1)",
      "  return ans",
      "",
      "# usage: cnt = inversion_count(A)"
    ],
    "description": "転倒数 (BIT で O(N log N))",
    "scope": "python"
  }
