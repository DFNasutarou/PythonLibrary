      "class BIT:",
      "  ini = 0",
      "  def __init__(s, num):",
      "    s.N = 1",
      "    while s.N <= num:",
      "      s.N *= 2",
      "    s.T = [s.ini] * s.N",
      "  def set(s, L):",
      "    for i in range(len(L)):",
      "      s.update(i, L[i])",
      "  def update(s, x, n): # xにnを加える",
      "    k = x + 1",
      "    s.T[k - 1] += n",
      "    k += k & -k",
      "    while k <= s.N:",
      "      s.T[k - 1] += n",
      "      k += k & -k",
      "  def getV(s, x): # xまでの和(x含む)",
      "    if x < 0: return 0",
      "    x += 1",
      "    ans = s.T[x - 1]",
      "    x -= x & -x",
      "    while x != 0:",
      "      ans += s.T[x - 1]",
      "      x -= x & -x",
      "    return ans",
      " ",
      "import copy",
      "def tentou(L):",
      "  if len(L) <= 1:",
      "    return 0",
      "  D = copy.deepcopy(L)",
      "  D.sort()",
      "  R = {}",
      "  cnt = 0",
      "  for d in D:",
      "    if d not in R:",
      "      R[d] = cnt",
      "      cnt += 1",
      "  b = BIT(cnt + 1)",
      "  ans = (len(L) * (len(L) - 1)) // 2",
      "  for d in L:",
      "    d = R[d]",
      "    ans -= b.getV(d)",
      "    b.update(d, 1)",
      "  return ans",
