      "      if (((l >> i) << i) != l): s.push(l >> i)",
      "      if (((r >> i) << i) != r): s.push(r >> i)",
      "    sml, smr = s.e(), s.e()",
      "    while (l < r):",
      "      if l & 1: ",
      "        sml = s.op(sml, s.d[l])",
      "        l += 1",
      "      if r & 1:",
      "        r -= 1",
      "        smr = s.op(s.d[r], smr)",
      "      l >>= 1",
      "      r >>= 1",
      "    return s.op(sml, smr)",
      " ",
      "  # 全体演算",
      "  def all_prod(s): return s.d[1]",
      " ",
      "  # 1点写像",
      "  def apply(s, p, f):",
      "    p += s.size",
      "    for i in range(s.log, 0, -1): s.push(p >> i)",
