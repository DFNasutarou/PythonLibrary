      "    s.op = op",
      "    s.mapping = mapping",
      "    s.composition = composition",
      "    s.id = id",
      "    for i in range(s._n): s.d[s.size + i] = v[i]",
      "    for i in range(s.size - 1, 0, -1): s.update(i)",
      "  ",
      "  # 1点更新",
      "  def set(s, p, x):",
      "    p += s.size",
      "    for i in range(s.log, 0, -1): s.push(p >> i)",
