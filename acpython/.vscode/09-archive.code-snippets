  "deque": {
    "scope": "python",
    "prefix": "deque",
    "description": "両端キュー Deque (両端 O(1)・ランダムアクセス対応・二重スタック実装)",
    "body": [
      "class Deque:",
      "  # add_r(n): 末尾に追加する",
      "  # add_l(n): 先頭に追加する",
      "  # pop_r(): 末尾から取り出す",
      "  # pop_l(): 先頭から取り出す",
      "  # size(): 要素数を返す",
      "  # is_empty(): 空かどうかを返す",
      "  # get(ind): 先頭から ind 番目の要素を返す",
      "  # getList(): 中身をリストで返す (チェック用 O(N))",
      "  def __init__(self, d: list[int] = []):",
      "    self._normalize(d)",
      "  def add_r(self, n):",
      "    self.R.append(n)",
      "  def add_l(self, n):",
      "    self.L.append(n)",
      "  def pop_r(self):",
      "    if self.R == [] and len(self.L) == 1: ",
      "      n = self.L.pop()",
      "    else:",
      "      if self.R == []: self._normalize(self.L[::-1])",
      "      n = self.R.pop()",
      "    return n",
      "  def pop_l(self):",
      "    if self.L == [] and  len(self.R) == 1: ",
      "      n = self.R.pop()",
      "    else:",
      "      if self.L == []: self._normalize(self.R)",
      "      n = self.L.pop()",
      "    return n",
      "  def size(self):",
      "    return len(self.L) + len(self.R)",
      "  def is_empty(self):",
      "    return self.size() == 0",
      "  def get(self, ind):",
      "    if ind < len(self.L):",
      "      return self.L[-ind - 1]",
      "    ind -= len(self.L)",
      "    return self.R[ind]",
      "  def _normalize(self, d):",
      "    self.L = d[:len(d) // 2][::-1]",
      "    self.R = d[len(d) // 2:]",
      "  def getList(self):",
      "    return self.L[::-1] + self.R",
      "",
      "# usage",
      "# dq = Deque([1, 2, 3])",
      "# dq.add_r(4)",
      "# dq.pop_l()"
    ]
  },
  "lazysegold": {
    "scope": "python",
    "prefix": "lazysegold",
    "description": "遅延評価セグ木 (自己完結版・ACL 不要・op/e/mapping/composition/id 渡し)",
    "body": [
      "class lazySegTree:",
      "  #遅延評価セグメント木",
      "  def __init__(self, op, e, mapping, composition, id, v):",
      "    if type(v) is int: v = [e()] * v",
      "    self._n = len(v)",
      "    self.log = self.ceil_pow2(self._n)",
      "    self.size = 1 << self.log",
      "    self.d = [e()] * (2 * self.size)",
      "    self.lz = [id()] * self.size",
      "    self.e = e",
      "    self.op = op",
      "    self.mapping = mapping",
      "    self.composition = composition",
      "    self.id = id",
      "    for i in range(self._n): self.d[self.size + i] = v[i]",
      "    for i in range(self.size - 1, 0, -1): self.update(i)",
      "  ",
      "  # 1点更新",
      "  def set(self, p, x):",
      "    p += self.size",
      "    for i in range(self.log, 0, -1): self.push(p >> i)",
      "    self.d[p] = x",
      "    for i in range(1, self.log + 1): self.update(p >> i)",
      " ",
      "  # 1点取得",
      "  def get(self, p):",
      "    p += self.size",
      "    for i in range(self.log, 0, -1): self.push(p >> i)",
      "    return self.d[p]",
      " ",
      "  # 区間演算",
      "  def prod(self, l, r):",
      "    if l == r: return self.e()",
      "    l += self.size",
      "    r += self.size",
      "    for i in range(self.log, 0, -1):",
      "      if (((l >> i) << i) != l): self.push(l >> i)",
      "      if (((r >> i) << i) != r): self.push(r >> i)",
      "    sml, smr = self.e(), self.e()",
      "    while (l < r):",
      "      if l & 1: ",
      "        sml = self.op(sml, self.d[l])",
      "        l += 1",
      "      if r & 1:",
      "        r -= 1",
      "        smr = self.op(self.d[r], smr)",
      "      l >>= 1",
      "      r >>= 1",
      "    return self.op(sml, smr)",
      " ",
      "  # 全体演算",
      "  def all_prod(self): return self.d[1]",
      " ",
      "  # 1点/区間写像",
      "  def apply(self, l, r_or_f=None, f=None):",
      "    if f is None:  # 1点写像: apply(p, f)",
      "      p, f = l, r_or_f",
      "      p += self.size",
      "      for i in range(self.log, 0, -1): self.push(p >> i)",
      "      self.d[p] = self.mapping(f, self.d[p])",
      "      for i in range(1, self.log + 1): self.update(p >> i)",
      "    else:  # 区間写像: apply(l, r, f)",
      "      r = r_or_f",
      "      if l == r: return",
      "      l += self.size",
      "      r += self.size",
      "      for i in range(self.log, 0, -1):",
      "        if (((l >> i) << i) != l): self.push(l >> i)",
      "        if (((r >> i) << i) != r): self.push((r - 1) >> i)",
      "      l2, r2 = l, r",
      "      while l < r:",
      "        if l & 1: ",
      "          sml = self.all_apply(l, f)",
      "          l += 1",
      "        if r & 1:",
      "          r -= 1",
      "          smr = self.all_apply(r, f)",
      "        l >>= 1",
      "        r >>= 1",
      "      l, r = l2, r2",
      "      for i in range(1, self.log + 1):",
      "        if (((l >> i) << i) != l): self.update(l >> i)",
      "        if (((r >> i) << i) != r): self.update((r - 1) >> i)",
      "   ",
      "  # L固定時の最長区間のR",
      "  def max_right(self, l, g):",
      "    if l == self._n: return self._n",
      "    l += self.size",
      "    for i in range(self.log, 0, -1): self.push(l >> i)",
      "    sm = self.e()",
      "    while True:",
      "      while (l % 2 == 0): l >>= 1",
      "      if not g(self.op(sm, self.d[l])):",
      "        while l < self.size:",
      "          self.push(l)",
      "          l = 2 * l",
      "          if g(self.op(sm, self.d[l])):",
      "            sm = self.op(sm, self.d[l])",
      "            l += 1",
      "        return l - self.size",
      "      sm = self.op(sm, self.d[l])",
      "      l += 1",
      "      if (l & -l) == l: break",
      "    return self._n",
      " ",
      "  # R固定時の最長区間のL",
      "  def min_left(self, r, g):",
      "    if r == 0: return 0",
      "    r += self.size",
      "    for i in range(self.log, 0, -1): self.push((r - 1) >> i)",
      "    sm = self.e()",
      "    while True:",
      "      r -= 1",
      "      while r > 1 and (r % 2): r >>= 1",
      "      if not g(self.op(self.d[r], sm)):",
      "        while r < self.size:",
      "          self.push(r)",
      "          r = 2 * r + 1",
      "          if g(self.op(self.d[r], sm)):",
      "            sm = self.op(self.d[r], sm)",
      "            r -= 1",
      "        return r + 1 - self.size",
      "      sm = self.op(self.d[r], sm)",
      "      if (r & - r) == r: break",
      "    return 0",
      " ",
      "  def update(self, k): self.d[k] = self.op(self.d[2 * k], self.d[2 * k + 1])",
      "  def all_apply(self, k, f):",
      "    self.d[k] = self.mapping(f, self.d[k])",
      "    if k < self.size: self.lz[k] = self.composition(f, self.lz[k])",
      "  def push(self, k):",
      "    self.all_apply(2 * k, self.lz[k])",
      "    self.all_apply(2 * k + 1, self.lz[k])",
      "    self.lz[k] = self.id()",
      "  def ceil_pow2(self, n):",
      "    x = 0",
      "    while (1 << x) < n: x += 1",
      "    return x",
      "  def print(self): #デバッグ用",
      "    ans = []",
      "    for i in range(self._n):",
      "      ans.append(self.get(i))",
      "    print(*ans)",
      "",
      "'''",
      "作用付きモノイド (X, ○), (M, ☆), □",
      "X □ M → X",
      "a, b, e ∈ X, f, g, d ∈ M",
      "a ○ e = a, f ☆ d = f, a □ d = a ?",
      "(a ○ b) □ f = (a □ f) ○ (b □ f)",
      "(a □ f) □ g = a □ (f ☆ g)",
      "'''",
      "# モノイドXの単位元",
      "# return a・e = a となる e",
      "def e():",
      "  return 0",
      "",
      "# モノイドXの演算",
      "# return a・b",
      "def op(a, b):",
      "  return 0",
      "",
      "# XにMを作用させた結果",
      "# return a・f",
      "def mapping(f, a):",
      "  return 0",
      "",
      "# モノイドMの演算",
      "# return f・g",
      "def composition(f, g):",
      "  return 0",
      "",
      "# モノイドMの単位元",
      "# return f・id = id となる id",
      "def id():",
      "  return 0",
      "",
      "seg = lazySegTree(op, e, mapping, composition, id, a)",
      "",
      "# usage",
      "# t = lazySegTree(op, e, mapping, composition, id, v)",
      "# t.apply(l, r, f)"
    ]
  },
  "tree_old": {
    "prefix": "treeold",
    "body": [
      "import copy",
      "class TreeFactory:",
      "  def __init__(self, num):",
      "    self.N = num",
      "    self.C = {}",
      "    self.reroot = -1",
      "  # 隣接リストから木作成 1-indexedならindex = 1にする",
      "  def setByAdjacencyList(self, list, index = 0):",
      "    for u, v in list: self.set(u - index, v - index)",
      "  # 親リストから木作成 1-indexedならindex = 1にする",
      "  def setByParentList(self, list, index = 0):",
      "    for i in range(self.N - 1):",
      "      self.set(i + 1, list[i] - index)",
      "  def set(self, a, b):",
      "    if a in self.C: self.C[a].append(b)",
      "    else: self.C[a] = [b]",
      "    if b in self.C: self.C[b].append(a)",
      "    else: self.C[b] = [a]",
      "  def makeTree(self): return TreeFactory.Tree(self.N, self.C)",
      "  def makeTreeDP(self, root):",
      "    _, RL, S, P = self.makesub(root)",
      "    return TreeFactory.TreeDP(self.N, P, S, RL)",
      "  def makeTour(self, root):",
      "    _, _, S, _ = self.makesub(root)",
      "    T = TreeFactory.Tour.tour(root, S)",
      "    F, L = TreeFactory.Tour.tourFL(self.N, T)",
      "    return T, F, L # オイラーツアー、最初の出現位置リスト、最後の出現位置リスト",
      "  def makeLca(self, root):",
      "    R, RL, _, P = self.makesub(root)",
      "    return TreeFactory.LCA(self.N, R, RL, P)",
      "  # 頂点集合から、頂点同士の関係を失わないように木を圧縮したもののリストを返す",
      "  # v = [[頂点集合1], [頂点集合2], ...] （それぞれの結果がまとめて返る）",
      "  # return [[親Noリスト], [頂点Noリスト], [頂点No→連番への写像map]] のリスト",
      "  def makeAuxiliaryTree(self, root, V):",
      "    R, RL, S, P = self.makesub(root)",
      "    T = TreeFactory.Tour.tour(root, S)",
      "    F, L = TreeFactory.Tour.tourFL(self.N, T)",
      "    lca = TreeFactory.LCA(self.N, R, RL, P)",
      "    return TreeFactory.AuxiliaryTree.makeAuxiliaryTree(V, F, L, lca)",
      "  # HLD分解",
      "  def makeHld(self, root = 0):",
      "    R, RL, S, P = self.makesub(root)",
      "    HLD = TreeFactory.HLD(self.N, R, RL, S, P, root)",
      "    return HLD # HLD操作用のインスタンス",
      "  def makesub(self, root):",
      "    R = [-1] * self.N #各ノードのランク",
      "    R[root] = 0",
      "    RL = [[root]] #各ランクのノード",
      "    S = {} #各ノードの子ノード",
      "    P = [-1] * self.N #各ノードの親ノード",
      "    while RL[-1] != []:",
      "      RL.append([])",
      "      for i in RL[-2]:",
      "        for j in self.C.get(i, ()):",
      "          if R[j] == -1:",
      "            R[j] = len(RL) - 1",
      "            RL[-1].append(j)",
      "            if i not in S: S[i] = [j]",
      "            else: S[i].append(j)",
      "            P[j] = i",
      "    return R, RL, S, P",
      "",
      "  class Tree:",
      "    def __init__(self, N, C):",
      "      self.N = N",
      "      self.C = C",
      "    def dfs(self, x, y, r): #xからyまでの道O(N)（非再帰）。r: xの隣のうち通らない頂点。なければFalse",
      "      par = {x: r}",
      "      st = [x]",
      "      while st:",
      "        v = st.pop()",
      "        if v == y:",
      "          path = [v]",
      "          while v != x:",
      "            v = par[v]",
      "            path.append(v)",
      "          return path[::-1]",
      "        for i in self.C.get(v, ()):",
      "          if i != par[v]:",
      "            par[i] = v",
      "            st.append(i)",
      "      return False",
      "    def dist(self, x): #最遠のノード,距離",
      "      t = [-1] * self.N",
      "      S = [x]",
      "      ans = x",
      "      ansn = 0",
      "      t[x] = 0",
      "      while S != []:",
      "        k = S.pop()",
      "        for i in self.C.get(k, ()):",
      "          if t[i] == -1:",
      "            t[i] = t[k] + 1",
      "            S.append(i)",
      "            if t[i] > ansn:",
      "              ansn = t[i]",
      "              ans = i",
      "      return ans, ansn",
      "    def getDi(self, x = 0): #直径",
      "      a, _ = self.dist(x)",
      "      b, ans = self.dist(a)",
      "      return ans, a, b",
      "    ",
      "  class Tour:",
      "    @staticmethod",
      "    def tour(root, S): #オイラーツアー",
      "      x = root",
      "      T = [] #ツアー",
      "      L = [x]",
      "      while L:",
      "        n = L.pop()",
      "        if n < 0:",
      "          x = n * -1 - 1",
      "          T.append(x)",
      "          continue",
      "        T.append(n)",
      "        if n in S:",
      "          for x in (S[n]):",
      "            L.append(-(n + 1))",
      "            L.append(x)",
      "      return T",
      "    @staticmethod",
      "    def tourFL(N, T): # オイラーツアー後に実施",
      "      First = [-1] * N # 各頂点の最初の出現位置",
      "      Last = [-1] * N # 各頂点の最後の出現位置",
      "      M = len(T)",
      "      for i in range(M):",
      "        if First[T[i]] == -1:",
      "          First[T[i]] = i",
      "        Last[T[i]] = i",
      "      return First, Last",
      "    ",
      "  class LCA:",
      "    def __init__(self, N, R, RL, P):",
      "      self.R = R",
      "      self.makeDub(N, RL, P)",
      "    def makeDub(self, N, RL, P):",
      "      self.dub = [[] for _ in range(N)]",
      "      for D in RL[1:]:",
      "        for d in D:",
      "          n = P[d]",
      "          self.dub[d].append(n)",
      "          t = 0",
      "          while len(self.dub[n]) > t:",
      "            self.dub[d].append(self.dub[n][t])",
      "            n = self.dub[n][t]",
      "            t += 1",
      "    def getParent(self, x, n): #xのn世代前の親",
      "      #先にmakeDubしておくこと",
      "      if n == 0: return x",
      "      t = self.R[x]",
      "      if t >= n:",
      "        ans = x",
      "        v = 0",
      "        while n != 0:",
      "          if n & 1:",
      "            ans = self.dub[ans][v]",
      "          n >>= 1",
      "          v += 1",
      "        return ans",
      "      else:",
      "        return -1",
      "    def getLCA(self, u, v):",
      "      #先にmakeDubしておくこと",
      "      if self.R[u] < self.R[v]: ",
      "        u, v = v, u",
      "      u = self.getParent(u, self.R[u] - self.R[v])",
      "      if u == v: return u",
      "      K = len(self.dub[u])",
      "      for k in range(K - 1, -1, -1):",
      "        if len(self.dub[u]) <= k: continue",
      "        if self.dub[u][k] != self.dub[v][k]:",
      "          u = self.dub[u][k]",
      "          v = self.dub[v][k]",
      "      return self.dub[u][0]",
      "    ",
      "  class AuxiliaryTree:",
      "    # 頂点集合から、頂点同士の関係を失わないように木を圧縮したもののリストを返す",
      "    # v = [[頂点集合1], [頂点集合2], ...]",
      "    # return [[親Noリスト], [頂点Noリスト], [頂点No→連番への写像map]] のリスト",
      "    @staticmethod",
      "    def makeAuxiliaryTree(V, First, Last, lca):",
      "      ans = []",
      "      for D in V:",
      "        T = []",
      "        for d in D:",
      "          T.append([First[d], d])",
      "        T.sort()",
      "        T = [d[1] for d in T]",
      "        T2 = [T[0]]",
      "        for i in range(1, len(T)):",
      "          l = T[i - 1]",
      "          n = T[i]",
      "          m = lca.getLCA(l, n)",
      "          T2.append(m)",
      "          T2.append(n)",
      "        T2 = list(set(T2))",
      "        T2 = [[First[d], d] for d in T2]",
      "        T2.sort()",
      "        T2 = [d[1] for d in T2]",
      "        st = [T2[0]]",
      "        data = [[] for _ in range(2)]",
      "        data.append({})",
      "        data[1] = [T2[0]]",
      "        data[2][T2[0]] = 0",
      "        for y in T2[1:]:",
      "          while st:",
      "            x = st.pop()",
      "            if Last[x] >= First[y]:",
      "              st.append(x)",
      "              st.append(y)",
      "              data[2][y] = len(data[1])",
      "              data[1].append(y)",
      "              data[0].append(data[2][x])",
      "              break",
      "        ans.append(data)",
      "      return ans",
      "",
      "  class TreeDP:",
      "    def __init__(self, num, P, S, RL):",
      "      self.N = num",
      "      self.P = P",
      "      self.S = S",
      "      self.RL = RL",
      "    def bottomUpDP(self):",
      "      for T in self.RL[::-1]:",
      "        for i in T:",
      "          if i not in self.S: continue",
      "          for j in self.S[i]:",
      "            self.dp_sub_exe(i, j)",
      "    def topDownDP(self):",
      "      for T in self.RL[1:]:",
      "        for i in T:",
      "          self.dp_sub_exe_inv(i, self.P[i])",
      "    def allDP(self):",
      "      self.dp_init()",
      "      self.bottomUpDP()",
      "      self.topDownDP()",
      "      return self.DP",
      "    def dp_init(self): #単位元で初期化",
      "      self.DP = [1] * self.N",
      "    def dp_sub_exe(self, x, y): #ボトムアップの処理 x: 親",
      "      self.DP[x] += self.DP[y]",
      "    def dp_sub_exe_inv(self, x, y): #トップダウンの処理 y: 親",
      "      self.DP[x] += self.DP[y]",
      "    def inv(self, a, mod): #逆元",
      "      return pow(a, mod - 2, mod)",
      "    def distList(self, R):",
      "      \"\"\"頂点からの距離のリストを取得\"\"\"",
      "      dp = [0] * self.N",
      "      for T in self.RL[1:]:",
      "        for i in T:",
      "          dp[i] = dp[self.P[i]] + R[i, self.P[i]]",
      "      return dp",
      "",
      "  class HLD:",
      "    def __init__(self, N, R, RL, S, P, root):",
      "      self.P = P",
      "      self.R = R",
      "      self.S = TreeFactory.HLD.moveHeavyToLeft(N, RL, S)",
      "      self.hld, self.hlddic, self.A = self.makehld(N, root)",
      "    # 指定ノードのhld上の位置を返す",
      "    def getPlace(self, u):",
      "      return self.hlddic[u]",
      "    # クエリの分解結果をu → vの順番に返す（first > secondの場合は木を登っている）",
      "    def getQuery(self, u, v):",
      "      au = []",
      "      av = []",
      "      while self.A[u] != self.A[v]:",
      "        if self.R[self.A[u]] > self.R[self.A[v]]:",
      "          au.append([self.hlddic[u], self.hlddic[self.A[u]]])",
      "          u = self.P[self.A[u]]",
      "        else:",
      "          av.append([self.hlddic[self.A[v]], self.hlddic[v]])",
      "          v = self.P[self.A[v]]",
      "      au.append([self.hlddic[u], self.hlddic[v]])",
      "      return au + av[::-1]",
