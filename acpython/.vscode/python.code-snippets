  "tree64": {
    "scope": "python",
    "prefix": "Tree64",
    "description": "64分木",
    "body": [
      "class Tree64:",
      "  # 2 ** (HEIGHT * BIT_SIZE) - 1 まで可能",
      "  # HEIGHT = 8, BIT_SIZE = 6の場合",
      "  # 2 ** 48 - 1 >= 10 ** 14",
      "  HEIGHT = 8",
      "  BIT_SIZE = 6",
      "  SIZE = 1 << BIT_SIZE",
      "  MASK = SIZE - 1",
      "  class Node:",
      "    def __init__(s, flag):",
      "      s.D = 0",
      "      if flag:",
      "        s.L = [None] * Tree64.SIZE",
      "    def add(s, n, height):",
      "      if height == 0 :",
      "        x = n & Tree64.MASK",
      "        s.D |= (1 << x)",
      "        return",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if s.L[x] == None: s.L[x] = Tree64.Node(height != 1)",
      "      s.L[x].add(n, height - 1)",
      "      s.D |= (1 << x)",
      "    def erace(s, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        if s.D & (1 << x):",
      "          s.D ^= (1 << x)",
      "          return s.D == 0",
      "        return False",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if s.L[x] == None: return False",
      "      if s.L[x].erace(n, height - 1):",
      "        s.L[x] = None",
      "        s.D ^= (1 << x)",
      "        return s.D == 0",
      "      return False",
      "    def find(s, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return s.D & (1 << x)",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if s.L[x] == None: return False",
      "      return s.L[x].find(n, height - 1)",
      "    def find_upper(s, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return s.get_upper_bit(x)",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if s.L[x] != None:",
      "        ans = s.L[x].find_upper(n, height - 1)",
      "        if ans != None: return (x << shift) + ans",
      "      y = s.get_upper_bit(x + 1)",
      "      if y == None: return None",
      "      return (y << shift) + s.L[y].find_min(height - 1)",
      "    def find_lower(s, n, height):",
      "      if height == 0:",
      "        x = n & Tree64.MASK",
      "        return s.get_lower_bit(x)",
      "      if height == -1: return 0",
      "      shift = Tree64.BIT_SIZE * height",
      "      x = (n >> shift) & Tree64.MASK",
      "      if s.L[x] != None:",
      "        ans = s.L[x].find_lower(n, height - 1)",
      "        if ans != None: return (x << shift) + ans",
      "      y = s.get_lower_bit(x - 1)",
      "      if y == None: return None",
      "      return (y << shift) + s.L[y].find_max(height - 1)",
      "    # 指定したbit以上の中で一番下のbitを返す",
      "    def get_upper_bit(s, x):",
      "      d = s.D & ~((1 << x) - 1)",
      "      if d == 0: return None",
      "      return (d & -d).bit_length() - 1",
      "    # 指定したbit以下の中で一番上のbitをす",
      "    def get_lower_bit(s, x):",
      "      d = s.D & (1 << (x + 1)) - 1",
      "      if d == 0: return None ",
      "      return d.bit_length() - 1",
      "    # 一番小さい値を返す",
      "    def find_min(s, height):",
      "      if s.D == 0: return None",
      "      if height == 0: return s.get_upper_bit(0)",
      "      x = (s.D & -s.D).bit_length() - 1",
      "      if height == 0: return x",
      "      shift = Tree64.BIT_SIZE * height",
      "      return (x << shift) + s.L[x].find_min(height - 1)",
      "    # 一番大きい値を返す",
      "    def find_max(s, height):",
      "      if s.D == 0: return None",
      "      if height == 0: return s.get_lower_bit(Tree64.SIZE - 1)",
      "      x = s.D.bit_length() - 1",
      "      if height == 0: return x",
      "      shift = Tree64.BIT_SIZE * height",
      "      return (x << shift) + s.L[x].find_max(height - 1)",
      "    ",
      "  # 初期化",
      "  def __init__(s):",
      "    s.root = Tree64.Node(True)",
      "  # n を追加",
      "  def add(s, n):",
      "    s.root.add(n, Tree64.HEIGHT - 1)",
      "  # n を削除",
      "  def erace(s, n):",
      "    s.root.erace(n, Tree64.HEIGHT - 1)",
      "  # n がある : true, ない : false",
      "  def find(s, n):",
      "    return s.root.find(n, Tree64.HEIGHT - 1)",
      "  # n 以上の数で一番小さい値を返す　なければ-1",
      "  def find_upper(s, n):",
      "    ans =  s.root.find_upper(n, Tree64.HEIGHT - 1)",
      "    if ans == None: return -1",
      "    return ans",
      "  # n 以下の数で一番大きい値を返す　なければ-1 ",
      "  def find_lower(s, n):",
      "    ans = s.root.find_lower(n, Tree64.HEIGHT - 1)",
      "    if ans == None: return -1",
      "    return ans"
    ]
