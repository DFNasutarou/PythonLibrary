      "def fwt(f):",
      "  n = len(f)",
      "  i = 1",
      "  while i < n:",
      "    for j in range(n):",
      "      if j & i == 0:",
      "        x, y = f[j], f[j | i]",
      "        f[j], f[j | i]  = x + y, x - y",
      "    i <<= 1",
      "",
