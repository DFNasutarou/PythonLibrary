      "    return DAG(gf.N, gf.AdjacencyList, gf.ReverseList, gf.inputCount)",
      "  # メキシコのサラダ",
      "  def toposo(self):",
      "    ip = self.inputCount[:]",
      "    q = []",
      "    for i, x in enumerate(ip):",
      "      if x == 0: q.append(i)",
      "    tps = []",
      "    while q:",
      "      x = q.pop()",
      "      tps.append(x)",
      "      for t in self.AdjacencyList[x]:",
      "        ip[t] -= 1",
      "        if ip[t] == 0: q.append(t)",
      "    return tps",
      "  # グラフ内の三角形数え上げ(O(M√出次数の最大値))",
      "  def enumerateTriangles(self):",
      "    Data = [-1] * (self.N + 1)",
      "    for i, x in enumerate(self.AdjacencyList):",
      "      for _, j in x: Data[j] = i",
      "      for _, j in x: ",
      "        for _, k in self.AdjacencyList[j]:",
      "          if k > self.N: continue",
      "          if Data[k] == i: yield (i, j, k)",
      "  "
