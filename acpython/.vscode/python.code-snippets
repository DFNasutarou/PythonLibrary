  "nfa": {
    "scope": "python",
    "prefix": "nfa",
    "description": "オートマトンDP(NFA有り)",
    "body": [
      "from collections import defaultdict",
      "",
      "class I_DFA:",
      "  \"\"\"",
      "  決定性有限オートマトンの基底クラス。各メソッドをオーバーライドして使用する。",
      "  \"\"\"",
      "  def __init__(self):",
      "    pass",
      "  def init(self) -> int:",
      "    \"\"\"初期状態を返す\"\"\"",
      "    raise NotImplementedError",
      "  def next(self, state: int, alphabet: str, index: int) -> int:",
      "    \"\"\"状態遷移を返す\"\"\"",
      "    raise NotImplementedError",
      "  def accept(self, state: int) -> bool:",
      "    \"\"\"現在の状態が受理状態か確認する\"\"\"",
      "    raise NotImplementedError",
      "  def successful(self, state: int) -> bool:",
      "    \"\"\"探索を続けるべきか確認する\"\"\"",
      "    return True",
      "  def unsuccessful(self, state: int) -> bool:",
      "    \"\"\"探索を終了すべきか確認する\"\"\"",
      "    return False",
      "",
      "class DFA:",
      "  ALP_DIGIT   = \"0123456789\"",
      "  ALP_ABC     = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"",
      "  ALP_ABC_LOW = \"abcdefghijklmnopqrstuvwxyz\"",
      "  @staticmethod",
      "  def count(dfa: I_DFA, n, alphabet, mod = -1) -> int:",
      "    \"\"\"",
      "    数え上げの実行",
      "    dfa : 決定性有限オートマトン",
      "    n : ループ回数（桁DPの桁数）",
      "    alphabet : 文字集合 (数値なら\"0123456789\")",
      "    mod : MODを取る値 指定しなければMODを取らずに数え上げる",
      "    \"\"\"",
      "    dp = {}",
      "    dp[dfa.init()] = 1",
      "    for i in range(n):",
      "      dp2 = {}",
      "      for s, k in dp.items():",
      "        for a in alphabet:",
      "          s1 = dfa.next(s, a, i)",
      "          if dfa.unsuccessful(s1): continue",
      "          if s1 not in dp2: dp2[s1] = 0",
      "          dp2[s1] += k",
      "          if mod >= 1: dp2[s1] %= mod",
      "      dp = dp2",
      "    ans = 0",
      "    for s, k in dp.items():",
      "      if dfa.accept(s):",
      "        ans += k",
      "        if mod >= 1: ans %= mod",
      "    return ans",
      "  class And(I_DFA):",
      "    \"\"\"",
      "    複数条件を満たす状態の数え上げ",
      "    三つ以上の場合は入れ子にすることで対応",
      "    \"\"\"",
      "    def __init__(self, A : I_DFA, B : I_DFA):",
      "      self.A = A",
      "      self.B = B",
      "    def init(self): return (self.A.init(), self.B.init())",
      "    def next(self, state, alphabet, i):",
      "      return (self.A.next(state[0], alphabet, i), self.B.next(state[1], alphabet, i))",
      "    def accept(self, state) -> bool:",
      "      return self.A.accept(state[0]) and self.B.accept(state[1])",
      "    def successful(self, state) -> bool:",
      "      return self.A.successful(state[0]) and self.B.successful(state[1])",
      "    def unsuccessful(self, state) -> bool:",
      "      return self.A.unsuccessful(state[0]) or self.B.unsuccessful(state[1])",
      "  class Not(I_DFA):",
      "    \"\"\"",
      "    否定条件(テスト未実施)",
      "    \"\"\"",
      "    def __init__(self, dfa : I_DFA):",
      "      self._dfa: I_DFA = dfa",
      "    def init(self):",
      "      return self._dfa.init()",
      "    def next(self, state : int, alphabet : str, i : int):",
      "      return self._dfa.next(state, alphabet, i)",
      "    def accept(self, state) -> bool: return not self._dfa.accept(state)",
      "    def successful(self, state) -> bool: return self._dfa.unsuccessful(state)",
      "    def unsuccessful(self, state) -> bool: return self._dfa.successful(state)",
      "  class Leq(I_DFA):",
      "    \"\"\"",
      "    N以下の整数を数えあげるオートマトン",
      "    \"\"\"",
      "    def __init__(self, N: int | str):",
      "      self._n = str(N)",
      "    def init(self):",
      "      return 0",
      "    def next(self, state : int, alphabet : str, i : int):",
      "      if state != 0: return state",
      "      if alphabet > self._n[i]: return 1",
      "      elif alphabet < self._n[i]: return -1",
      "      else: return 0",
      "    def accept(self, state) -> bool: return state != 1",
      "    def successful(self, state) -> bool: return state == -1",
      "    def unsuccessful(self, state) -> bool: return state == 1",
      "",
      "  class DigitSumMultipleOF(I_DFA):",
      "    \"\"\"",
      "    Nの倍数を数えあげるオートマトン",
      "    \"\"\"",
      "    def __init__(self, N: int | str): self._n = int(N)",
      "    def init(self)  -> int: return 0",
      "    def next(self, state, alphabet, i): return (state + int(alphabet)) % self._n ",
      "    def accept(self, state) -> bool: return state == 0",
      " ",
      "class DFAFactory:",
      "  @staticmethod",
      "  def make_dfa(transitions: dict[tuple[int, str], int], dfa_start_state: int, accept_states: list[int]) -> I_DFA:",
      "    \"\"\"",
      "    DFAを生成するファクトリメソッド。",
      "    - transitions: NFAの遷移関数",
      "    - start_state: 開始状態",
      "    - accept_states: 受理状態集合",
      "    \"\"\"",
      "    class ConcreteDFA(I_DFA):",
      "      def __init__(self):",
      "        self.transitions = transitions",
      "        self.start_state = dfa_start_state",
      "        self.accept_states = set(accept_states)",
      "      def init(self) -> int: ",
      "        return self.start_state",
      "      def next(self, state: int, symbol: str, index: int) -> int: ",
      "        return self.transitions.get((state, symbol), -1)",
      "      def accept(self, state: int) -> bool: ",
      "        return state in self.accept_states",
      "      def unsuccessful(self, state: int) -> bool: ",
      "        return state == -1",
      "    return ConcreteDFA()",
      "",
      "  @staticmethod",
      "  def make_dfa_by_nfa(state_size: int, alphabet: str, transitions: dict[tuple[int, str], list[int]], start_state: list[int], accept_states: list[int], eps: dict[int, list[int]] = None) -> I_DFA:",
      "      \"\"\"",
      "      NFAをDFAに変換し、DFAを生成するファクトリメソッド。",
      "      - state_size: NFAの状態数",
      "      - alphabet: 文字集合（str）",
      "      - transitions: NFAの遷移関数",
      "      - start_state: 開始状態",
      "      - accept_states: 受理状態集合",
      "      - eps: 各状態のε遷移辞書 (指定なしも可)",
      "      \"\"\"",
      "      dfa_state_size, _, dfa_transitions, dfa_start_state, dfa_accept_states = DFAFactory._nfa_to_dfa(",
      "          state_size, alphabet, transitions, start_state, accept_states, eps or {}",
      "      )",
      "      return DFAFactory.make_dfa(dfa_transitions, dfa_start_state, dfa_accept_states)",
      "",
      "  @staticmethod",
      "  def _epsilon_closure(state, transitions, eps):",
      "    \"\"\"",
      "    NFAの1つの状態について、ε-閉包を計算する関数。",
      "    \"\"\"",
      "    stack = [state]  # 初期状態をスタックに追加",
      "    closure = set(stack)  # ε-閉包には少なくとも自身が含まれる",
      "",
      "    while stack:",
      "      current = stack.pop()  # スタックから状態を取り出す",
      "      # 現在の状態からのε遷移を確認",
      "      for next_state in eps.get(current, []):  # epsが存在する場合のみ参照",
      "        if next_state not in closure:  # 未訪問の状態のみ追加",
      "          closure.add(next_state)",
      "          stack.append(next_state)  # 新たに訪問するためスタックに追加",
      "",
      "    return closure",
      "",
      "  @staticmethod",
      "  def _epsilon_closure_set(states, transitions, eps):",
      "    \"\"\"",
      "    NFAの状態集合について、ε-閉包を計算する関数。",
      "    \"\"\"",
      "    closure = set()",
      "    # 各状態についてε-閉包を計算し、全てを統合",
      "    for state in states:",
      "      closure.update(DFAFactory._epsilon_closure(state, transitions, eps))",
      "    return closure",
      "",
      "  @staticmethod",
      "  def _move(states, symbol, transitions):",
      "    \"\"\"",
      "    特定の入力シンボルに基づいて、NFAの状態集合から到達可能な状態集合を計算する関数。",
      "    \"\"\"",
      "    result = set()",
      "    # 各状態からシンボルに対応する遷移先を確認",
      "    for state in states:",
      "      result.update(transitions.get((state, symbol), []))",
      "    return result",
      "",
      "  @staticmethod",
      "  def _nfa_to_dfa(state_size, alphabet, transitions, start_state, accept_states, eps):",
      "    \"\"\"",
      "    ε遷移を含むNFAを同等のDFAに変換する関数。",
      "    入力:",
      "      - state_size: NFAの状態数",
      "      - alphabet: 文字集合（str）",
      "      - transitions: NFAの遷移関数",
      "      - start_state: 開始状態",
      "      - accept_states: 受理状態集合",
      "      - eps: 各状態のε遷移辞書",
      "    戻り値:",
      "      - dfa_state_size: DFAの状態数",
      "      - alphabet: 文字集合（str）",
      "      - transitions: DFAの遷移関数",
      "      - start_state: DFAの開始状態",
      "      - accept_states: DFAの受理状態集合",
      "    \"\"\"",
      "    # ステップ1: ε遷移を除去してεなしのNFAを作成",
      "    new_transitions = defaultdict(list)",
      "",
      "    for state in range(state_size):",
      "      e_closure = DFAFactory._epsilon_closure(state, transitions, eps)  # 各状態のε-閉包を計算",
      "      for symbol in alphabet:",
      "        reachable = set()",
      "        for s in e_closure:",
      "          reachable.update(transitions.get((s, symbol), []))  # シンボルで到達可能な状態を収集",
      "        if reachable:",
      "          new_closure = DFAFactory._epsilon_closure_set(reachable, transitions, eps)  # ε-閉包を計算",
      "          new_transitions[(state, symbol)] = list(new_closure)  # 新たな遷移関数を設定",
      "",
      "    # ステップ2: Powerset Constructionを用いてNFAをDFAに変換",
      "    dfa_states = []  # DFAの状態集合",
      "    dfa_transitions = {}  # DFAの遷移関数",
      "    dfa_start_state = frozenset(DFAFactory._epsilon_closure_set(start_state, transitions, eps))  # 開始状態のε-閉包をDFAの開始状態に設定",
      "    dfa_accept_states = set()  # DFAの受理状態集合",
      "",
      "    unmarked_states = [dfa_start_state]  # 未処理の状態集合",
      "    state_map = {dfa_start_state: 0}  # DFAの状態を整数にマッピング",
      "",
      "    while unmarked_states:",
      "      current = unmarked_states.pop()  # 未処理状態を1つ取り出す",
      "      if current not in dfa_states:",
      "        dfa_states.append(current)  # 処理済みとして追加",
      "",
      "      # 現在の状態が受理状態かどうかをチェック",
      "      if any(s in accept_states for s in current):",
      "        dfa_accept_states.add(state_map[current])",
      "",
      "      # アルファベット内の各シンボルについて遷移を処理",
      "      for symbol in alphabet:",
      "        next_state = frozenset(DFAFactory._move(current, symbol, new_transitions))  # 次の状態を計算",
      "",
      "        if next_state and next_state not in state_map:  # 未訪問の状態なら追加",
      "          state_map[next_state] = len(state_map)",
      "          unmarked_states.append(next_state)  # 新しい状態を未処理リストに追加",
      "",
      "        if next_state:  # 遷移関数を更新",
      "          dfa_transitions[(state_map[current], symbol)] = state_map[next_state]",
      "",
      "    dfa_state_size = len(state_map)  # DFAの状態数",
      "",
      "    return dfa_state_size, alphabet, dfa_transitions, state_map[dfa_start_state], list(dfa_accept_states)",
      ""
    ]
