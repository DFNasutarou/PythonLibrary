  "cartesianTree": {
    "scope": "python",
    "prefix": "cartesianTree",
    "description": "cartesianTree",
    "body": [
      "from typing import Any, Callable",
      "",
      "class CartesianTree:",
      "  def __init__(self, N: int, A: list[int], L: list[int], R: list[int], P: list[int], root: int): ",
      "    self._N = N # 要素数",
      "    self._A = A # 各要素の値",
      "    self._L = L # 左のこょーそ",
      "    self._R = R # 右のこょーそ",
      "    self._P = P # 親",
      "    self._root = root # 根",
      "  def getParentList(self):",
      "    \"\"\"各要素に対する親のリストを取得\"\"\"",
      "    return self._P",
      "  def getParent(self, x: int):",
      "    \"\"\"",
      "    指定した要素に対する親を取得",
      "    親がいない場合、-1",
      "    \"\"\"",
      "    return self._P[x]",
      "  def getRoot(self) : ",
      "    \"\"\"根の要素番号を取得\"\"\"",
      "    return self._root",
      "  def makeSizeOfPartTree(self):",
      "    \"\"\"",
      "    部分木のサイズのリストを取得",
      "    末尾に0入り（番兵）",
      "    \"\"\"",
      "    dp = [0] * (self._N + 1)",
      "    def op(x: int, l: int, r: int, dp):",
      "      dp[x] = self._A[x] + dp[l] + dp[r]",
      "    self.bottomUpDp(op, dp)",
      "    return dp",
      "  def topDownDp(self, op : Callable[[int, int, int, Any], Any], dp: Any):",
      "    \"\"\"CartesianTreeの根からDPする op(見ているノード, 区間左端, 区間右端, 結果格納用データ)\"\"\"",
      "    q = [self._root, 0, self._N]",
      "    while q:",
      "      r, l, x = q.pop(), q.pop(), q.pop()",
      "      op(x, l, r, dp)",
      "      n = self._L[x]",
      "      if n != -1: q.extend([n, l, x])",
      "      n = self._R[x]",
      "      if n != -1: q.extend([n, x + 1, r])",
      "  def bottomUpDp(self, op : Callable[[int, int, int, Any], Any], dp: Any):",
      "    \"\"\"CartesianTreeの葉からDPする op(見ているノード, 左の子, 右の子, 結果格納用データ)\"\"\"",
      "    q = [self._root]",
      "    used = [0] * (self._N + 1)",
      "    used[-1] = 2",
      "    while q:",
      "      x = q.pop()",
      "      l = self._L[x]",
      "      r = self._R[x]",
      "      if used[l] == 0: ",
      "        q.append(l)",
      "        continue",
      "      if used[r] == 0: ",
      "        q.append(r)",
      "        continue",
      "      op(x, l, r, dp)",
      "      p = self._P[x]",
      "      if p != -1: q.append(p)",
      "      used[x] = 1",
      "  def print(self):",
      "    br = \"  \"",
      "    nd = \"--\"",
      "    ld = \" .\"",
      "    rd = \". \"",
      "    data = [[br] * self._N for _ in range(self._N)]",
      "    q = [self._root]",
      "    for i in range(self._N):",
      "      if q == []: break",
      "      p: list[int] = []",
      "      for x in q:",
      "        l = self._L[x]",
      "        r = self._R[x]",
      "        if l != -1: ",
      "          for j in range(l + 1, x): data[i][j] = nd",
      "          data[i][l] = ld ",
      "          p.append(l)",
      "        if r != -1:",
      "          for j in range(x + 1, r): data[i][j] = nd",
      "          data[i][r] = rd ",
      "          p.append(r)",
      "        data[i][x] = format(self._A[x], '02')",
      "      q = p",
      "    for d in data:",
      "      print(*d, sep = \"\")",
      "",
      "class CartesianTreeFactory:",
      "  @staticmethod",
      "  def makeMinTree(A: list[int]) -> CartesianTree: return CartesianTreeFactory._makeTree(A, CartesianTreeFactory._opmin)",
      "  @staticmethod",
      "  def makeMaxTree(A: list[int]) -> CartesianTree: return CartesianTreeFactory._makeTree(A, CartesianTreeFactory._opmax)",
      "  @staticmethod",
      "  def _opmin(a: int, b: int) -> bool: return a > b",
      "  @staticmethod",
      "  def _opmax(a: int, b: int) -> bool: return a < b",
      "  @staticmethod",
      "  def _makeTree(A: list[int], op: Callable[[int, int], bool]) -> CartesianTree:",
      "    N: int = len(A)",
      "    L: list[int] = [-1] * N",
      "    R: list[int] = [-1] * N",
      "    P: list[int] = [-1] * N",
      "    root = 0",
      "    for i in range(1, N):",
      "      if op(A[i - 1], A[i]):",
      "        p: int = i - 1",
      "        while P[p] != -1:",
      "          p = P[p]",
      "          if not op(A[p], A[i]):",
      "            l: int = R[p]",
      "            R[p], P[l] = i, i",
      "            P[i], L[i] = p, l",
      "            break",
      "        else:",
      "          P[p], L[i] = i, p",
      "          root: int = i",
      "      else:",
      "        R[i - 1], P[i] = i, i - 1",
      "    return CartesianTree(N, A, L, R, P, root)",
      "  "
    ]
  },
  "convolution": {
    "scope": "python",
    "prefix": "convolution",
    "description": "その他畳み込み（作業中）",
    "body": [
      "class Convolution:",
      "  @staticmethod",
      "  def andProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    and畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans = Convolution.adm(a, b, Hadamard.opAndFwt, Hadamard.opAndIfwt, op) ",
      "    return [a % MOD for a in ans]",
      "  @staticmethod",
      "  def orProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    or畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans = Convolution.adm(a, b, Hadamard.opOrFwt, Hadamard.opOrIfwt, op) ",
      "    return [a % MOD for a in ans]",
      "  @staticmethod",
      "  def xorProductConv(a: list[int], b: list[int], MOD):",
      "    \"\"\"",
      "    xor畳み込み a, bは2べきでサイズをそろえること",
      "    \"\"\"",
      "    n = len(a)",
      "    def op(a: list[int], b: list[int]): return [a[i] * b[i] % MOD for i in range(n)]",
      "    ans =  Convolution.adm(a, b, Hadamard.opXorFwt, Hadamard.opXorFwt, op)",
      "    I = [0, 1]",
      "    for i in range(2, n + 1):",
      "      I.append(MOD - I[MOD % i] * (MOD // i) % MOD)",
      "    for i in range(n):",
      "      ans[i] *= I[n]",
      "      ans[i] %= MOD",
      "    return ans",
      "  @staticmethod",
      "  def minPlusConv(a: list[int], b: list[int]):",
      "    \"\"\"",
      "    各kに対して、i+j=kとなるai+bjの最小値",
      "    制約: aが下に凸",
      "    \"\"\"",
      "    N = len(a) + len(b) - 1",
      "    M = len(b)",
      "    gen = Convolution.minplus",
      "    data = [a, b]",
      "    def op(old: int, new: int): return old > new",
      "    return Convolution.monge(N, M, gen, data, op)",
      "",
      "  @staticmethod",
      "  def adm(a, b, fwt, ifwt, op):",
      "    Hadamard.fwt(a, fwt)",
      "    Hadamard.fwt(b, fwt)",
      "    ans = op(a, b)",
      "    Hadamard.fwt(ans, ifwt)",
      "    return ans",
      " ",
      "  @staticmethod",
      "  def monge(N: int, M: int, generator, data, op):",
      "    ans = [0] * N",
      "    q = [0, N, 0, M]",
      "    while q:",
      "      r, l, y, x = q.pop(), q.pop(), q.pop(), q.pop()",
      "      res = None",
      "      t = 0",
      "      n = (x + y) // 2",
      "      for i, a in generator(n, l, r, data):",
      "        if res == None or op(res, a):",
      "           res= a",
      "           t = i",
      "      ans[n] = res if res != None else -1 # generatorが値を返せば-1になることはない",
      "      if (x + n) // 2 != n: q.extend([x, n, l, t + 1])",
      "      if (n + y) // 2 != n: q.extend([n + 1, y, t, r])",
      "    return ans",
      "",
      "  @staticmethod",
      "  def minplus(n: int, l: int, r: int, data: list[list[int]]):",
      "    a, b = data",
      "    N = len(a)",
      "    M = len(b)",
      "    for i in range(l, r):",
      "      if not 0 <= i < M: continue",
      "      j = n - i",
      "      if not 0 <= j < N: continue",
      "      yield i, a[j] + b[i]",
      "",
      "class Hadamard:",
      "  @staticmethod",
      "  def opAndFwt(f : list[int], i: int, j: int) : f[j] += f[j | i]",
      "  @staticmethod",
      "  def opAndIfwt(f : list[int], i: int, j: int): f[j] -= f[j | i]",
      "  @staticmethod",
      "  def opOrFwt(f : list[int], i: int, j: int) : f[j | i] += f[j]",
      "  @staticmethod",
      "  def opOrIfwt(f : list[int], i: int, j: int): f[j | i] -= f[j]",
      "  @staticmethod",
      "  def opXorFwt(f : list[int], i: int, j: int) : ",
      "    x, y = f[j], f[j | i]",
      "    f[j], f[j | i]  = x + y, x - y",
      "  @staticmethod",
      "  def fwt(f, op):",
      "    n = len(f)",
      "    i = 1",
      "    while i < n:",
      "      for j in range(n):",
      "        if j & i == 0: op(f, i, j)",
      "      i <<= 1"
    ]
  },
