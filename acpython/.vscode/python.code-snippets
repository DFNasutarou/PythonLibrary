      "",
      "  # 非負整数を検索",
      "  def find(s, key):",
      "    if s.root.isInValid(): return None",
      "    return s.root.find(key, BinaryTrie.BIT_SIZE)",
      "",
      "  # keyとxorしたときの最小値を検索 key: xor対象",
      "  def findXorMin(s, key):",
      "    if s.root.isInValid(): return None",
