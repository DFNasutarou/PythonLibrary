      "    ",
      "  # keyとxorしたときの最大値を検索 key: xor対象",
      "  def findXorMax(s, key):",
      "    if s.root.isInValid(): return None",
      "    return s.root.findXorMax(key, BinaryTrie.BIT_SIZE)",
      "",
      "  class Node:",
      "    def __init__(s):",
      "      s.data = [None, None]",
      "    def isInValid(s):",
      "      return s.data == [None, None]",
      "    def insert(s, n, d):",
      "      a = n >> d & 1",
      "      if s.data[a] == None:",
      "        s.data[a] = BinaryTrie.Node()",
      "      if d == 0: return",
      "      s.data[a].insert(n, d - 1)",
      "    def remove(s, n, d):",
      "      a = n >> d & 1",
