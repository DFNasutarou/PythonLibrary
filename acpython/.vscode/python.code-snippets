    "body": [
      "class BFS:",
      "  \"\"\"",
      "  01bfsしたいとき",
      "  \"\"\"",
      "  def __init__(self, N):",
      "    self.N = N",
      "    self.AdjacencyList = [[] for _ in range(N)]",
      "",
      "  def add_edge(self, frm, to):",
      "    self.AdjacencyList[frm].append(to)",
      "",
      "  def bfs(self, start):",
      "    \"\"\"",
      "    startから各地点の距離 通れない箇所は-1",
      "    \"\"\"",
      "    D = [-1] * self.N",
      "    data = [start]",
      "    cnt = 0",
      "    while data:",
      "      tl = []",
      "      for x in data:",
      "        if D[x] != -1: continue",
      "        D[x] = cnt",
      "        for y in self.AdjacencyList[x]:",
      "          if D[y] != -1: continue",
      "          tl.append(y)",
      "      cnt += 1",
      "      data = tl",
      "    return D",
      "  def bfs2Goal(self, start, goal):",
      "    \"\"\"",
      "    startからgoalまでの距離 通れない場合は-1",
      "    \"\"\"",
      "    D = [-1] * self.N",
      "    data = [start]",
      "    cnt = 0",
      "    while data:",
      "      tl = []",
      "      for x in data:",
      "        if D[x] != -1: continue",
      "        D[x] = cnt",
      "        for y in self.AdjacencyList[x]:",
      "          if D[y] != -1: continue",
      "          if y == goal: return cnt + 1",
      "          tl.append(y)",
      "      cnt += 1",
      "      data = tl",
      "    return -1"
    ]
  },
